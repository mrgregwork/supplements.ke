---
interface Props {
  editUrl?: string;
  pageType?: string;
}

const { editUrl, pageType = "page" } = Astro.props;

// Check if admin is logged in
const cookies = Astro.request.headers.get("cookie") || "";
const hasAdminSession = cookies.includes("adminSession=");
const isDev = import.meta.env.DEV;
const showToolbar = hasAdminSession || isDev;
---

{showToolbar && (
  <div class="fixed bottom-4 right-4 z-50 flex items-center gap-2 bg-card border shadow-lg rounded-lg p-2">
    <span class="text-xs text-muted-foreground px-2">Admin</span>
    {editUrl && (
      <a 
        href={editUrl}
        class="inline-flex items-center gap-1 px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded hover:opacity-90 transition"
        data-testid="link-edit-page"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Edit {pageType}
      </a>
    )}
    <a 
      href="/admin"
      class="inline-flex items-center gap-1 px-3 py-1.5 text-sm border rounded hover:bg-muted transition"
      data-testid="link-admin-dashboard"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Dashboard
    </a>
  </div>
)}
