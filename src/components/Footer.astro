---
import siteSettings from '@config/siteSettings.json';
import { getRegionalAnchorText } from '@lib/seo';

const footerLinks = {
  shop: [
    { label: 'Vitamins', href: '/vitamins/' },
    { label: 'Collagen', href: '/collagen/' },
    { label: 'Protein', href: '/protein/' },
    { label: 'Weight Management', href: '/weight-management/' },
    { label: 'Women\'s Health', href: '/womens-health/' },
  ],
  popular: [
    { label: 'Collagen Peptides in Kenya', href: '/collagen/collagen-peptides/' },
    { label: 'Vitamin C in Kenya', href: '/vitamins/vitamin-c/' },
    { label: 'Vitamin D in Kenya', href: '/vitamins/vitamin-d/' },
    { label: 'Multivitamins in Kenya', href: '/vitamins/multivitamins/' },
    { label: "Women's Vitamins in Kenya", href: '/vitamins/womens/' },
    { label: "Men's Vitamins in Kenya", href: '/vitamins/mens/' },
    { label: 'Vitamin B12 in Kenya', href: '/vitamins/vitamin-b12/' },
  ],
  company: [
    { label: 'About Us', href: '/about/' },
    { label: 'Contact', href: '/contact/' },
    { label: 'Privacy Policy', href: '/privacy/' },
    { label: 'Terms of Service', href: '/terms/' },
  ],
};
---

<footer class="border-t bg-muted/30 mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4" data-testid="link-footer-logo">
          <svg class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 22c1.25-1.25 2.5-2.5 3.5-4 1-1.5 1.5-3 1.5-5 0-3.5-2-6.5-5-8 0 0 2 3.5 2 7 0 2-.5 3.5-1.5 5C1.5 18.5 2 22 2 22z"/>
            <path d="M16 2c-3 1.5-5 4.5-5 8 0 2 .5 3.5 1.5 5 1 1.5 2.25 2.75 3.5 4 0 0 .5-3.5-1-5-1-1.5-1.5-3-1.5-5 0-3.5 2-6.5 5-8z"/>
            <path d="M9 10c0 5 3 10 6 12"/>
          </svg>
          <span class="font-semibold">{siteSettings.siteName}</span>
        </a>
        <p class="text-sm text-muted-foreground mb-4">
          {siteSettings.siteDescription}
        </p>
        {siteSettings.enableRegionalSeo && (
          <p class="text-xs text-muted-foreground">
            Serving customers in {siteSettings.targetRegion}
          </p>
        )}
      </div>

      <!-- Shop Links -->
      <div>
        <h3 class="font-semibold mb-4">Shop</h3>
        <ul class="space-y-2">
          {footerLinks.shop.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-muted-foreground hover:text-foreground transition-colors"
                data-testid={`link-footer-${link.label.toLowerCase().replace(/\s+/g, '-')}`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Links -->
      <div>
        <h3 class="font-semibold mb-4">Popular</h3>
        <ul class="space-y-2">
          {footerLinks.popular.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-muted-foreground hover:text-foreground transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="font-semibold mb-4">Company</h3>
        <ul class="space-y-2">
          {footerLinks.company.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-muted-foreground hover:text-foreground transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t mt-8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} {siteSettings.siteName}. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a href="#" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="Twitter">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href="#" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="Facebook">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 36.6 36.6 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>
          </svg>
        </a>
        <a href="#" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="Instagram">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
