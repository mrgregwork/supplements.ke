---
import siteSettings from '@config/siteSettings.json';
import { getRegionalAnchorText } from '@lib/seo';

const footerLinks = {
  shop: [
    { label: 'Vitamins', href: '/vitamins/' },
    { label: 'Collagen', href: '/collagen/' },
    { label: 'Protein', href: '/protein/' },
    { label: 'Weight Management', href: '/weight-management/' },
    { label: 'Women\'s Health', href: '/womens-health/' },
  ],
  popular: [
    { label: 'Collagen Peptides in Kenya', href: '/collagen/collagen-peptides/' },
    { label: 'Vitamin C in Kenya', href: '/vitamins/vitamin-c/' },
    { label: 'Vitamin D in Kenya', href: '/vitamins/vitamin-d/' },
    { label: 'Multivitamins in Kenya', href: '/vitamins/multivitamins/' },
    { label: "Women's Vitamins in Kenya", href: '/vitamins/womens/' },
    { label: "Men's Vitamins in Kenya", href: '/vitamins/mens/' },
    { label: 'Vitamin B12 in Kenya', href: '/vitamins/vitamin-b12/' },
  ],
  company: [
    { label: 'About Us', href: '/about/' },
    { label: 'Contact', href: '/contact/' },
    { label: 'Privacy Policy', href: '/privacy/' },
    { label: 'Terms of Service', href: '/terms/' },
  ],
};
---

<footer class="border-t bg-muted/30 mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4" data-testid="link-footer-logo">
          <svg class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 22c1.25-1.25 2.5-2.5 3.5-4 1-1.5 1.5-3 1.5-5 0-3.5-2-6.5-5-8 0 0 2 3.5 2 7 0 2-.5 3.5-1.5 5C1.5 18.5 2 22 2 22z"/>
            <path d="M16 2c-3 1.5-5 4.5-5 8 0 2 .5 3.5 1.5 5 1 1.5 2.25 2.75 3.5 4 0 0 .5-3.5-1-5-1-1.5-1.5-3-1.5-5 0-3.5 2-6.5 5-8z"/>
            <path d="M9 10c0 5 3 10 6 12"/>
          </svg>
          <span class="font-semibold">{siteSettings.siteName}</span>
        </a>
        <p class="text-sm text-muted-foreground mb-4">
          {siteSettings.siteDescription}
        </p>
        <!-- Contact details -->
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li>
            <a href="tel:+254724410910" class="hover:text-foreground transition-colors flex items-start gap-2">
              <svg class="h-4 w-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.1a16 16 0 0 0 6 6l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17.5l.19-.58z"/></svg>
              +254-724-410-910
            </a>
          </li>
          <li>
            <a href="mailto:sales@supplements.co.ke" class="hover:text-foreground transition-colors flex items-start gap-2">
              <svg class="h-4 w-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              sales@supplements.co.ke
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="h-4 w-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Nairobi, Kenya</span>
          </li>
          <li>
            <a href="https://wa.me/254724410910" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 px-3 py-1.5 mt-1 rounded-full text-xs font-semibold transition-colors"
               style="background-color:#25D366;color:#fff;">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Chat on WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <!-- Shop Links -->
      <div>
        <h3 class="font-semibold mb-4">Shop</h3>
        <ul class="space-y-2">
          {footerLinks.shop.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-muted-foreground hover:text-foreground transition-colors"
                data-testid={`link-footer-${link.label.toLowerCase().replace(/\s+/g, '-')}`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Links -->
      <div>
        <h3 class="font-semibold mb-4">Popular</h3>
        <ul class="space-y-2">
          {footerLinks.popular.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-muted-foreground hover:text-foreground transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="font-semibold mb-4">Company</h3>
        <ul class="space-y-2">
          {footerLinks.company.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-muted-foreground hover:text-foreground transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Payment methods -->
    <div class="border-t mt-8 pt-6 pb-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">We accept</p>
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center px-3 py-1.5 bg-card border rounded-md text-xs font-bold text-foreground/80">M-PESA</span>
        <span class="inline-flex items-center px-3 py-1.5 bg-card border rounded-md text-xs font-bold text-foreground/80">VISA</span>
        <span class="inline-flex items-center px-3 py-1.5 bg-card border rounded-md text-xs font-bold text-foreground/80">MASTERCARD</span>
        <span class="inline-flex items-center px-3 py-1.5 bg-card border rounded-md text-xs font-bold text-foreground/80">CASH ON DELIVERY</span>
        <span class="inline-flex items-center px-3 py-1.5 bg-card border rounded-md text-xs font-bold text-foreground/80">BANK TRANSFER</span>
      </div>
    </div>

    <div class="border-t pt-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <div class="space-y-1">
        <p class="text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()} {siteSettings.siteName}. All rights reserved.
        </p>
        <p class="text-xs text-muted-foreground">
          Authorised importer &amp; distributor of genuine health supplements in Kenya.
        </p>
      </div>
    </div>
  </div>
</footer>
