---
interface Props {
  editUrl: string;
  label?: string;
}

const { editUrl, label = "Edit" } = Astro.props;

// Check if admin is logged in
const cookies = Astro.request.headers.get("cookie") || "";
const hasAdminSession = cookies.includes("adminSession=");
const isDev = import.meta.env.DEV;
const showEdit = hasAdminSession || isDev;
---

{showEdit && (
  <a 
    href={editUrl}
    class="inline-flex items-center gap-1 px-3 py-1 text-xs bg-primary text-primary-foreground rounded hover:opacity-90 transition"
    data-testid="link-admin-edit"
  >
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
    </svg>
    {label}
  </a>
)}
