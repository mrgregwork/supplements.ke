---
import siteSettings from '@config/siteSettings.json';
import { getRegionalAnchorText } from '@lib/seo';
import { storage } from '@lib/storage';

const dbNavItems = await storage.getNavigationItems();
const activeItems = dbNavItems.filter(item => item.isActive);

// Build top-level items with their children attached
const topLevel = activeItems.filter(item => !item.parentId);
const childrenMap = new Map<string, typeof activeItems>();
for (const item of activeItems) {
  if (item.parentId) {
    if (!childrenMap.has(item.parentId)) childrenMap.set(item.parentId, []);
    childrenMap.get(item.parentId)!.push(item);
  }
}

// Pre-fetch subcategories for mega menu category cells
const allDbCategories = await storage.getCategories();
const megaSubsMap = new Map<string, { name: string; href: string }[]>();
await Promise.all(
  allDbCategories.filter(c => c.isActive).map(async cat => {
    const subs = await storage.getSubcategoriesByCategoryId(cat.id);
    megaSubsMap.set(`/${cat.slug}/`,
      subs.filter(s => s.isActive).slice(0, 4)
        .map(s => ({ name: s.name, href: `/${cat.slug}/${s.slug}/` }))
    );
  })
);

type NavChild = { href: string; label: string; description?: string | null; subs: { name: string; href: string }[] };
type NavItem  = { href: string; label: string; isMegaMenu?: boolean; isTwoColumn?: boolean; children?: NavChild[] };

// Pre-build vitamins and minerals link lists for the two-column dropdown
const vitMinItem = activeItems.find(i => i.description === 'two-column');
const vitMinChildren = vitMinItem
  ? (childrenMap.get(vitMinItem.id) ?? []).sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0))
  : [];
const vitaminsLinks = vitMinChildren.filter(c => c.description === 'Vitamins').map(c => ({ href: c.href, label: c.label }));
const mineralsLinks = vitMinChildren.filter(c => c.description === 'Minerals').map(c => ({ href: c.href, label: c.label }));

/**
 * Column grouping for the fallback mega menu, keyed by category slug.
 * Anything not listed lands in "More".
 */
const FALLBACK_GROUPS: { label: string; slugs: string[] }[] = [
  { label: 'Shop by Goal',   slugs: ['health-goals', 'weight-management', 'womens-health', 'mens-health', 'kids-family'] },
  { label: 'Core Nutrients', slugs: ['vitamins', 'minerals', 'protein', 'omega-fatty-acids'] },
  { label: 'Specialty',      slugs: ['specialty-supplements', 'collagen', 'probiotics-gut-health', 'herbal-supplements'] },
  { label: 'More',           slugs: ['beauty-supplements', 'food-supplements', 'supplement-forms', 'lifestyle-supplements'] },
];

/**
 * Built from the live categories rather than a hardcoded list.
 *
 * navigation_items is empty on this database, so the previous fallback marked
 * "All Supplements" as a mega menu while giving it no children — the panel
 * opened onto an empty box. Deriving it from the categories that actually exist
 * means the menu works with no navigation rows configured, and stays correct as
 * categories are added or renamed. Rows in navigation_items still take priority.
 */
function buildFallbackMegaChildren(): NavChild[] {
  const active = allDbCategories.filter(c => c.isActive);
  const grouped = new Set(FALLBACK_GROUPS.flatMap(g => g.slugs));

  return FALLBACK_GROUPS.flatMap(group => {
    const slugs = group.label === 'More'
      ? [...group.slugs, ...active.filter(c => !grouped.has(c.slug)).map(c => c.slug)]
      : group.slugs;

    return slugs
      .map(slug => active.find(c => c.slug === slug))
      .filter((c): c is NonNullable<typeof c> => Boolean(c))
      .map(c => ({
        href: `/${c.slug}/`,
        label: c.name,
        description: group.label,
        subs: megaSubsMap.get(`/${c.slug}/`) ?? [],
      }));
  });
}

const navItems: NavItem[] = topLevel.length > 0
  ? topLevel
      .sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0))
      .map(item => ({
        href: item.href,
        label: item.label,
        isMegaMenu:  item.description === 'mega-menu',
        isTwoColumn: item.description === 'two-column',
        children: (childrenMap.get(item.id) ?? [])
          .sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0))
          .map(c => ({ href: c.href, label: c.label, description: c.description, subs: megaSubsMap.get(c.href) ?? [] })),
      }))
  : [
      { href: '/all-supplements/', label: 'All Supplements', isMegaMenu: true, children: buildFallbackMegaChildren() },
      { href: '/vitamins/', label: 'Vitamins' },
      { href: '/protein/', label: 'Protein' },
      { href: '/collagen/', label: 'Collagen' },
      { href: '/weight-management/', label: 'Weight Management' },
    ];

// Group mega-menu children by their description field (used as section group)
function groupMegaChildren(children: NavChild[]) {
  const groups = new Map<string, NavChild[]>();
  for (const c of children) {
    const key = c.description || 'Other';
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)!.push(c);
  }
  return Array.from(groups.entries()).map(([label, items]) => ({ label, items }));
}

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Row 1: Logo + Right Actions -->
    <div class="flex h-14 items-center justify-between gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0" data-testid="link-logo">
        <img
          src="/images/logo.png"
          alt={siteSettings.siteName}
          width="417"
          height="96"
          class="h-8 w-auto dark:hidden"
        />
        <img
          src="/images/logo-dark.png"
          alt={siteSettings.siteName}
          width="417"
          height="96"
          class="h-8 w-auto hidden dark:block"
        />
      </a>

      <!-- Desktop full-width search bar -->
      <div class="hidden md:block flex-1 mx-6 relative" id="search-wrapper">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Search supplements, vitamins, brands…"
          autocomplete="off"
          class="w-full pl-10 pr-4 py-2 text-sm border-2 rounded-lg bg-background focus:outline-none focus:border-primary transition-colors"
          data-testid="input-search"
        />
        <!-- Autocomplete dropdown -->
        <div id="search-results" class="hidden absolute top-full left-0 right-0 mt-1 bg-popover border rounded-lg shadow-xl z-50 overflow-hidden"></div>
      </div>

      <!-- Right Actions -->
      <div class="flex items-center gap-2 shrink-0">
        <!-- Theme Toggle -->
        <button id="theme-toggle" class="p-2 rounded-md hover:bg-accent transition-colors" data-testid="button-theme-toggle" aria-label="Toggle theme">
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
          <svg class="h-5 w-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
        <a href="/account" class="p-2 rounded-md hover:bg-accent transition-colors" data-testid="link-account" aria-label="Account">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="8" r="4" />
            <path d="M20 21a8 8 0 1 0-16 0" />
          </svg>
        </a>
        <a href="/cart" class="p-2 rounded-md hover:bg-accent transition-colors" data-testid="button-cart" aria-label="Cart">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="8" cy="21" r="1" />
            <circle cx="19" cy="21" r="1" />
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
          </svg>
        </a>
        <!-- WhatsApp CTA -->
        <a href="https://wa.me/254724410910" target="_blank" rel="noopener noreferrer"
           class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[36px] rounded-full font-semibold text-sm transition-colors"
           style="background-color:#25D366;color:#fff;"
           aria-label="Order on WhatsApp"
           data-testid="button-whatsapp">
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span class="hidden md:inline">Order on WhatsApp</span>
        </a>
        <button id="mobile-menu-toggle" class="p-2 rounded-md hover:bg-accent transition-colors md:hidden" data-testid="button-mobile-menu" aria-label="Toggle menu">
          <svg id="menu-open-icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="4" x2="20" y1="12" y2="12" />
            <line x1="4" x2="20" y1="6" y2="6" />
            <line x1="4" x2="20" y1="18" y2="18" />
          </svg>
          <svg id="menu-close-icon" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Row 2: Desktop Navigation -->
    <div class="hidden md:block border-t">
      <nav class="flex items-center gap-1 py-1">
          {navItems.map((item) => (
            item.isMegaMenu ? (
              /* ── Mega Menu ── */
              <div class="relative group">
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md transition-colors",
                    currentPath.startsWith(item.href)
                      ? "bg-secondary text-secondary-foreground"
                      : "text-muted-foreground hover:text-foreground hover:bg-accent"
                  ]}
                  data-testid="link-nav-all-supplements"
                >
                  {item.label}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </a>
                <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50 w-[1080px] max-w-[calc(100vw-2rem)]">
                  <div class="rounded-xl shadow-2xl ring-1 ring-primary/10 bg-gradient-to-br from-emerald-50 via-white to-teal-50 dark:from-emerald-950/40 dark:via-slate-900 dark:to-teal-950/40 p-5 max-h-[calc(100vh-7rem)] overflow-y-auto">
                    <div class="grid grid-cols-4 gap-x-5 gap-y-2">
                      {groupMegaChildren(item.children ?? []).map(group => (
                        <div class="mb-2">
                          <p class="text-[11px] font-semibold uppercase tracking-wider text-primary/80 mb-2 pb-1 border-b border-primary/20">
                            {group.label}
                          </p>
                          {group.items.map(child => (
                            <div class="mb-2">
                              <a
                                href={child.href}
                                class="block py-0.5 text-sm font-semibold text-foreground hover:text-primary transition-colors"
                              >
                                {child.label}
                              </a>
                              {child.subs && child.subs.length > 0 && (
                                <ul class="ml-1 border-l border-primary/15 pl-2">
                                  {child.subs.map(s => (
                                    <li>
                                      <a
                                        href={s.href}
                                        class="block py-[2px] text-[12px] leading-tight text-muted-foreground hover:text-primary transition-colors"
                                      >
                                        {s.name}
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                    <div class="mt-3 pt-3 border-t border-primary/20 flex items-center justify-between">
                      <span class="text-xs text-muted-foreground">Browse all supplement categories</span>
                      <a href={item.href} class="text-xs text-primary font-semibold hover:underline">View all →</a>
                    </div>
                  </div>
                </div>
              </div>
            ) : item.isTwoColumn ? (
              /* ── Vitamins & Minerals Two-Column Dropdown ── */
              <div class="relative group">
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md transition-colors",
                    currentPath.startsWith(item.href)
                      ? "bg-secondary text-secondary-foreground"
                      : "text-muted-foreground hover:text-foreground hover:bg-accent"
                  ]}
                >
                  {item.label}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </a>
                <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50">
                  <div class="rounded-xl shadow-2xl ring-1 ring-primary/10 bg-gradient-to-br from-emerald-50 via-white to-teal-50 dark:from-emerald-950/40 dark:via-slate-900 dark:to-teal-950/40 p-5" style="min-width:460px">
                    <div style="display:flex; flex-direction:row; gap:2rem;">

                      <div style="flex:1; min-width:0;">
                        <p class="text-[11px] font-semibold uppercase tracking-wider text-primary/80 mb-2 pb-1 border-b border-primary/20">Vitamins</p>
                        {vitaminsLinks.map(link => (
                          <a href={link.href} class="block py-1 text-sm text-muted-foreground hover:text-primary transition-colors">{link.label}</a>
                        ))}
                      </div>

                      <div style="flex:1; min-width:0;">
                        <p class="text-[11px] font-semibold uppercase tracking-wider text-primary/80 mb-2 pb-1 border-b border-primary/20">Minerals</p>
                        {mineralsLinks.map(link => (
                          <a href={link.href} class="block py-1 text-sm text-muted-foreground hover:text-primary transition-colors">{link.label}</a>
                        ))}
                      </div>

                    </div>
                    <div class="mt-4 pt-3 border-t border-primary/20 flex gap-4">
                      <a href="/vitamins/" class="text-xs text-primary font-semibold hover:underline">All Vitamins →</a>
                      <a href="/minerals/" class="text-xs text-primary font-semibold hover:underline">All Minerals →</a>
                    </div>
                  </div>
                </div>
              </div>
            ) : item.children && item.children.length > 0 ? (
              /* ── Standard Dropdown ── */
              <div class="relative group">
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md transition-colors",
                    currentPath.startsWith(item.href)
                      ? "bg-secondary text-secondary-foreground"
                      : "text-muted-foreground hover:text-foreground hover:bg-accent"
                  ]}
                  data-testid={`link-nav-${item.label.toLowerCase().replace(/\s+/g,'-')}`}
                >
                  {item.label}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </a>
                <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50 min-w-[200px]">
                  <div class="bg-popover border rounded-lg shadow-lg py-1 overflow-hidden">
                    {item.children.map(child => (
                      <a
                        href={child.href}
                        class="block px-4 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              /* ── Plain Link ── */
              <a
                href={item.href}
                class:list={[
                  "px-3 py-2 text-sm font-medium rounded-md transition-colors",
                  currentPath === item.href
                    ? "bg-secondary text-secondary-foreground"
                    : "text-muted-foreground hover:text-foreground hover:bg-accent"
                ]}
                data-testid={`link-nav-${item.label.toLowerCase().replace(/\s+/g,'-')}`}
              >
                {item.label}
              </a>
            )
          ))}
        </nav>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden py-4 border-t">
      <!-- Mobile Search -->
      <div class="relative mb-4">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          id="search-input-mobile"
          type="search"
          placeholder="Search supplements, vitamins, brands…"
          autocomplete="off"
          class="w-full pl-10 pr-4 py-2 text-sm border-2 rounded-lg bg-background focus:outline-none focus:border-primary transition-colors"
          data-testid="input-search-mobile"
        />
        <div id="search-results-mobile" class="hidden absolute top-full left-0 right-0 mt-1 bg-popover border rounded-lg shadow-xl z-50 overflow-hidden"></div>
      </div>
      <nav class="flex flex-col gap-1">
        {navItems.map((item, idx) => (
          item.isMegaMenu ? (
            /* ── Mobile Mega Menu: grouped sections ── */
            <div class="mobile-nav-group">
              <div class="flex items-center">
                <a
                  href={item.href}
                  class="flex-1 px-3 py-2 text-sm font-semibold rounded-l-md min-h-[44px] flex items-center text-foreground hover:bg-accent transition-colors"
                >
                  {item.label}
                </a>
                <button
                  class="mobile-nav-toggle px-3 py-2 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-r-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
                  aria-expanded="false"
                  aria-label="Expand All Supplements"
                  data-target={`mobile-sub-${idx}`}
                >
                  <svg class="w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
              </div>
              <div id={`mobile-sub-${idx}`} class="hidden border-l ml-3 pl-3 pb-2 mt-0.5">
                {groupMegaChildren(item.children ?? []).map(group => (
                  <div class="mb-3">
                    <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground px-2 py-1">{group.label}</p>
                    {group.items.map(child => (
                      <div class="mb-1">
                        <a
                          href={child.href}
                          class="block px-2 py-1.5 text-sm font-medium text-foreground hover:bg-accent rounded-md transition-colors min-h-[36px] flex items-center"
                        >
                          {child.label}
                        </a>
                        {child.subs && child.subs.length > 0 && (
                          <ul class="ml-3 pl-2 border-l border-border/40">
                            {child.subs.map(s => (
                              <li>
                                <a
                                  href={s.href}
                                  class="block px-2 py-1 text-xs text-muted-foreground hover:text-foreground hover:bg-accent rounded transition-colors min-h-[32px] flex items-center"
                                >
                                  {s.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ) : (item.isTwoColumn || (item.children && item.children.length > 0)) ? (
            /* ── Mobile Two-Column or Standard Dropdown ── */
            <div class="mobile-nav-group">
              <div class="flex items-center">
                <a
                  href={item.href}
                  class:list={[
                    "flex-1 px-3 py-2 text-sm font-medium rounded-l-md transition-colors min-h-[44px] flex items-center",
                    currentPath.startsWith(item.href)
                      ? "bg-secondary text-secondary-foreground"
                      : "text-muted-foreground hover:text-foreground hover:bg-accent"
                  ]}
                  data-testid={`link-nav-mobile-${item.label.toLowerCase().replace(/\s+/g,'-')}`}
                >
                  {item.label}
                </a>
                <button
                  class:list={[
                    "mobile-nav-toggle px-3 py-2 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-r-md transition-colors",
                    currentPath.startsWith(item.href)
                      ? "bg-secondary text-secondary-foreground"
                      : "text-muted-foreground hover:text-foreground hover:bg-accent"
                  ]}
                  aria-expanded="false"
                  aria-label={`Expand ${item.label}`}
                  data-target={`mobile-sub-${idx}`}
                >
                  <svg class="w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
              </div>
              <div id={`mobile-sub-${idx}`} class="hidden ml-3 mt-0.5 border-l pl-3 pb-1">
                {item.isTwoColumn ? (
                  /* Two-column mobile layout */
                  <>
                    <div class="mb-3">
                      <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground px-2 py-1">Vitamins</p>
                      {vitaminsLinks.map(link => (
                        <a href={link.href} class="block px-2 py-1.5 text-sm text-muted-foreground hover:text-foreground hover:bg-accent rounded-md transition-colors min-h-[36px] flex items-center">{link.label}</a>
                      ))}
                    </div>
                    <div class="mb-3">
                      <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground px-2 py-1">Minerals</p>
                      {mineralsLinks.map(link => (
                        <a href={link.href} class="block px-2 py-1.5 text-sm text-muted-foreground hover:text-foreground hover:bg-accent rounded-md transition-colors min-h-[36px] flex items-center">{link.label}</a>
                      ))}
                    </div>
                  </>
                ) : (
                  /* Standard flat list */
                  <div class="flex flex-col gap-0.5">
                    {(item.children ?? []).map(child => (
                      <a
                        href={child.href}
                        class="px-2 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-accent rounded-md transition-colors min-h-[40px] flex items-center"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ) : (
            /* ── Plain link ── */
            <a
              href={item.href}
              class:list={[
                "px-3 py-2 text-sm font-medium rounded-md transition-colors min-h-[44px] flex items-center",
                currentPath === item.href
                  ? "bg-secondary text-secondary-foreground"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent"
              ]}
              data-testid={`link-nav-mobile-${item.label.toLowerCase().replace(/\s+/g,'-')}`}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  // ── Theme Toggle ──────────────────────────────────────────────
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('ecommerce-seo-theme', isDark ? 'dark' : 'light');
  });

  // ── Mobile Menu Toggle ────────────────────────────────────────
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.getElementById('menu-open-icon');
  const menuCloseIcon = document.getElementById('menu-close-icon');
  mobileMenuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    menuOpenIcon?.classList.toggle('hidden', !isOpen);
    menuCloseIcon?.classList.toggle('hidden', isOpen);
  });

  // ── Mobile Subcategory Toggles ────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.mobile-nav-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target!;
      const panel = document.getElementById(targetId);
      if (!panel) return;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      panel.classList.toggle('hidden', expanded);
      btn.setAttribute('aria-expanded', String(!expanded));
      const chevron = btn.querySelector('svg');
      if (chevron) chevron.style.transform = expanded ? '' : 'rotate(180deg)';
    });
  });

  // ── Search Autocomplete ───────────────────────────────────────
  function initSearch(inputId: string, resultsId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    const results = document.getElementById(resultsId);
    if (!input || !results) return;

    let debounce: ReturnType<typeof setTimeout>;
    let activeIdx = -1;

    function formatPrice(p: number | string | null) {
      if (!p) return '';
      return `KSh ${Number(p).toLocaleString()}`;
    }

    function renderResults(items: any[]) {
      activeIdx = -1;
      if (!items.length) {
        results!.innerHTML = `<div class="px-4 py-3 text-sm text-muted-foreground">No results found</div>`;
      } else {
        results!.innerHTML = items.map((item, i) => `
          <a href="/${item.categorySlug}/${item.subcategorySlug}/${item.slug}/"
             class="search-result-item flex items-center justify-between px-4 py-2.5 hover:bg-accent transition-colors cursor-pointer border-b last:border-0"
             data-idx="${i}">
            <div>
              <div class="text-sm font-medium text-foreground leading-tight">${item.name}</div>
              <div class="text-xs text-muted-foreground mt-0.5">${item.brand ?? ''}</div>
            </div>
            <div class="text-sm font-semibold text-primary ml-4 shrink-0">${formatPrice(item.price)}</div>
          </a>`).join('');
      }
      results!.classList.remove('hidden');
    }

    function highlightItem(idx: number) {
      const items = results!.querySelectorAll<HTMLElement>('.search-result-item');
      items.forEach((el, i) => {
        el.classList.toggle('bg-accent', i === idx);
      });
    }

    function hide() {
      results!.classList.add('hidden');
      activeIdx = -1;
    }

    input.addEventListener('input', () => {
      clearTimeout(debounce);
      const q = input.value.trim();
      if (q.length < 2) { hide(); return; }
      debounce = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
          const data = await res.json();
          renderResults(data);
        } catch { hide(); }
      }, 200);
    });

    input.addEventListener('keydown', (e) => {
      const items = results!.querySelectorAll<HTMLElement>('.search-result-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIdx = Math.min(activeIdx + 1, items.length - 1);
        highlightItem(activeIdx);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIdx = Math.max(activeIdx - 1, 0);
        highlightItem(activeIdx);
      } else if (e.key === 'Enter') {
        if (activeIdx >= 0 && items[activeIdx]) {
          (items[activeIdx] as HTMLAnchorElement).click();
        } else if (input.value.trim()) {
          window.location.href = `/search?q=${encodeURIComponent(input.value.trim())}`;
        }
      } else if (e.key === 'Escape') {
        hide();
        input.blur();
      }
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !results!.contains(e.target as Node)) hide();
    });
  }

  initSearch('search-input', 'search-results');
  initSearch('search-input-mobile', 'search-results-mobile');
</script>
