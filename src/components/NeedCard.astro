---
/**
 * A "browse by need" card for hub pages that hold too many products to list
 * (currently /specialty-supplements/, 89 products across 15 needs).
 *
 * Image precedence is deliberate: heroImage is whatever an admin has set, so a
 * manually uploaded photo always wins over anything generated. When no image
 * exists the card degrades to a lettered tile rather than a broken <img> or a
 * stand-in supplement photo — showing a bottle here would defeat the point of
 * illustrating the need instead of the product.
 *
 * Alt text prefers an explicit heroImageAlt, else falls back to the target
 * page's own H1, which is the phrase this card is trying to rank for.
 */
import { collectionHeading } from '@lib/headings';

interface Props {
  name: string;
  slug: string;
  href: string;
  excerpt?: string | null;
  image?: string | null;
  imageAlt?: string | null;
  productCount?: number;
  region?: string;
}

const {
  name, slug, href,
  excerpt = null,
  image = null,
  imageAlt = null,
  productCount = 0,
  region = 'Kenya',
} = Astro.props;

const heading = collectionHeading(name, region, slug);
const alt = imageAlt?.trim() || heading;
const initial = name.trim().charAt(0).toUpperCase();
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-xl border border-card-border bg-card transition-all duration-300 hover:border-primary/40 hover:shadow-lg"
  data-testid={`card-need-${slug}`}
>
  <div class="aspect-[16/10] overflow-hidden bg-muted relative">
    {image ? (
      <img
        src={image}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        data-testid={`img-need-${slug}`}
      />
    ) : (
      /* No image yet — a lettered tile, not a placeholder product shot. */
      <div
        class="h-full w-full flex items-center justify-center bg-gradient-to-br from-emerald-50 via-white to-sky-50 dark:from-emerald-950/40 dark:via-card dark:to-sky-950/30"
        role="img"
        aria-label={alt}
        data-testid={`img-need-${slug}-fallback`}
      >
        <span class="text-4xl font-extrabold text-primary/25 select-none">{initial}</span>
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-semibold leading-snug group-hover:text-primary transition-colors">
      {name}
    </h3>

    {excerpt && (
      <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
        {excerpt}
      </p>
    )}

    <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary">
      {productCount > 0 ? `Shop ${productCount} options` : 'Shop this range'}
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </span>
  </div>
</a>
