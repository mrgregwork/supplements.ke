---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { getAdminSessionToken, verifyAdminSession } from "@lib/admin";
import { storage } from "@lib/storage";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const adminEmail = sessionData?.admin?.email || "Dev Mode";

const url = new URL(Astro.request.url);
const id = url.searchParams.get("id");

let existingData = null;
if (id) {
  existingData = await storage.getBlogPost(id);
}

const isEditing = !!existingData;
const pageTitle = isEditing ? `Edit Post: ${existingData?.title}` : "New Blog Post";

function formatDateValue(d: Date | null | undefined) {
  if (!d) return "";
  const dt = new Date(d);
  return dt.toISOString().slice(0, 16);
}
---

<BaseLayout title={pageTitle + " - Admin"} description="Edit blog post">
  <div class="min-h-screen flex flex-col md:flex-row">
    <AdminSidebar adminEmail={adminEmail} currentPage="blog" />

    <main class="flex-1 flex flex-col min-h-screen">
      <!-- Top Bar -->
      <header class="sticky top-0 z-20 bg-background border-b px-4 md:px-6 py-3 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a
            href="/admin/blog"
            class="p-2 min-h-[48px] min-w-[48px] hover:bg-muted rounded-lg transition flex items-center justify-center"
            data-testid="link-back"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
          <h1 class="text-lg md:text-xl font-semibold truncate">{pageTitle}</h1>
        </div>
        <div class="flex items-center gap-2">
          <span id="save-status" class="text-sm text-muted-foreground hidden">Saved</span>
          {isEditing && existingData?.slug && (
            <a
              id="preview-btn"
              href={`/blog/${existingData.slug}/`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 min-h-[48px] border rounded-lg font-medium hover:bg-muted transition flex items-center gap-2 text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              Preview
            </a>
          )}
          <button
            type="button"
            id="save-btn"
            class="px-4 py-2 min-h-[48px] bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition flex items-center gap-2"
            data-testid="button-save"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="hidden sm:inline">Save</span>
          </button>
        </div>
      </header>

      <!-- Main Content Area -->
      <div class="flex-1 overflow-y-auto">
        <div class="max-w-4xl mx-auto p-4 md:p-6 lg:p-8">
          <form id="edit-form" class="space-y-6">
            <input type="hidden" id="form-id" value={id || ""} />

            <!-- Title and Slug -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium mb-2" for="form-title">Title *</label>
                <input
                  type="text"
                  id="form-title"
                  required
                  value={existingData?.title || ""}
                  class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                  placeholder="Enter post title"
                  data-testid="input-title"
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" for="form-slug">Slug *</label>
                <input
                  type="text"
                  id="form-slug"
                  required
                  value={existingData?.slug || ""}
                  class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                  placeholder="post-slug"
                  data-testid="input-slug"
                />
              </div>
            </div>

            <!-- Excerpt -->
            <div>
              <label class="block text-sm font-medium mb-2" for="form-excerpt">Excerpt</label>
              <textarea
                id="form-excerpt"
                rows="3"
                class="w-full px-4 py-3 text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none resize-none"
                placeholder="A short summary of this post, shown in listings"
                data-testid="input-excerpt"
              >{existingData?.excerpt || ""}</textarea>
              <p class="text-xs text-muted-foreground mt-1">Shown on the blog index page below the title</p>
            </div>

            <!-- Content Editor -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="block text-sm font-medium">Content</label>
                <div class="flex items-center gap-1 bg-muted rounded-lg p-1">
                  <button type="button" id="mode-visual" class="px-3 py-1.5 min-h-[36px] text-sm rounded-md bg-background shadow-sm font-medium" data-testid="button-mode-visual">Visual</button>
                  <button type="button" id="mode-code" class="px-3 py-1.5 min-h-[36px] text-sm rounded-md text-muted-foreground hover:text-foreground transition" data-testid="button-mode-code">HTML</button>
                </div>
              </div>

              <!-- Toolbar -->
              <div id="editor-toolbar" class="border border-b-0 rounded-t-lg bg-muted/30 p-2 flex flex-wrap gap-1">
                <button type="button" data-cmd="bold" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded font-bold text-sm" title="Bold (Ctrl+B)">B</button>
                <button type="button" data-cmd="italic" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded italic text-sm" title="Italic (Ctrl+I)">I</button>
                <button type="button" data-cmd="underline" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded underline text-sm" title="Underline (Ctrl+U)">U</button>
                <button type="button" data-cmd="strikeThrough" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded line-through text-sm" title="Strikethrough">S</button>
                <div class="w-px bg-border mx-1 h-6 self-center"></div>
                <select data-cmd="formatBlock" class="toolbar-select px-2 py-1 min-h-[36px] text-sm bg-background border rounded">
                  <option value="p">Paragraph</option>
                  <option value="h1">Heading 1</option>
                  <option value="h2">Heading 2</option>
                  <option value="h3">Heading 3</option>
                  <option value="h4">Heading 4</option>
                  <option value="blockquote">Quote</option>
                </select>
                <div class="w-px bg-border mx-1 h-6 self-center"></div>

                <!-- Highlight / text colour -->
                <button type="button" id="highlight-btn" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Highlight text (yellow)">
                  <span class="px-1 rounded" style="background-color:#fef08a;color:#111">H</span>
                </button>
                <input type="color" id="highlight-color" value="#fef08a" class="w-9 h-9 min-h-[36px] p-0.5 bg-background border rounded cursor-pointer" title="Pick highlight colour" />
                <input type="color" id="text-color" value="#111827" class="w-9 h-9 min-h-[36px] p-0.5 bg-background border rounded cursor-pointer" title="Pick text colour" />
                <div class="w-px bg-border mx-1 h-6 self-center"></div>

                <!-- Alignment -->
                <button type="button" data-cmd="justifyLeft" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded" title="Align left">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h10M4 18h13"/></svg>
                </button>
                <button type="button" data-cmd="justifyCenter" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded" title="Align centre">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 6h16M7 12h10M6 18h12"/></svg>
                </button>
                <button type="button" data-cmd="justifyRight" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded" title="Align right">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 6h16M10 12h10M7 18h13"/></svg>
                </button>
                <button type="button" data-cmd="justifyFull" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded" title="Justify">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div class="w-px bg-border mx-1 h-6 self-center"></div>

                <button type="button" data-cmd="undo" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded" title="Undo (Ctrl+Z)">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M3 10h10a4 4 0 010 8h-3M3 10l4-4M3 10l4 4"/></svg>
                </button>
                <button type="button" data-cmd="redo" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded" title="Redo (Ctrl+Y)">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M21 10H11a4 4 0 000 8h3M21 10l-4-4M21 10l-4 4"/></svg>
                </button>
                <div class="w-px bg-border mx-1 h-6 self-center"></div>
                <button type="button" data-cmd="insertUnorderedList" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Bullet List">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <button type="button" data-cmd="insertOrderedList" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Numbered List">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h10M7 16h10M3 8h.01M3 12h.01M3 16h.01"></path></svg>
                </button>
                <div class="w-px bg-border mx-1 h-6 self-center"></div>
                <button type="button" id="link-btn" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Insert Link">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                </button>
                <button type="button" id="image-btn" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Insert Image">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </button>
                <div class="w-px bg-border mx-1 h-6 self-center"></div>
                <button type="button" data-cmd="removeFormat" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm text-muted-foreground" title="Clear Formatting">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
              </div>

              <div
                id="visual-editor"
                contenteditable="true"
                class="min-h-[400px] border rounded-b-lg p-4 bg-background focus:outline-none focus:ring-2 focus:ring-primary prose prose-sm max-w-none dark:prose-invert"
                data-testid="editor-visual"
              ></div>

              <textarea
                id="code-editor"
                class="hidden w-full min-h-[400px] border rounded-lg p-4 bg-background font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                placeholder="Enter HTML here..."
                data-testid="editor-code"
              ></textarea>
            </div>

            <!-- Featured Image and Status -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium mb-2">Featured Image</label>
                <input type="hidden" id="form-featured-image" value={existingData?.featuredImage || ""} data-testid="input-featured-image" />

                <div id="fi-upload-zone" class={`border-2 border-dashed rounded-lg p-5 text-center cursor-pointer hover:border-primary transition-colors ${existingData?.featuredImage ? 'hidden' : ''}`}>
                  <input type="file" id="fi-file-input" accept="image/*" class="hidden" />
                  <label for="fi-file-input" class="cursor-pointer flex flex-col items-center gap-2">
                    <svg class="w-8 h-8 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span class="text-sm font-medium text-primary">Click to upload</span>
                    <span class="text-xs text-muted-foreground">PNG, JPG, WebP — max 5 MB</span>
                  </label>
                  <div class="mt-3 flex items-center gap-2">
                    <div class="flex-1 h-px bg-border"></div>
                    <span class="text-xs text-muted-foreground">or paste URL</span>
                    <div class="flex-1 h-px bg-border"></div>
                  </div>
                  <input type="url" id="fi-url-input" placeholder="https://example.com/image.jpg"
                    class="mt-2 w-full px-3 py-2 text-sm border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none" />
                </div>

                <div id="fi-preview-zone" class={`relative rounded-lg overflow-hidden border ${existingData?.featuredImage ? '' : 'hidden'}`}>
                  <img id="fi-preview-img" src={existingData?.featuredImage || ''} alt="Featured image preview"
                    class="w-full h-40 object-cover" />
                  <div id="fi-upload-progress" class="hidden absolute inset-0 bg-black/50 flex items-center justify-center">
                    <div class="text-white text-sm font-medium flex items-center gap-2">
                      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                      Uploading…
                    </div>
                  </div>
                  <button type="button" id="fi-remove-btn"
                    class="absolute top-2 right-2 bg-black/60 hover:bg-red-600 text-white rounded-full p-1.5 transition-colors"
                    title="Remove image">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  </button>
                  <label for="fi-replace-input" class="absolute bottom-2 right-2 bg-black/60 hover:bg-primary text-white text-xs font-medium px-2 py-1 rounded cursor-pointer transition-colors">
                    Replace
                    <input type="file" id="fi-replace-input" accept="image/*" class="hidden" />
                  </label>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" for="form-status">Status</label>
                <select
                  id="form-status"
                  class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                  data-testid="select-status"
                >
                  <option value="draft" selected={existingData?.status !== "published"}>Draft</option>
                  <option value="published" selected={existingData?.status === "published"}>Published</option>
                </select>
              </div>
            </div>

            <!-- Published At -->
            <div>
              <label class="block text-sm font-medium mb-2" for="form-published-at">Published Date</label>
              <input
                type="datetime-local"
                id="form-published-at"
                value={formatDateValue(existingData?.publishedAt)}
                class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                data-testid="input-published-at"
              />
              <p class="text-xs text-muted-foreground mt-1">Leave blank to use current date/time when publishing</p>
            </div>

            <!-- SEO Section -->
            <div class="border rounded-lg overflow-hidden">
              <button
                type="button"
                id="seo-toggle"
                class="w-full flex items-center justify-between p-4 bg-primary/5 hover:bg-primary/10 transition text-left"
                data-testid="button-seo-toggle"
              >
                <div>
                  <h3 class="font-semibold text-sm flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
                    SEO — Page Title &amp; Meta Description
                  </h3>
                  <p class="text-xs text-muted-foreground mt-0.5">Controls how this post appears in Google search results</p>
                </div>
                <svg id="seo-chevron" class="w-5 h-5 text-muted-foreground transition-transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="seo-fields" class="p-4 space-y-4 border-t">
                <div>
                  <label class="block text-sm font-medium mb-2" for="form-seo-title">Page title</label>
                  <input
                    type="text"
                    id="form-seo-title"
                    value={existingData?.seoTitle || ""}
                    class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                    placeholder={existingData?.title || "Post title"}
                    data-testid="input-seo-title"
                  />
                  <p class="text-xs text-muted-foreground mt-1">Recommended: 70 characters or less</p>
                </div>
                <div>
                  <label class="block text-sm font-medium mb-2" for="form-seo-description">Meta description</label>
                  <textarea
                    id="form-seo-description"
                    rows="3"
                    class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none resize-none"
                    placeholder="Enter a meta description for search engines"
                    data-testid="input-seo-description"
                  >{existingData?.seoDescription || ""}</textarea>
                  <p class="text-xs text-muted-foreground mt-1">Recommended: 160 characters or less</p>
                </div>
                <div class="bg-muted/30 rounded-lg p-4">
                  <p id="seo-preview-title" class="text-sm font-medium text-green-700 dark:text-green-400 truncate">
                    {existingData?.seoTitle || existingData?.title || "Post title"}
                  </p>
                  <p id="seo-preview-url" class="text-xs text-green-600 dark:text-green-500 truncate mt-0.5">
                    /blog/{existingData?.slug || "post-slug"}/
                  </p>
                  <p id="seo-preview-desc" class="text-xs text-muted-foreground mt-1 line-clamp-2">
                    {existingData?.seoDescription || "Meta description will appear here..."}
                  </p>
                </div>
              </div>
            </div>

            <div id="message-container" class="hidden"></div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <!-- Link Modal (WordPress-style with search) -->
  <div id="link-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-background rounded-lg shadow-xl w-full max-w-lg p-6">
      <h3 class="text-lg font-semibold mb-4">Insert Link</h3>
      <div class="space-y-4">
        <!-- Search -->
        <div>
          <label class="block text-sm font-medium mb-2">Search for a page or product</label>
          <input
            type="text"
            id="link-search-input"
            placeholder="Type to search pages, products, categories..."
            class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
          />
          <div id="link-search-results" class="hidden mt-1 border rounded-lg bg-background shadow-lg max-h-52 overflow-y-auto divide-y"></div>
        </div>
        <!-- URL field -->
        <div>
          <label class="block text-sm font-medium mb-2">URL</label>
          <input
            type="url"
            id="link-url"
            placeholder="https://example.com or /page-slug/"
            class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
            data-testid="input-link-url"
          />
        </div>
        <!-- Link text -->
        <div>
          <label class="block text-sm font-medium mb-2">Link text (optional)</label>
          <input
            type="text"
            id="link-text"
            placeholder="Link text"
            class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
            data-testid="input-link-text"
          />
        </div>
        <!-- Options row -->
        <div class="flex flex-col sm:flex-row gap-3">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="link-new-tab" class="w-4 h-4 rounded border" />
            <span class="text-sm">Open in new tab</span>
          </label>
          <div class="flex items-center gap-2">
            <label class="text-sm font-medium" for="link-rel">Rel:</label>
            <select id="link-rel" class="px-3 py-1.5 text-sm border rounded-lg bg-background">
              <option value="">Follow</option>
              <option value="nofollow">No Follow</option>
              <option value="sponsored">Sponsored</option>
              <option value="ugc">UGC</option>
            </select>
          </div>
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" id="link-cancel" class="px-4 py-2 min-h-[48px] border rounded-lg hover:bg-muted transition" data-testid="button-link-cancel">Cancel</button>
          <button type="button" id="link-insert" class="px-4 py-2 min-h-[48px] bg-primary text-primary-foreground rounded-lg hover:opacity-90 transition" data-testid="button-link-insert">Insert</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Image Modal -->
  <div id="image-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-background rounded-lg shadow-xl w-full max-w-md p-6">
      <h3 class="text-lg font-semibold mb-4">Insert Image</h3>
      <div class="space-y-4">
        <div class="border-2 border-dashed rounded-lg p-6 text-center">
          <input type="file" id="image-file" accept="image/*" class="hidden" />
          <label for="image-file" class="cursor-pointer">
            <svg class="w-12 h-12 mx-auto text-muted-foreground mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
            <p class="text-sm text-muted-foreground">Click to upload or drag and drop</p>
            <p class="text-xs text-muted-foreground mt-1">PNG, JPG, GIF up to 10MB</p>
          </label>
        </div>
        <div id="image-preview" class="hidden">
          <img id="preview-img" class="max-h-40 mx-auto rounded-lg" alt="Preview" />
          <p id="upload-status" class="text-sm text-center mt-2 text-muted-foreground">Uploading...</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Or enter image URL</label>
          <input type="url" id="image-url" placeholder="https://example.com/image.jpg" class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background" data-testid="input-image-url" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Alt text (for accessibility)</label>
          <input type="text" id="image-alt" placeholder="Describe the image" class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background" data-testid="input-image-alt" />
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" id="image-cancel" class="px-4 py-2 min-h-[48px] border rounded-lg hover:bg-muted transition">Cancel</button>
          <button type="button" id="image-insert" class="px-4 py-2 min-h-[48px] bg-primary text-primary-foreground rounded-lg hover:opacity-90 transition">Insert</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Unsaved Changes Modal -->
  <div id="unsaved-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-background rounded-lg shadow-xl w-full max-w-sm p-6">
      <h3 class="text-lg font-semibold mb-2">Unsaved Changes</h3>
      <p class="text-muted-foreground mb-4">You have unsaved changes. Are you sure you want to leave?</p>
      <div class="flex justify-end gap-2">
        <button type="button" id="unsaved-stay" class="px-4 py-2 min-h-[48px] border rounded-lg hover:bg-muted transition">Stay</button>
        <button type="button" id="unsaved-leave" class="px-4 py-2 min-h-[48px] bg-red-500 text-white rounded-lg hover:opacity-90 transition">Leave</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ existingContent: existingData?.content || '' }}>
  // DOM
  const formId = document.getElementById('form-id');
  const formTitle = document.getElementById('form-title');
  const formSlug = document.getElementById('form-slug');
  const formExcerpt = document.getElementById('form-excerpt');
  const formFeaturedImage = document.getElementById('form-featured-image');
  const formStatus = document.getElementById('form-status');
  const formPublishedAt = document.getElementById('form-published-at');
  const formSeoTitle = document.getElementById('form-seo-title');
  const formSeoDescription = document.getElementById('form-seo-description');
  const seoToggle = document.getElementById('seo-toggle');
  const seoFields = document.getElementById('seo-fields');
  const seoChevron = document.getElementById('seo-chevron');
  const seoPreviewTitle = document.getElementById('seo-preview-title');
  const seoPreviewUrl = document.getElementById('seo-preview-url');
  const seoPreviewDesc = document.getElementById('seo-preview-desc');
  const saveBtn = document.getElementById('save-btn');
  const saveStatus = document.getElementById('save-status');
  const modeVisual = document.getElementById('mode-visual');
  const modeCode = document.getElementById('mode-code');
  const editorToolbar = document.getElementById('editor-toolbar');
  const visualEditor = document.getElementById('visual-editor');
  const codeEditor = document.getElementById('code-editor');
  const linkBtn = document.getElementById('link-btn');
  const imageBtn = document.getElementById('image-btn');
  const linkModal = document.getElementById('link-modal');
  const imageModal = document.getElementById('image-modal');
  const unsavedModal = document.getElementById('unsaved-modal');
  const messageContainer = document.getElementById('message-container');

  // State
  let isVisualMode = true;
  let hasUnsavedChanges = false;
  let slugManuallyEdited = false;
  let pendingNavigation = null;

  // Init editor content
  if (visualEditor && existingContent) {
    visualEditor.innerHTML = existingContent;
    if (codeEditor) codeEditor.value = existingContent;
  }

  function markDirty() {
    hasUnsavedChanges = true;
    saveStatus?.classList.add('hidden');
  }

  // Slug auto-generation
  formTitle?.addEventListener('input', () => {
    if (!slugManuallyEdited && formTitle.value) {
      formSlug.value = formTitle.value
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim();
    }
    markDirty();
    if (seoPreviewTitle && !formSeoTitle?.value) {
      seoPreviewTitle.textContent = formTitle.value || 'Post title';
    }
  });

  formSlug?.addEventListener('input', () => {
    slugManuallyEdited = true;
    markDirty();
    if (seoPreviewUrl) seoPreviewUrl.textContent = '/blog/' + (formSlug.value || 'post-slug') + '/';
  });

  formExcerpt?.addEventListener('input', markDirty);
  formFeaturedImage?.addEventListener('input', markDirty);
  formStatus?.addEventListener('change', markDirty);
  formPublishedAt?.addEventListener('input', markDirty);

  formSeoTitle?.addEventListener('input', () => {
    markDirty();
    if (seoPreviewTitle) seoPreviewTitle.textContent = formSeoTitle.value || formTitle?.value || 'Post title';
  });
  formSeoDescription?.addEventListener('input', () => {
    markDirty();
    if (seoPreviewDesc) seoPreviewDesc.textContent = formSeoDescription.value || 'Meta description will appear here...';
  });

  // SEO toggle
  seoToggle?.addEventListener('click', () => {
    const isHidden = seoFields.classList.contains('hidden');
    seoFields.classList.toggle('hidden');
    seoChevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
  });

  // Visual/HTML mode switch
  modeVisual?.addEventListener('click', () => {
    if (isVisualMode) return;
    isVisualMode = true;
    visualEditor.innerHTML = codeEditor.value;
    visualEditor.classList.remove('hidden');
    codeEditor.classList.add('hidden');
    editorToolbar.classList.remove('hidden');
    modeVisual.classList.add('bg-background', 'shadow-sm', 'font-medium');
    modeVisual.classList.remove('text-muted-foreground');
    modeCode.classList.remove('bg-background', 'shadow-sm', 'font-medium');
    modeCode.classList.add('text-muted-foreground');
  });

  modeCode?.addEventListener('click', () => {
    if (!isVisualMode) return;
    isVisualMode = false;
    codeEditor.value = visualEditor.innerHTML;
    visualEditor.classList.add('hidden');
    codeEditor.classList.remove('hidden');
    editorToolbar.classList.add('hidden');
    modeCode.classList.add('bg-background', 'shadow-sm', 'font-medium');
    modeCode.classList.remove('text-muted-foreground');
    modeVisual.classList.remove('bg-background', 'shadow-sm', 'font-medium');
    modeVisual.classList.add('text-muted-foreground');
  });

  visualEditor?.addEventListener('input', markDirty);
  codeEditor?.addEventListener('input', markDirty);

  // Toolbar commands
  document.querySelectorAll('.toolbar-btn[data-cmd]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.execCommand(btn.dataset.cmd, false, null);
      visualEditor?.focus();
      markDirty();
    });
  });
  document.querySelectorAll('.toolbar-select[data-cmd]').forEach(select => {
    select.addEventListener('change', () => {
      document.execCommand(select.dataset.cmd, false, select.value);
      visualEditor?.focus();
      markDirty();
    });
  });

  // ── Highlight and text colour ────────────────────────────────────────────────
  // styleWithCSS makes execCommand emit style="..." instead of legacy <font>
  // tags. The server sanitizer allows a narrow set of CSS properties but strips
  // <font> entirely, so without this the colour silently vanished on save.
  try { document.execCommand('styleWithCSS', false, true); } catch {}

  /** Re-apply the selection an <input type="color"> stole focus from. */
  function withEditorSelection(fn) {
    visualEditor?.focus();
    fn();
    markDirty();
  }

  const highlightBtn = document.getElementById('highlight-btn');
  const highlightColor = document.getElementById('highlight-color');
  const textColor = document.getElementById('text-color');

  // Remember the selection before a colour picker takes focus, otherwise the
  // range collapses and the command applies to nothing.
  let colourSelection = null;
  const rememberSelection = () => {
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && visualEditor?.contains(sel.anchorNode)) {
      colourSelection = sel.getRangeAt(0).cloneRange();
    }
  };
  visualEditor?.addEventListener('keyup', rememberSelection);
  visualEditor?.addEventListener('mouseup', rememberSelection);

  const restoreSelection = () => {
    if (!colourSelection) return;
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(colourSelection);
  };

  highlightBtn?.addEventListener('click', () => {
    withEditorSelection(() => {
      restoreSelection();
      const colour = highlightColor?.value || '#fef08a';
      // hiliteColor is the standard; backColor is the Firefox fallback.
      if (!document.execCommand('hiliteColor', false, colour)) {
        document.execCommand('backColor', false, colour);
      }
    });
  });

  highlightColor?.addEventListener('change', () => {
    withEditorSelection(() => {
      restoreSelection();
      if (!document.execCommand('hiliteColor', false, highlightColor.value)) {
        document.execCommand('backColor', false, highlightColor.value);
      }
    });
  });

  textColor?.addEventListener('change', () => {
    withEditorSelection(() => {
      restoreSelection();
      document.execCommand('foreColor', false, textColor.value);
    });
  });

  // ── WordPress-style Link Modal ───────────────────────────────────────────────
  let savedSelection = null;
  let linkSearchTimer = null;

  const TYPE_COLOURS = {
    product: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
    category: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
    subcategory: 'bg-teal-100 text-teal-700 dark:bg-teal-900/30 dark:text-teal-400',
    page: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400',
    blog: 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400',
  };

  function saveSelection() {
    const sel = window.getSelection();
    if (sel.rangeCount > 0) savedSelection = sel.getRangeAt(0).cloneRange();
  }

  function restoreSelection() {
    if (savedSelection) {
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(savedSelection);
    }
  }

  linkBtn?.addEventListener('click', () => {
    saveSelection();
    const sel = window.getSelection();
    document.getElementById('link-text').value = sel.toString() || '';
    document.getElementById('link-url').value = '';
    document.getElementById('link-search-input').value = '';
    document.getElementById('link-new-tab').checked = false;
    document.getElementById('link-rel').value = '';
    document.getElementById('link-search-results').classList.add('hidden');
    linkModal.classList.remove('hidden');
    document.getElementById('link-search-input').focus();
  });

  // Link search with debounce
  document.getElementById('link-search-input')?.addEventListener('input', (e) => {
    clearTimeout(linkSearchTimer);
    const q = e.target.value.trim();
    const resultsEl = document.getElementById('link-search-results');
    if (q.length < 2) { resultsEl.classList.add('hidden'); return; }
    linkSearchTimer = setTimeout(async () => {
      try {
        const res = await fetch(`/api/admin/link-search?q=${encodeURIComponent(q)}`);
        const { results } = await res.json();
        if (!results.length) { resultsEl.classList.add('hidden'); return; }
        resultsEl.innerHTML = results.slice(0, 12).map(r => {
          const colour = TYPE_COLOURS[r.type] || TYPE_COLOURS.page;
          return `<button type="button" class="w-full flex items-center gap-3 px-3 py-2.5 hover:bg-muted text-left link-result-item" data-url="${r.url}">
            <span class="px-1.5 py-0.5 text-xs rounded font-medium flex-shrink-0 ${colour}">${r.type}</span>
            <span class="text-sm font-medium truncate">${r.label}</span>
            <span class="text-xs text-muted-foreground truncate ml-auto">${r.sublabel}</span>
          </button>`;
        }).join('');
        resultsEl.classList.remove('hidden');
        resultsEl.querySelectorAll('.link-result-item').forEach(item => {
          item.addEventListener('click', () => {
            document.getElementById('link-url').value = item.dataset.url;
            resultsEl.classList.add('hidden');
            document.getElementById('link-search-input').value = item.querySelector('span:nth-child(2)').textContent;
          });
        });
      } catch { resultsEl.classList.add('hidden'); }
    }, 250);
  });

  document.getElementById('link-cancel')?.addEventListener('click', () => linkModal.classList.add('hidden'));

  document.getElementById('link-insert')?.addEventListener('click', () => {
    const url = document.getElementById('link-url').value;
    const text = document.getElementById('link-text').value || url;
    if (!url) return;
    const urlLower = url.trim().toLowerCase();
    if (urlLower.startsWith('javascript:')) { showMessage('Invalid URL', 'error'); return; }

    const openNewTab = document.getElementById('link-new-tab').checked;
    const rel = document.getElementById('link-rel').value;

    const escapeAttr = (s) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const escapeText = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    let attrs = `href="${escapeAttr(url)}"`;
    if (openNewTab) attrs += ` target="_blank" rel="${rel ? rel + ' noopener noreferrer' : 'noopener noreferrer'}"`;
    else if (rel) attrs += ` rel="${escapeAttr(rel)}"`;

    restoreSelection();
    visualEditor?.focus();
    document.execCommand('insertHTML', false, `<a ${attrs}>${escapeText(text)}</a>`);
    linkModal.classList.add('hidden');
    markDirty();
  });

  // Image Modal
  imageBtn?.addEventListener('click', () => {
    saveSelection();
    document.getElementById('image-url').value = '';
    document.getElementById('image-alt').value = '';
    document.getElementById('image-file').value = '';
    document.getElementById('image-preview').classList.add('hidden');
    imageModal.classList.remove('hidden');
  });

  document.getElementById('image-cancel')?.addEventListener('click', () => imageModal.classList.add('hidden'));

  document.getElementById('image-file')?.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const preview = document.getElementById('image-preview');
    const previewImg = document.getElementById('preview-img');
    const uploadStatus = document.getElementById('upload-status');
    const reader = new FileReader();
    reader.onload = (e) => { previewImg.src = e.target.result; preview.classList.remove('hidden'); };
    reader.readAsDataURL(file);
    uploadStatus.textContent = 'Uploading...';
    try {
      const formData = new FormData();
      formData.append('file', file);
      const response = await fetch('/api/upload', { method: 'POST', body: formData });
      const result = await response.json();
      if (result.success && result.url) {
        document.getElementById('image-url').value = result.url;
        uploadStatus.textContent = 'Upload complete!';
        uploadStatus.classList.add('text-green-600');
      } else throw new Error(result.message || 'Upload failed');
    } catch (error) {
      uploadStatus.textContent = 'Upload failed: ' + error.message;
      uploadStatus.classList.add('text-red-500');
    }
  });

  document.getElementById('image-insert')?.addEventListener('click', () => {
    const url = document.getElementById('image-url').value;
    const alt = document.getElementById('image-alt').value || 'Image';
    if (!url) return;
    const urlLower = url.trim().toLowerCase();
    if (urlLower.startsWith('javascript:') || urlLower.startsWith('data:')) { showMessage('Invalid image URL', 'error'); return; }
    const escapeAttr = (s) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    restoreSelection();
    visualEditor?.focus();
    document.execCommand('insertHTML', false, `<img src="${escapeAttr(url)}" alt="${escapeAttr(alt)}" class="max-w-full h-auto rounded-lg my-4" />`);
    imageModal.classList.add('hidden');
    markDirty();
  });

  // Save
  saveBtn?.addEventListener('click', async () => {
    const title = formTitle?.value?.trim();
    const slug = formSlug?.value?.trim();
    if (!title || !slug) { showMessage('Title and slug are required', 'error'); return; }

    const content = isVisualMode ? visualEditor?.innerHTML : codeEditor?.value;
    const id = formId?.value;

    const body = {
      title,
      slug,
      excerpt: formExcerpt?.value?.trim() || null,
      content: content || null,
      featuredImage: formFeaturedImage?.value?.trim() || null,
      status: formStatus?.value || 'draft',
      publishedAt: formPublishedAt?.value ? new Date(formPublishedAt.value).toISOString() : null,
      seoTitle: formSeoTitle?.value?.trim() || null,
      seoDescription: formSeoDescription?.value?.trim() || null,
    };

    saveBtn.disabled = true;
    saveBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="4" class="opacity-25"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> <span class="hidden sm:inline">Saving...</span>';

    try {
      const isNew = !id;
      const res = await fetch(isNew ? '/api/admin/blog' : `/api/admin/blog/${id}`, {
        method: isNew ? 'POST' : 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || 'Save failed');

      hasUnsavedChanges = false;
      showMessage('Saved successfully!', 'success');
      saveStatus.textContent = 'Saved';
      saveStatus.classList.remove('hidden');

      if (isNew && result.id) {
        formId.value = result.id;
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('id', result.id);
        window.history.replaceState({}, '', newUrl.toString());
        // Add preview button dynamically
        const previewBtn = document.getElementById('preview-btn');
        if (!previewBtn && result.slug) {
          const saveStatusEl = document.getElementById('save-status');
          const a = document.createElement('a');
          a.id = 'preview-btn';
          a.href = `/blog/${result.slug}/`;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'px-4 py-2 min-h-[48px] border rounded-lg font-medium hover:bg-muted transition flex items-center gap-2 text-sm';
          a.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg> Preview';
          saveStatusEl?.parentElement?.insertBefore(a, saveStatusEl.nextSibling);
        }
      }
    } catch (error) {
      showMessage(error.message || 'Failed to save', 'error');
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span class="hidden sm:inline">Save</span>';
    }
  });

  function showMessage(text, type) {
    messageContainer.innerHTML = `<div class="p-4 rounded-lg ${type === 'error' ? 'bg-red-500/10 text-red-500 border border-red-500/20' : 'bg-green-500/10 text-green-600 border border-green-500/20'}">${text}</div>`;
    messageContainer.classList.remove('hidden');
    setTimeout(() => messageContainer.classList.add('hidden'), 5000);
  }

  // Unsaved changes protection
  window.addEventListener('beforeunload', (e) => {
    if (hasUnsavedChanges) { e.preventDefault(); e.returnValue = ''; }
  });

  document.querySelector('[data-testid="link-back"]')?.addEventListener('click', (e) => {
    if (hasUnsavedChanges) {
      e.preventDefault();
      pendingNavigation = e.target.closest('a').href;
      unsavedModal.classList.remove('hidden');
    }
  });

  document.getElementById('unsaved-stay')?.addEventListener('click', () => {
    pendingNavigation = null;
    unsavedModal.classList.add('hidden');
  });

  document.getElementById('unsaved-leave')?.addEventListener('click', () => {
    hasUnsavedChanges = false;
    if (pendingNavigation) window.location.href = pendingNavigation;
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveBtn?.click(); }
  });

  // ── Featured Image Uploader ────────────────────────────────────────────────
  (function initFeaturedImageUploader() {
    const hiddenInput   = document.getElementById('form-featured-image');
    const uploadZone    = document.getElementById('fi-upload-zone');
    const previewZone   = document.getElementById('fi-preview-zone');
    const previewImg    = document.getElementById('fi-preview-img');
    const progress      = document.getElementById('fi-upload-progress');
    const removeBtn     = document.getElementById('fi-remove-btn');
    const fileInput     = document.getElementById('fi-file-input');
    const replaceInput  = document.getElementById('fi-replace-input');
    const urlInput      = document.getElementById('fi-url-input');

    function showPreview(url) {
      hiddenInput.value = url;
      previewImg.src = url;
      uploadZone.classList.add('hidden');
      previewZone.classList.remove('hidden');
      markDirty();
    }

    function clearImage() {
      hiddenInput.value = '';
      previewImg.src = '';
      fileInput.value = '';
      replaceInput.value = '';
      urlInput.value = '';
      uploadZone.classList.remove('hidden');
      previewZone.classList.add('hidden');
      markDirty();
    }

    async function uploadFile(file) {
      if (!file) return;
      previewZone.classList.remove('hidden');
      progress.classList.remove('hidden');
      try {
        const fd = new FormData();
        fd.append('file', file);
        const res = await fetch('/api/upload', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok || !data.url) throw new Error(data.message || 'Upload failed');
        showPreview(data.url);
      } catch (err) {
        alert('Upload failed: ' + err.message);
        if (!hiddenInput.value) { previewZone.classList.add('hidden'); uploadZone.classList.remove('hidden'); }
      } finally {
        progress.classList.add('hidden');
      }
    }

    fileInput?.addEventListener('change', (e) => uploadFile(e.target.files[0]));
    replaceInput?.addEventListener('change', (e) => uploadFile(e.target.files[0]));
    removeBtn?.addEventListener('click', clearImage);

    urlInput?.addEventListener('change', () => { const url = urlInput.value.trim(); if (url) showPreview(url); });
    urlInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); const url = urlInput.value.trim(); if (url) showPreview(url); }
    });

    uploadZone?.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('border-primary'); });
    uploadZone?.addEventListener('dragleave', () => uploadZone.classList.remove('border-primary'));
    uploadZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.classList.remove('border-primary');
      const file = e.dataTransfer?.files[0];
      if (file && file.type.startsWith('image/')) uploadFile(file);
    });
  })();
</script>
