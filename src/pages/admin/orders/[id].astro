---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { formatPrice } from "@lib/currency";
import AdminOrderStatusForm from "@components/AdminOrderStatusForm";
import AdminRefundPanel from "@components/AdminRefundPanel";
import { getAdminSessionToken, verifyAdminSession, getOrderWithItems } from "@lib/admin";
import { getRefundRequestsForOrder } from "@lib/refunds";
import { getOrderCustomerDisplay } from "@lib/customerDisplay";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

// In development, allow access without login for visualization
const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const { id } = Astro.params;
const order = await getOrderWithItems(id!);

if (!order) {
  return Astro.redirect("/admin/orders");
}

const refundRequests = await getRefundRequestsForOrder(order.id);

const adminEmail = sessionData?.admin?.email || "Dev Mode";
const customer = getOrderCustomerDisplay(order);

const statusColors: Record<string, string> = {
  pending: "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400",
  confirmed: "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400",
  processing: "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400",
  shipped: "bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400",
  delivered: "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400",
  cancelled: "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400",
};
---

<BaseLayout 
  title={`Order ${order.orderNumber} - Admin`}
  description="View order details"
>
  <div class="min-h-screen flex flex-col md:flex-row">
    <AdminSidebar adminEmail={adminEmail} currentPage="orders" />

    <main class="flex-1 p-4 md:p-8">
      <div class="mb-6">
        <a href="/admin/orders" class="text-primary hover:underline text-sm">
          ← Back to Orders
        </a>
      </div>
      
      <div class="flex items-start justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold">{order.orderNumber}</h2>
          <p class="text-muted-foreground">
            {new Date(order.createdAt).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              hour: "2-digit",
              minute: "2-digit"
            })}
          </p>
        </div>
        <span class={`px-3 py-1 text-sm font-medium rounded-full ${statusColors[order.status] || statusColors.pending}`}>
          {order.status.charAt(0).toUpperCase() + order.status.slice(1)}
        </span>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
          <div class="bg-card border rounded-lg">
            <div class="p-4 border-b font-semibold">Order Items</div>
            <div class="divide-y">
              {order.items.map((item) => (
                <div class="flex gap-4 p-4">
                  <img 
                    src={item.productImage || "/placeholder.png"} 
                    alt={item.productName}
                    class="w-16 h-16 object-cover rounded-md border"
                  />
                  <div class="flex-1">
                    <p class="font-medium">{item.productName}</p>
                    <p class="text-sm text-muted-foreground">
                      {formatPrice(item.unitPrice, order.currency)} × {item.quantity}
                    </p>
                  </div>
                  <p class="font-medium">{formatPrice(item.totalPrice, order.currency)}</p>
                </div>
              ))}
            </div>
            <div class="p-4 bg-muted/30 border-t">
              <div class="space-y-1">
                <div class="flex justify-between text-sm">
                  <span>Subtotal</span>
                  <span>{formatPrice(order.subtotal, order.currency)}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span>Shipping</span>
                  <span>{formatPrice(order.shipping, order.currency)}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span>Tax</span>
                  <span>{formatPrice(order.tax, order.currency)}</span>
                </div>
                <div class="flex justify-between font-semibold text-lg pt-2 border-t">
                  <span>Total</span>
                  <span>{formatPrice(order.total, order.currency)}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="space-y-6">
          <div class="bg-card border rounded-lg p-4">
            <h3 class="font-semibold mb-4">Update Status</h3>
            <AdminOrderStatusForm 
              client:load 
              orderId={order.id}
              currentStatus={order.status}
            />
          </div>
          
          {/* Orders from before the payment integration have no payment method and a default 'awaiting_payment' status that is a schema artifact, so the card is hidden for them rather than showing a misleading status. */}
          {order.paymentMethod && (
          <div class="bg-card border rounded-lg p-4">
            <h3 class="font-semibold mb-2">Payment</h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-muted-foreground">Status</span>
                <span class="capitalize">{order.paymentStatus.replace("_", " ")}</span>
              </div>
              {order.paymentMethod && (
                <div class="flex justify-between">
                  <span class="text-muted-foreground">Method</span>
                  <span>{order.paymentMethod === "mpesa" ? "M-Pesa" : order.paymentMethod === "card" ? "Card" : order.paymentMethod === "cod" ? "Cash on Delivery" : order.paymentMethod}</span>
                </div>
              )}
              {(order.mpesaReceiptNumber || order.cardReference || order.gatewayTransactionId) && (
                <div class="flex justify-between gap-4">
                  <span class="text-muted-foreground shrink-0">
                    {order.mpesaReceiptNumber ? "M-Pesa code" : order.cardReference ? "Card reference" : "Gateway reference"}
                  </span>
                  <span class="break-all text-right text-sm">
                    {order.mpesaReceiptNumber || order.cardReference || order.gatewayTransactionId}
                  </span>
                </div>
              )}
            </div>
          </div>
          )}

          <AdminRefundPanel
            client:load
            orderId={order.id}
            orderTotal={order.total}
            currency={order.currency}
            items={order.items}
            refundRequests={refundRequests}
          />

          <div class="bg-card border rounded-lg p-4">
            <h3 class="font-semibold mb-2">Customer</h3>
            <p class="text-sm">{customer.primary}</p>
            {customer.secondary && <p class="text-sm text-muted-foreground">{customer.secondary}</p>}
          </div>
          
          {order.shippingAddress && (
            <div class="bg-card border rounded-lg p-4">
              <h3 class="font-semibold mb-2">Shipping Address</h3>
              <address class="not-italic text-sm text-muted-foreground">
                <p class="text-foreground font-medium">
                  {order.shippingAddress.firstName} {order.shippingAddress.lastName}
                </p>
                <p>{order.shippingAddress.address1}</p>
                {order.shippingAddress.address2 && <p>{order.shippingAddress.address2}</p>}
                <p>
                  {order.shippingAddress.city}, {order.shippingAddress.state || ""} {order.shippingAddress.postalCode}
                </p>
                <p>{order.shippingAddress.country}</p>
              </address>
            </div>
          )}
          
          {order.notes && (
            <div class="bg-card border rounded-lg p-4">
              <h3 class="font-semibold mb-2">Notes</h3>
              <p class="text-sm text-muted-foreground">{order.notes}</p>
            </div>
          )}
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
