---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { getAdminSessionToken, verifyAdminSession } from "@lib/admin";
import { storage } from "@lib/storage";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const adminEmail = sessionData?.admin?.email || "Dev Mode";

const { categoryGroups, subcategoryGroups } = await storage.findDuplicateCollections();
const totalGroups = categoryGroups.length + subcategoryGroups.length;
---

<BaseLayout title="Duplicate Collections - Admin" description="Find duplicate categories and subcategories">
  <div class="min-h-screen md:flex">
    <AdminSidebar adminEmail={adminEmail} currentPage="duplicates" />

    <main class="flex-1 px-4 py-6 md:p-8 w-full overflow-x-hidden">
      <h2 class="text-2xl font-bold mb-2">Duplicate Collections</h2>
      <p class="text-sm text-muted-foreground mb-6 max-w-3xl">
        Categories and subcategories that collide once capitalisation and punctuation are ignored.
        This is the same class of problem that produced duplicate brand pages ("Dove" and "DOVE"),
        which split products across two URLs and compete with each other in search.
        Subcategory names are only compared within the same parent, since "Serums" under Skincare
        and under Body Care are legitimately different collections.
      </p>

      {totalGroups === 0 ? (
        <div class="bg-card border rounded-lg p-8 text-center">
          <p class="font-medium">No duplicates found.</p>
          <p class="text-sm text-muted-foreground mt-1">
            Every category and subcategory name and slug is unique.
          </p>
        </div>
      ) : (
        <div class="space-y-8">
          <div class="text-sm">
            <span class="font-medium">{totalGroups}</span>
            <span class="text-muted-foreground"> duplicate group{totalGroups === 1 ? '' : 's'} found. Keep the one with more products and merge or delete the other.</span>
          </div>

          {categoryGroups.length > 0 && (
            <section>
              <h3 class="font-semibold mb-3">Categories ({categoryGroups.length})</h3>
              <div class="space-y-3">
                {categoryGroups.map(group => (
                  <div class="bg-card border rounded-lg p-4">
                    <p class="text-xs uppercase tracking-widest text-muted-foreground mb-2">
                      Duplicate {group.kind}
                    </p>
                    <div class="space-y-2">
                      {group.items.map(item => (
                        <div class="flex flex-wrap items-center justify-between gap-3 border rounded-md p-3">
                          <div class="min-w-0">
                            <p class="font-medium text-sm truncate">{item.name}</p>
                            <p class="text-xs text-muted-foreground font-mono">/{item.slug}/</p>
                          </div>
                          <div class="flex items-center gap-3 shrink-0">
                            <span class="text-xs text-muted-foreground">{item.productCount} products</span>
                            <a
                              href={`/admin/categories/edit?id=${item.id}&type=category`}
                              class="text-xs text-primary hover:underline"
                            >Edit</a>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {subcategoryGroups.length > 0 && (
            <section>
              <h3 class="font-semibold mb-3">Subcategories ({subcategoryGroups.length})</h3>
              <div class="space-y-3">
                {subcategoryGroups.map(group => (
                  <div class="bg-card border rounded-lg p-4">
                    <p class="text-xs uppercase tracking-widest text-muted-foreground mb-2">
                      Duplicate {group.kind} in {group.items[0]?.parentName}
                    </p>
                    <div class="space-y-2">
                      {group.items.map(item => (
                        <div class="flex flex-wrap items-center justify-between gap-3 border rounded-md p-3">
                          <div class="min-w-0">
                            <p class="font-medium text-sm truncate">{item.name}</p>
                            <p class="text-xs text-muted-foreground font-mono">/{item.slug}/ · in {item.parentName}</p>
                          </div>
                          <div class="flex items-center gap-3 shrink-0">
                            <span class="text-xs text-muted-foreground">{item.productCount} products</span>
                            <a
                              href={`/admin/categories/edit?id=${item.id}&type=subcategory`}
                              class="text-xs text-primary hover:underline"
                            >Edit</a>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>
      )}
    </main>
  </div>
</BaseLayout>
