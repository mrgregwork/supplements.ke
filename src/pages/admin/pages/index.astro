---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { getAdminSessionToken, verifyAdminSession } from "@lib/admin";
import { storage } from "@lib/storage";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const adminEmail = sessionData?.admin?.email || "Dev Mode";
const pages = await storage.getContentPages();

function formatDate(d: Date | null | undefined) {
  if (!d) return "—";
  return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}
---

<BaseLayout title="Content Pages - Admin" description="Manage content pages">
  <div class="min-h-screen flex flex-col md:flex-row">
    <AdminSidebar adminEmail={adminEmail} currentPage="pages" />

    <main class="flex-1 p-4 md:p-6 lg:p-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">Content Pages</h2>
        <a
          href="/admin/pages/edit"
          class="px-4 py-3 min-h-[48px] bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition flex items-center gap-2"
          data-testid="link-add-page"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span class="hidden sm:inline">New Page</span>
        </a>
      </div>

      <div class="bg-card border rounded-lg overflow-hidden">
        {pages.length === 0 ? (
          <div class="p-8 text-center text-muted-foreground">
            No content pages yet. Click "New Page" to create your first page.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full min-w-[500px]">
              <thead>
                <tr class="border-b bg-muted/50">
                  <th class="text-left py-4 px-4 lg:px-6 font-medium">Title</th>
                  <th class="text-left py-4 px-4 lg:px-6 font-medium hidden sm:table-cell">Slug</th>
                  <th class="text-left py-4 px-4 lg:px-6 font-medium hidden md:table-cell">Status</th>
                  <th class="text-left py-4 px-4 lg:px-6 font-medium hidden lg:table-cell">Created</th>
                  <th class="text-right py-4 px-4 lg:px-6 font-medium w-32">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {pages.map((page) => (
                  <tr class="hover:bg-muted/30 transition" data-id={page.id}>
                    <td class="py-4 px-4 lg:px-6">
                      <div class="font-medium">{page.title}</div>
                      <div class="text-sm text-muted-foreground sm:hidden">{page.slug}</div>
                    </td>
                    <td class="py-4 px-4 lg:px-6 text-sm text-muted-foreground hidden sm:table-cell">{page.slug}</td>
                    <td class="py-4 px-4 lg:px-6 hidden md:table-cell">
                      {page.status === "published" ? (
                        <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Published</span>
                      ) : (
                        <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">Draft</span>
                      )}
                    </td>
                    <td class="py-4 px-4 lg:px-6 text-sm text-muted-foreground hidden lg:table-cell">{formatDate(page.createdAt)}</td>
                    <td class="py-4 px-4 lg:px-6 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <a
                          href={`/admin/pages/edit?id=${page.id}`}
                          class="px-3 py-2 min-h-[40px] text-sm text-primary hover:bg-primary/10 rounded-md transition"
                          data-testid={`link-edit-page-${page.id}`}
                        >
                          Edit
                        </a>
                        <button
                          class="px-3 py-2 min-h-[40px] text-sm text-red-500 hover:bg-red-500/10 rounded-md transition delete-btn"
                          data-id={page.id}
                          data-title={page.title}
                          data-testid={`button-delete-page-${page.id}`}
                        >
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </main>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="delete-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-background rounded-lg shadow-xl w-full max-w-sm p-6">
      <h3 class="text-lg font-semibold mb-2">Delete Content Page</h3>
      <p id="delete-message" class="text-muted-foreground mb-4">Are you sure you want to delete this page?</p>
      <div class="flex justify-end gap-2">
        <button type="button" id="delete-cancel" class="px-4 py-2 min-h-[48px] border rounded-lg hover:bg-muted transition">Cancel</button>
        <button type="button" id="delete-confirm" class="px-4 py-2 min-h-[48px] bg-red-500 text-white rounded-lg hover:opacity-90 transition">Delete</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const deleteModal = document.getElementById('delete-modal');
  const deleteMessage = document.getElementById('delete-message');
  const deleteCancel = document.getElementById('delete-cancel');
  const deleteConfirm = document.getElementById('delete-confirm');
  let pendingDeleteId: string | null = null;

  function showDeleteModal(id: string, title: string) {
    pendingDeleteId = id;
    deleteMessage!.textContent = `Are you sure you want to delete "${title}"? This action cannot be undone.`;
    deleteModal!.classList.remove('hidden');
  }

  function hideDeleteModal() {
    pendingDeleteId = null;
    deleteModal!.classList.add('hidden');
  }

  deleteCancel?.addEventListener('click', hideDeleteModal);
  deleteModal?.addEventListener('click', (e) => { if (e.target === deleteModal) hideDeleteModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideDeleteModal(); });

  deleteConfirm?.addEventListener('click', async () => {
    if (!pendingDeleteId) return;
    deleteConfirm.disabled = true;
    deleteConfirm.textContent = 'Deleting...';
    try {
      const res = await fetch(`/api/admin/pages/${pendingDeleteId}`, { method: 'DELETE' });
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Failed to delete');
        hideDeleteModal();
      }
    } catch {
      alert('Failed to delete. Please try again.');
      hideDeleteModal();
    } finally {
      (deleteConfirm as HTMLButtonElement).disabled = false;
      deleteConfirm.textContent = 'Delete';
    }
  });

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      showDeleteModal(target.dataset.id!, target.dataset.title!);
    });
  });
</script>
