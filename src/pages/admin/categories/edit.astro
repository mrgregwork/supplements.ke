---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { getAdminSessionToken, verifyAdminSession, getAllCategories } from "@lib/admin";
import { storage } from "@lib/storage";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const adminEmail = sessionData?.admin?.email || "Dev Mode";

// Get query parameters
const url = new URL(Astro.request.url);
const id = url.searchParams.get('id');
const type = url.searchParams.get('type') || 'category';
const parentId = url.searchParams.get('parent');

// Get all categories for parent dropdown
const allCategories = await getAllCategories();

// Fetch existing data if editing
let existingData = null;
if (id) {
  if (type === 'subcategory') {
    const subcategories = await storage.getSubcategories();
    existingData = subcategories.find(s => s.id === id);
  } else {
    existingData = allCategories.find(c => c.id === id);
  }
}

const isEditing = !!existingData;
const pageTitle = isEditing 
  ? `Edit ${type === 'subcategory' ? 'Subcategory' : 'Category'}: ${existingData?.name}`
  : `Add New ${type === 'subcategory' || parentId ? 'Subcategory' : 'Category'}`;
---

<BaseLayout 
  title={pageTitle + " - Admin"} 
  description="Edit category or subcategory"
>
  <div class="min-h-screen flex flex-col md:flex-row">
    <AdminSidebar adminEmail={adminEmail} currentPage="categories" />
    
    <main class="flex-1 flex flex-col min-h-screen">
      <!-- Top Bar -->
      <header class="sticky top-0 z-20 bg-background border-b px-4 md:px-6 py-3 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a 
            href="/admin/categories" 
            class="p-2 min-h-[48px] min-w-[48px] hover:bg-muted rounded-lg transition flex items-center justify-center"
            data-testid="link-back"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
          <h1 class="text-lg md:text-xl font-semibold truncate">{pageTitle}</h1>
        </div>
        <div class="flex items-center gap-2">
          <span id="save-status" class="text-sm text-muted-foreground hidden">Saved</span>
          <button
            type="button"
            id="save-btn"
            class="px-4 py-2 min-h-[48px] bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition flex items-center gap-2"
            data-testid="button-save"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="hidden sm:inline">Save</span>
          </button>
        </div>
      </header>
      
      <!-- Main Content Area -->
      <div class="flex-1 overflow-y-auto">
        <div class="max-w-4xl mx-auto p-4 md:p-6 lg:p-8">
          <!-- Form Fields -->
          <form id="edit-form" class="space-y-6">
            <input type="hidden" id="form-id" value={id || ''} />
            <input type="hidden" id="form-type" value={type} />
            
            <!-- Name and Slug Row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium mb-2" for="form-name">Name *</label>
                <input 
                  type="text" 
                  id="form-name"
                  required
                  value={existingData?.name || ''}
                  class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                  placeholder="Enter category name"
                  data-testid="input-name"
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" for="form-slug">Slug *</label>
                <input 
                  type="text" 
                  id="form-slug"
                  required
                  value={existingData?.slug || ''}
                  class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                  placeholder="category-slug"
                  data-testid="input-slug"
                />
                <p id="slug-error" class="text-red-500 text-xs mt-1 hidden">This slug already exists</p>
              </div>
            </div>
            
            <!-- Parent Category (for subcategories) -->
            <div id="parent-field">
              <label class="block text-sm font-medium mb-2" for="form-parent">Parent Category</label>
              <select 
                id="form-parent"
                class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                data-testid="select-parent"
              >
                <option value="">None (Top Level Category)</option>
                {allCategories.map(cat => (
                  <option 
                    value={cat.id} 
                    selected={existingData?.categoryId === cat.id || parentId === cat.id}
                  >
                    {cat.name}
                  </option>
                ))}
              </select>
              <p class="text-xs text-muted-foreground mt-2">Select a parent to create this as a subcategory</p>
            </div>
            
            <!-- Description Editor Section -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="block text-sm font-medium">Description</label>
                <div class="flex items-center gap-1 bg-muted rounded-lg p-1">
                  <button 
                    type="button" 
                    id="mode-visual" 
                    class="px-3 py-1.5 min-h-[36px] text-sm rounded-md bg-background shadow-sm font-medium"
                    data-testid="button-mode-visual"
                  >
                    Visual
                  </button>
                  <button 
                    type="button" 
                    id="mode-code" 
                    class="px-3 py-1.5 min-h-[36px] text-sm rounded-md text-muted-foreground hover:text-foreground transition"
                    data-testid="button-mode-code"
                  >
                    HTML
                  </button>
                </div>
              </div>
              
              <!-- Visual Editor Toolbar -->
              <div id="editor-toolbar" class="border border-b-0 rounded-t-lg bg-muted/30 p-2 flex flex-wrap gap-1">
                <button type="button" data-cmd="bold" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded font-bold text-sm" title="Bold (Ctrl+B)">B</button>
                <button type="button" data-cmd="italic" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded italic text-sm" title="Italic (Ctrl+I)">I</button>
                <button type="button" data-cmd="underline" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded underline text-sm" title="Underline (Ctrl+U)">U</button>
                <button type="button" data-cmd="strikeThrough" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded line-through text-sm" title="Strikethrough">S</button>
                
                <div class="w-px bg-border mx-1 h-6 self-center"></div>
                
                <select data-cmd="formatBlock" class="toolbar-select px-2 py-1 min-h-[36px] text-sm bg-background border rounded">
                  <option value="p">Paragraph</option>
                  <option value="h2">Heading 2</option>
                  <option value="h3">Heading 3</option>
                  <option value="h4">Heading 4</option>
                </select>
                
                <div class="w-px bg-border mx-1 h-6 self-center"></div>
                
                <button type="button" data-cmd="insertUnorderedList" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Bullet List">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <button type="button" data-cmd="insertOrderedList" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Numbered List">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h10M7 16h10M3 8h.01M3 12h.01M3 16h.01"></path></svg>
                </button>
                
                <div class="w-px bg-border mx-1 h-6 self-center"></div>
                
                <button type="button" id="link-btn" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Insert Link">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                </button>
                <button type="button" id="image-btn" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Insert Image">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </button>
                
                <div class="w-px bg-border mx-1 h-6 self-center"></div>
                
                <button type="button" data-cmd="removeFormat" class="toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm text-muted-foreground" title="Clear Formatting">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
              </div>
              
              <!-- Visual Editor (contenteditable) -->
              <div 
                id="visual-editor"
                contenteditable="true"
                class="min-h-[300px] md:min-h-[400px] border rounded-b-lg p-4 bg-background focus:outline-none focus:ring-2 focus:ring-primary prose prose-sm max-w-none dark:prose-invert"
                data-testid="editor-visual"
              ></div>
              
              <!-- HTML Code Editor (hidden by default) -->
              <textarea
                id="code-editor"
                class="hidden w-full min-h-[300px] md:min-h-[400px] border rounded-lg p-4 bg-background font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                placeholder="Enter HTML code here..."
                data-testid="editor-code"
              ></textarea>
            </div>
            
            <!-- Rich SEO Content (longDescription) -->
            <div class="border rounded-lg overflow-hidden">
              <button
                type="button"
                id="long-desc-toggle"
                class="w-full flex items-center justify-between p-4 bg-muted/30 hover:bg-muted/50 transition text-left"
              >
                <div>
                  <h3 class="font-semibold text-sm">Rich Content (page bottom)</h3>
                  <p class="text-xs text-muted-foreground mt-0.5">SEO text displayed in an expandable section at the bottom of this page. Great for hub content and keyword-rich copy.</p>
                </div>
                <svg id="long-desc-chevron" class="w-5 h-5 text-muted-foreground transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="long-desc-fields" class="hidden border-t">
                <div class="p-4">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs text-muted-foreground">Supports full HTML. Use headings, bullet points, and internal links for best SEO results.</span>
                    <div class="flex items-center gap-1 bg-muted rounded-lg p-1">
                      <button type="button" id="ld-mode-visual" class="px-3 py-1.5 min-h-[36px] text-sm rounded-md bg-background shadow-sm font-medium">Visual</button>
                      <button type="button" id="ld-mode-code" class="px-3 py-1.5 min-h-[36px] text-sm rounded-md text-muted-foreground hover:text-foreground transition">HTML</button>
                    </div>
                  </div>
                  <!-- Toolbar -->
                  <div id="ld-toolbar" class="border border-b-0 rounded-t-lg bg-muted/30 p-2 flex flex-wrap gap-1">
                    <button type="button" data-ld-cmd="bold" class="ld-toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded font-bold text-sm" title="Bold">B</button>
                    <button type="button" data-ld-cmd="italic" class="ld-toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded italic text-sm" title="Italic">I</button>
                    <button type="button" data-ld-cmd="underline" class="ld-toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded underline text-sm" title="Underline">U</button>
                    <div class="w-px bg-border mx-1 h-6 self-center"></div>
                    <select data-ld-cmd="formatBlock" class="ld-toolbar-select px-2 py-1 min-h-[36px] text-sm bg-background border rounded">
                      <option value="p">Paragraph</option>
                      <option value="h2">Heading 2</option>
                      <option value="h3">Heading 3</option>
                      <option value="h4">Heading 4</option>
                    </select>
                    <div class="w-px bg-border mx-1 h-6 self-center"></div>
                    <button type="button" data-ld-cmd="insertUnorderedList" class="ld-toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Bullet List">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </button>
                    <button type="button" data-ld-cmd="insertOrderedList" class="ld-toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm" title="Numbered List">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h10M7 16h10M3 8h.01M3 12h.01M3 16h.01"></path></svg>
                    </button>
                    <div class="w-px bg-border mx-1 h-6 self-center"></div>
                    <button type="button" data-ld-cmd="removeFormat" class="ld-toolbar-btn px-2 py-1 min-h-[36px] min-w-[36px] hover:bg-muted rounded text-sm text-muted-foreground" title="Clear Formatting">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                  </div>
                  <div id="ld-visual-editor" contenteditable="true"
                    class="min-h-[250px] border rounded-b-lg p-4 bg-background focus:outline-none focus:ring-2 focus:ring-primary prose prose-sm max-w-none dark:prose-invert"
                  ></div>
                  <textarea id="ld-code-editor"
                    class="hidden w-full min-h-[250px] border rounded-lg p-4 bg-background font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="Enter HTML..."
                  ></textarea>
                </div>
              </div>
            </div>

            <!-- Hero Image -->
            <div>
              <label class="block text-sm font-medium mb-2" for="form-hero-image">Hero Image URL</label>
              <input 
                type="url" 
                id="form-hero-image"
                value={existingData?.heroImage || ''}
                class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                placeholder="https://example.com/image.jpg"
                data-testid="input-hero-image"
              />
              <p class="text-xs text-muted-foreground mt-1">Featured image displayed at the top of the collection page</p>
            </div>
            
            <!-- Status & Sort Order -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium mb-2" for="form-is-active">Status</label>
                <select 
                  id="form-is-active"
                  class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                  data-testid="select-status"
                >
                  <option value="true" selected={existingData?.isActive !== false}>Active</option>
                  <option value="false" selected={existingData?.isActive === false}>Draft</option>
                </select>
                <p class="text-xs text-muted-foreground mt-1">Draft collections are hidden from your storefront</p>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2" for="form-sort-order">Sort Order</label>
                <input 
                  type="number" 
                  id="form-sort-order"
                  value={existingData?.sortOrder?.toString() || '0'}
                  class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                  placeholder="0"
                  data-testid="input-sort-order"
                />
                <p class="text-xs text-muted-foreground mt-1">Lower numbers appear first in listings</p>
              </div>
            </div>

            <!-- SEO Section -->
            <div class="border rounded-lg overflow-hidden">
              <button
                type="button"
                id="seo-toggle"
                class="w-full flex items-center justify-between p-4 bg-primary/5 hover:bg-primary/10 transition text-left"
                data-testid="button-seo-toggle"
              >
                <div>
                  <h3 class="font-semibold text-sm flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
                    SEO — Page Title & Meta Description
                  </h3>
                  <p class="text-xs text-muted-foreground mt-0.5">Controls how this page appears in Google search results</p>
                </div>
                <svg id="seo-chevron" class="w-5 h-5 text-muted-foreground transition-transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="seo-fields" class="p-4 space-y-4 border-t">
                <div>
                  <label class="block text-sm font-medium mb-2" for="form-seo-title">Page title</label>
                  <input 
                    type="text" 
                    id="form-seo-title"
                    value={existingData?.seoTitle || ''}
                    class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
                    placeholder={existingData?.name || 'Collection name'}
                    data-testid="input-seo-title"
                  />
                  <p class="text-xs text-muted-foreground mt-1">Recommended: 70 characters or less</p>
                </div>
                <div>
                  <label class="block text-sm font-medium mb-2" for="form-seo-description">Meta description</label>
                  <textarea 
                    id="form-seo-description"
                    rows="3"
                    class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none resize-none"
                    placeholder="Enter a meta description for search engines"
                    data-testid="input-seo-description"
                  >{existingData?.seoDescription || ''}</textarea>
                  <p class="text-xs text-muted-foreground mt-1">Recommended: 160 characters or less</p>
                </div>
                <div class="bg-muted/30 rounded-lg p-4">
                  <p id="seo-preview-title" class="text-sm font-medium text-green-700 dark:text-green-400 truncate">
                    {existingData?.seoTitle || existingData?.name || 'Collection name'}
                  </p>
                  <p id="seo-preview-url" class="text-xs text-green-600 dark:text-green-500 truncate mt-0.5">
                    /{existingData?.slug || 'collection-slug'}
                  </p>
                  <p id="seo-preview-desc" class="text-xs text-muted-foreground mt-1 line-clamp-2">
                    {existingData?.seoDescription || 'Meta description will appear here...'}
                  </p>
                </div>
              </div>
            </div>

            <!-- Error/Success Messages -->
            <div id="message-container" class="hidden"></div>
          </form>
        </div>
      </div>
    </main>
  </div>
  
  <!-- Link Modal -->
  <div id="link-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-background rounded-lg shadow-xl w-full max-w-md p-6">
      <h3 class="text-lg font-semibold mb-4">Insert Link</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-2">URL</label>
          <input 
            type="url" 
            id="link-url" 
            placeholder="https://example.com"
            class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background"
            data-testid="input-link-url"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Text (optional)</label>
          <input 
            type="text" 
            id="link-text" 
            placeholder="Link text"
            class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background"
            data-testid="input-link-text"
          />
        </div>
        <div class="flex justify-end gap-2">
          <button 
            type="button" 
            id="link-cancel" 
            class="px-4 py-2 min-h-[48px] border rounded-lg hover:bg-muted transition"
            data-testid="button-link-cancel"
          >
            Cancel
          </button>
          <button 
            type="button" 
            id="link-insert" 
            class="px-4 py-2 min-h-[48px] bg-primary text-primary-foreground rounded-lg hover:opacity-90 transition"
            data-testid="button-link-insert"
          >
            Insert
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Image Upload Modal -->
  <div id="image-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-background rounded-lg shadow-xl w-full max-w-md p-6">
      <h3 class="text-lg font-semibold mb-4">Insert Image</h3>
      <div class="space-y-4">
        <div class="border-2 border-dashed rounded-lg p-6 text-center">
          <input type="file" id="image-file" accept="image/*" class="hidden" />
          <label for="image-file" class="cursor-pointer">
            <svg class="w-12 h-12 mx-auto text-muted-foreground mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            <p class="text-sm text-muted-foreground">Click to upload or drag and drop</p>
            <p class="text-xs text-muted-foreground mt-1">PNG, JPG, GIF up to 10MB</p>
          </label>
        </div>
        <div id="image-preview" class="hidden">
          <img id="preview-img" class="max-h-40 mx-auto rounded-lg" alt="Preview" />
          <p id="upload-status" class="text-sm text-center mt-2 text-muted-foreground">Uploading...</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Or enter image URL</label>
          <input 
            type="url" 
            id="image-url" 
            placeholder="https://example.com/image.jpg"
            class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background"
            data-testid="input-image-url"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Alt text (for accessibility)</label>
          <input 
            type="text" 
            id="image-alt" 
            placeholder="Describe the image"
            class="w-full px-4 py-3 min-h-[48px] border rounded-lg bg-background"
            data-testid="input-image-alt"
          />
        </div>
        <div class="flex justify-end gap-2">
          <button 
            type="button" 
            id="image-cancel" 
            class="px-4 py-2 min-h-[48px] border rounded-lg hover:bg-muted transition"
            data-testid="button-image-cancel"
          >
            Cancel
          </button>
          <button 
            type="button" 
            id="image-insert" 
            class="px-4 py-2 min-h-[48px] bg-primary text-primary-foreground rounded-lg hover:opacity-90 transition"
            data-testid="button-image-insert"
          >
            Insert
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Unsaved Changes Modal -->
  <div id="unsaved-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-background rounded-lg shadow-xl w-full max-w-sm p-6">
      <h3 class="text-lg font-semibold mb-2">Unsaved Changes</h3>
      <p class="text-muted-foreground mb-4">You have unsaved changes. Are you sure you want to leave?</p>
      <div class="flex justify-end gap-2">
        <button 
          type="button" 
          id="unsaved-stay" 
          class="px-4 py-2 min-h-[48px] border rounded-lg hover:bg-muted transition"
          data-testid="button-unsaved-stay"
        >
          Stay
        </button>
        <button 
          type="button" 
          id="unsaved-leave" 
          class="px-4 py-2 min-h-[48px] bg-red-500 text-white rounded-lg hover:opacity-90 transition"
          data-testid="button-unsaved-leave"
        >
          Leave
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ existingDescription: existingData?.description || '', existingLongDescription: existingData?.longDescription || '' }}>
  // DOM Elements
  const formName = document.getElementById('form-name');
  const formSlug = document.getElementById('form-slug');
  const formParent = document.getElementById('form-parent');
  const formId = document.getElementById('form-id');
  const formType = document.getElementById('form-type');
  const formHeroImage = document.getElementById('form-hero-image');
  const formIsActive = document.getElementById('form-is-active');
  const formSortOrder = document.getElementById('form-sort-order');
  const formSeoTitle = document.getElementById('form-seo-title');
  const formSeoDescription = document.getElementById('form-seo-description');
  const seoToggle = document.getElementById('seo-toggle');
  const seoFields = document.getElementById('seo-fields');
  const seoChevron = document.getElementById('seo-chevron');
  const seoPreviewTitle = document.getElementById('seo-preview-title');
  const seoPreviewUrl = document.getElementById('seo-preview-url');
  const seoPreviewDesc = document.getElementById('seo-preview-desc');
  const saveBtn = document.getElementById('save-btn');
  const saveStatus = document.getElementById('save-status');
  const modeVisual = document.getElementById('mode-visual');
  const modeCode = document.getElementById('mode-code');
  const editorToolbar = document.getElementById('editor-toolbar');
  const visualEditor = document.getElementById('visual-editor');
  const codeEditor = document.getElementById('code-editor');
  const linkBtn = document.getElementById('link-btn');
  const imageBtn = document.getElementById('image-btn');
  const linkModal = document.getElementById('link-modal');
  const imageModal = document.getElementById('image-modal');
  const unsavedModal = document.getElementById('unsaved-modal');
  const messageContainer = document.getElementById('message-container');
  
  // State
  let isVisualMode = true;
  let hasUnsavedChanges = false;
  let slugManuallyEdited = false;
  let pendingNavigation = null;
  
  // Initialize description editor
  if (visualEditor && existingDescription) {
    visualEditor.innerHTML = existingDescription;
    if (codeEditor) codeEditor.value = existingDescription;
  }

  // ── Long Description (rich SEO content) editor ──────────────────────────────
  const ldToggle      = document.getElementById('long-desc-toggle');
  const ldFields      = document.getElementById('long-desc-fields');
  const ldChevron     = document.getElementById('long-desc-chevron');
  const ldModeVisual  = document.getElementById('ld-mode-visual');
  const ldModeCode    = document.getElementById('ld-mode-code');
  const ldToolbar     = document.getElementById('ld-toolbar');
  const ldVisual      = document.getElementById('ld-visual-editor');
  const ldCode        = document.getElementById('ld-code-editor');
  let ldIsVisual      = true;

  if (ldVisual && existingLongDescription) {
    ldVisual.innerHTML = existingLongDescription;
    if (ldCode) ldCode.value = existingLongDescription;
  }

  ldToggle?.addEventListener('click', () => {
    const hidden = ldFields.classList.contains('hidden');
    ldFields.classList.toggle('hidden');
    ldChevron.style.transform = hidden ? 'rotate(180deg)' : '';
  });

  ldModeVisual?.addEventListener('click', () => {
    if (ldIsVisual) return;
    ldIsVisual = true;
    ldVisual.innerHTML = ldCode.value;
    ldVisual.classList.remove('hidden');
    ldCode.classList.add('hidden');
    ldToolbar.classList.remove('hidden');
    ldModeVisual.classList.add('bg-background', 'shadow-sm', 'font-medium');
    ldModeVisual.classList.remove('text-muted-foreground');
    ldModeCode.classList.remove('bg-background', 'shadow-sm', 'font-medium');
    ldModeCode.classList.add('text-muted-foreground');
  });

  ldModeCode?.addEventListener('click', () => {
    if (!ldIsVisual) return;
    ldIsVisual = false;
    ldCode.value = ldVisual.innerHTML;
    ldVisual.classList.add('hidden');
    ldCode.classList.remove('hidden');
    ldToolbar.classList.add('hidden');
    ldModeCode.classList.add('bg-background', 'shadow-sm', 'font-medium');
    ldModeCode.classList.remove('text-muted-foreground');
    ldModeVisual.classList.remove('bg-background', 'shadow-sm', 'font-medium');
    ldModeVisual.classList.add('text-muted-foreground');
  });

  document.querySelectorAll('.ld-toolbar-btn[data-ld-cmd]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.execCommand(btn.dataset.ldCmd, false, null);
      ldVisual?.focus();
      markDirty();
    });
  });
  document.querySelectorAll('.ld-toolbar-select[data-ld-cmd]').forEach(sel => {
    sel.addEventListener('change', () => {
      document.execCommand(sel.dataset.ldCmd, false, sel.value);
      ldVisual?.focus();
      markDirty();
    });
  });
  ldVisual?.addEventListener('input', markDirty);
  ldCode?.addEventListener('input', markDirty);
  
  // Auto-generate slug from name
  formName?.addEventListener('input', () => {
    if (!slugManuallyEdited && formName.value) {
      formSlug.value = formName.value
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim();
    }
    markDirty();
  });
  
  formSlug?.addEventListener('input', () => {
    slugManuallyEdited = true;
    markDirty();
  });
  
  formParent?.addEventListener('change', markDirty);
  formHeroImage?.addEventListener('input', markDirty);
  formIsActive?.addEventListener('change', markDirty);
  formSortOrder?.addEventListener('input', markDirty);
  formSeoTitle?.addEventListener('input', () => {
    markDirty();
    if (seoPreviewTitle) seoPreviewTitle.textContent = formSeoTitle.value || formName?.value || 'Collection name';
  });
  formSeoDescription?.addEventListener('input', () => {
    markDirty();
    if (seoPreviewDesc) seoPreviewDesc.textContent = formSeoDescription.value || 'Meta description will appear here...';
  });
  
  // SEO section toggle (open by default)
  seoToggle?.addEventListener('click', () => {
    const isHidden = seoFields.classList.contains('hidden');
    seoFields.classList.toggle('hidden');
    seoChevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
  });

  // Update SEO preview when name/slug change
  formName?.addEventListener('input', () => {
    if (seoPreviewTitle && !formSeoTitle?.value) {
      seoPreviewTitle.textContent = formName.value || 'Collection name';
    }
  });
  formSlug?.addEventListener('input', () => {
    if (seoPreviewUrl) {
      seoPreviewUrl.textContent = '/' + (formSlug.value || 'collection-slug');
    }
  });
  
  // Track changes
  function markDirty() {
    hasUnsavedChanges = true;
    saveStatus?.classList.add('hidden');
  }
  
  visualEditor?.addEventListener('input', markDirty);
  codeEditor?.addEventListener('input', markDirty);
  
  // Mode switching
  modeVisual?.addEventListener('click', () => {
    if (isVisualMode) return;
    isVisualMode = true;
    
    // Sync code to visual
    visualEditor.innerHTML = codeEditor.value;
    
    // Update UI
    visualEditor.classList.remove('hidden');
    codeEditor.classList.add('hidden');
    editorToolbar.classList.remove('hidden');
    modeVisual.classList.add('bg-background', 'shadow-sm', 'font-medium');
    modeVisual.classList.remove('text-muted-foreground');
    modeCode.classList.remove('bg-background', 'shadow-sm', 'font-medium');
    modeCode.classList.add('text-muted-foreground');
  });
  
  modeCode?.addEventListener('click', () => {
    if (!isVisualMode) return;
    isVisualMode = false;
    
    // Sync visual to code
    codeEditor.value = visualEditor.innerHTML;
    
    // Update UI
    visualEditor.classList.add('hidden');
    codeEditor.classList.remove('hidden');
    editorToolbar.classList.add('hidden');
    modeCode.classList.add('bg-background', 'shadow-sm', 'font-medium');
    modeCode.classList.remove('text-muted-foreground');
    modeVisual.classList.remove('bg-background', 'shadow-sm', 'font-medium');
    modeVisual.classList.add('text-muted-foreground');
  });
  
  // Toolbar commands
  document.querySelectorAll('.toolbar-btn[data-cmd]').forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.cmd;
      document.execCommand(cmd, false, null);
      visualEditor?.focus();
      markDirty();
    });
  });
  
  document.querySelectorAll('.toolbar-select[data-cmd]').forEach(select => {
    select.addEventListener('change', () => {
      const cmd = select.dataset.cmd;
      const value = select.value;
      document.execCommand(cmd, false, value);
      visualEditor?.focus();
      markDirty();
    });
  });
  
  // Link insertion
  let savedSelection = null;
  
  function saveSelection() {
    const sel = window.getSelection();
    if (sel.rangeCount > 0) {
      savedSelection = sel.getRangeAt(0).cloneRange();
    }
  }
  
  function restoreSelection() {
    if (savedSelection) {
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(savedSelection);
    }
  }
  
  linkBtn?.addEventListener('click', () => {
    saveSelection();
    const sel = window.getSelection();
    document.getElementById('link-text').value = sel.toString() || '';
    document.getElementById('link-url').value = '';
    linkModal.classList.remove('hidden');
  });
  
  document.getElementById('link-cancel')?.addEventListener('click', () => {
    linkModal.classList.add('hidden');
  });
  
  document.getElementById('link-insert')?.addEventListener('click', () => {
    const url = document.getElementById('link-url').value;
    const text = document.getElementById('link-text').value || url;
    
    if (!url) return;
    
    // Validate URL - block javascript: URLs
    const urlLower = url.trim().toLowerCase();
    if (urlLower.startsWith('javascript:')) {
      showMessage('Invalid URL', 'error');
      return;
    }
    
    // Escape HTML entities in attributes
    const escapeAttr = (s) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const escapeText = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    
    restoreSelection();
    visualEditor?.focus();
    
    const link = `<a href="${escapeAttr(url)}" target="_blank" rel="noopener noreferrer">${escapeText(text)}</a>`;
    document.execCommand('insertHTML', false, link);
    
    linkModal.classList.add('hidden');
    markDirty();
  });
  
  // Image insertion
  imageBtn?.addEventListener('click', () => {
    saveSelection();
    document.getElementById('image-url').value = '';
    document.getElementById('image-alt').value = '';
    document.getElementById('image-file').value = '';
    document.getElementById('image-preview').classList.add('hidden');
    imageModal.classList.remove('hidden');
  });
  
  document.getElementById('image-cancel')?.addEventListener('click', () => {
    imageModal.classList.add('hidden');
  });
  
  // Handle file upload
  document.getElementById('image-file')?.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    
    const preview = document.getElementById('image-preview');
    const previewImg = document.getElementById('preview-img');
    const uploadStatus = document.getElementById('upload-status');
    
    // Show preview
    const reader = new FileReader();
    reader.onload = (e) => {
      previewImg.src = e.target.result;
      preview.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
    
    uploadStatus.textContent = 'Uploading...';
    
    try {
      const formData = new FormData();
      formData.append('file', file);
      
      const response = await fetch('/api/upload', {
        method: 'POST',
        body: formData
      });
      
      const result = await response.json();
      
      if (result.success && result.url) {
        document.getElementById('image-url').value = result.url;
        uploadStatus.textContent = 'Upload complete!';
        uploadStatus.classList.remove('text-muted-foreground');
        uploadStatus.classList.add('text-green-600');
      } else {
        throw new Error(result.message || 'Upload failed');
      }
    } catch (error) {
      uploadStatus.textContent = 'Upload failed: ' + error.message;
      uploadStatus.classList.remove('text-muted-foreground');
      uploadStatus.classList.add('text-red-500');
    }
  });
  
  document.getElementById('image-insert')?.addEventListener('click', () => {
    const url = document.getElementById('image-url').value;
    const alt = document.getElementById('image-alt').value || 'Image';
    
    if (!url) return;
    
    // Validate URL - block dangerous protocols (server also sanitizes)
    const urlLower = url.trim().toLowerCase();
    if (urlLower.startsWith('javascript:') || urlLower.startsWith('data:')) {
      showMessage('Invalid image URL', 'error');
      return;
    }
    
    // Escape HTML entities in attributes
    const escapeAttr = (s) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    
    restoreSelection();
    visualEditor?.focus();
    
    const img = `<img src="${escapeAttr(url)}" alt="${escapeAttr(alt)}" class="max-w-full h-auto rounded-lg my-4" />`;
    document.execCommand('insertHTML', false, img);
    
    imageModal.classList.add('hidden');
    markDirty();
  });
  
  // Save functionality
  saveBtn?.addEventListener('click', async () => {
    const name = formName?.value?.trim();
    const slug = formSlug?.value?.trim();
    const parentCategoryId = formParent?.value || null;
    const description = isVisualMode ? visualEditor?.innerHTML : codeEditor?.value;
    const longDescription = ldIsVisual ? (ldVisual?.innerHTML || '') : (ldCode?.value || '');
    const heroImage = formHeroImage?.value?.trim() || null;
    const isActive = formIsActive?.value === 'true';
    const sortOrder = parseInt(formSortOrder?.value || '0', 10) || 0;
    const seoTitle = formSeoTitle?.value?.trim() || null;
    const seoDescription = formSeoDescription?.value?.trim() || null;
    const id = formId?.value;
    const type = formType?.value;
    
    if (!name || !slug) {
      showMessage('Name and slug are required', 'error');
      return;
    }
    
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="4" class="opacity-25"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> <span class="hidden sm:inline">Saving...</span>';
    
    try {
      const isSubcategory = parentCategoryId && parentCategoryId !== '';
      const isEditing = id && id !== '';
      
      let url, method, body;
      
      if (isSubcategory) {
        url = isEditing ? `/api/admin/subcategories/${id}` : '/api/admin/subcategories';
        method = isEditing ? 'PUT' : 'POST';
        body = { name, slug, description, longDescription, categoryId: parentCategoryId, heroImage, isActive, sortOrder, seoTitle, seoDescription };
      } else {
        url = isEditing ? `/api/admin/categories/${id}` : '/api/admin/categories';
        method = isEditing ? 'PUT' : 'POST';
        body = { name, slug, description, longDescription, heroImage, isActive, sortOrder, seoTitle, seoDescription };
      }
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      
      const result = await response.json();
      
      if (!response.ok) {
        throw new Error(result.message || 'Save failed');
      }
      
      hasUnsavedChanges = false;
      showMessage('Saved successfully!', 'success');
      saveStatus.textContent = 'Saved';
      saveStatus.classList.remove('hidden');
      
      // Update form with new ID if creating
      if (!isEditing && result.id) {
        formId.value = result.id;
        // Update URL without reloading
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('id', result.id);
        newUrl.searchParams.set('type', isSubcategory ? 'subcategory' : 'category');
        window.history.replaceState({}, '', newUrl.toString());
      }
      
    } catch (error) {
      showMessage(error.message || 'Failed to save', 'error');
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span class="hidden sm:inline">Save</span>';
    }
  });
  
  function showMessage(text, type) {
    messageContainer.innerHTML = `
      <div class="p-4 rounded-lg ${type === 'error' ? 'bg-red-500/10 text-red-500 border border-red-500/20' : 'bg-green-500/10 text-green-600 border border-green-500/20'}">
        ${text}
      </div>
    `;
    messageContainer.classList.remove('hidden');
    
    setTimeout(() => {
      messageContainer.classList.add('hidden');
    }, 5000);
  }
  
  // Unsaved changes protection
  window.addEventListener('beforeunload', (e) => {
    if (hasUnsavedChanges) {
      e.preventDefault();
      e.returnValue = '';
    }
  });
  
  // Handle back button with unsaved changes
  document.querySelector('[data-testid="link-back"]')?.addEventListener('click', (e) => {
    if (hasUnsavedChanges) {
      e.preventDefault();
      pendingNavigation = e.target.closest('a').href;
      unsavedModal.classList.remove('hidden');
    }
  });
  
  document.getElementById('unsaved-stay')?.addEventListener('click', () => {
    pendingNavigation = null;
    unsavedModal.classList.add('hidden');
  });
  
  document.getElementById('unsaved-leave')?.addEventListener('click', () => {
    hasUnsavedChanges = false;
    if (pendingNavigation) {
      window.location.href = pendingNavigation;
    }
  });
  
  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      saveBtn?.click();
    }
  });
</script>
