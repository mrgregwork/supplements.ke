---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { getAdminSessionToken, verifyAdminSession, getAllSubcategories, getAllCategories } from "@lib/admin";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const adminEmail = sessionData?.admin?.email || "Dev Mode";
const allSubcategories = await getAllSubcategories();
const allCategories = await getAllCategories();

const subcategoriesWithCategory = allSubcategories.map(sub => ({
  ...sub,
  categoryName: allCategories.find(c => c.id === sub.categoryId)?.name || 'Unknown',
}));
---

<BaseLayout 
  title="Subcategories - Admin" 
  description="Manage product subcategories"
>
  <div class="min-h-screen flex flex-col md:flex-row">
    <AdminSidebar adminEmail={adminEmail} currentPage="subcategories" />
    
    <main class="flex-1 p-4 md:p-6 lg:p-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">Subcategories</h2>
        <button 
          id="add-subcategory-btn"
          class="px-4 py-3 min-h-[48px] bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition flex items-center gap-2"
          data-testid="button-add-subcategory"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span class="hidden sm:inline">Add Subcategory</span>
        </button>
      </div>
      
      <div class="bg-card border rounded-lg overflow-hidden">
        {subcategoriesWithCategory.length === 0 ? (
          <div class="p-8 text-center text-muted-foreground">
            No subcategories yet. Click "Add Subcategory" to create your first subcategory.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full min-w-[600px]">
              <thead>
                <tr class="border-b bg-muted/50">
                  <th class="text-left py-4 px-4 lg:px-6 font-medium">Name</th>
                  <th class="text-left py-4 px-4 lg:px-6 font-medium hidden sm:table-cell">Slug</th>
                  <th class="text-left py-4 px-4 lg:px-6 font-medium">Category</th>
                  <th class="text-left py-4 px-4 lg:px-6 font-medium hidden lg:table-cell">Status</th>
                  <th class="text-right py-4 px-4 lg:px-6 font-medium w-32">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {subcategoriesWithCategory.map((sub) => (
                  <tr class="hover:bg-muted/30 transition" data-id={sub.id}>
                    <td class="py-4 px-4 lg:px-6">
                      <div class="flex items-center gap-3">
                        {sub.heroImage && (
                          <img 
                            src={sub.heroImage} 
                            alt={sub.name}
                            class="w-10 h-10 object-cover rounded border flex-shrink-0"
                          />
                        )}
                        <div>
                          <div class="font-medium">{sub.name}</div>
                          <div class="text-sm text-muted-foreground sm:hidden">{sub.slug}</div>
                        </div>
                      </div>
                    </td>
                    <td class="py-4 px-4 lg:px-6 text-sm text-muted-foreground hidden sm:table-cell">{sub.slug}</td>
                    <td class="py-4 px-4 lg:px-6 text-sm">{sub.categoryName}</td>
                    <td class="py-4 px-4 lg:px-6 hidden lg:table-cell">
                      <span class={`inline-block px-2 py-1 text-xs rounded-full ${
                        sub.isActive 
                          ? "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400"
                          : "bg-gray-100 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400"
                      }`}>
                        {sub.isActive ? "Active" : "Inactive"}
                      </span>
                    </td>
                    <td class="py-4 px-4 lg:px-6 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <button 
                          class="px-3 py-2 min-h-[40px] text-sm text-primary hover:bg-primary/10 rounded-md transition edit-btn"
                          data-id={sub.id}
                          data-testid={`button-edit-${sub.id}`}
                        >
                          Edit
                        </button>
                        <button 
                          class="px-3 py-2 min-h-[40px] text-sm text-red-500 hover:bg-red-500/10 rounded-md transition delete-btn"
                          data-id={sub.id}
                          data-testid={`button-delete-${sub.id}`}
                        >
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </main>
  </div>
  
  <!-- Modal Overlay -->
  <div id="modal-overlay" class="fixed inset-0 bg-black/50 z-40 hidden" data-testid="modal-overlay"></div>
  
  <!-- Slide-in Modal/Drawer for Form -->
  <div 
    id="form-modal" 
    class="fixed inset-y-0 right-0 w-full sm:w-[420px] lg:w-[480px] bg-background border-l shadow-xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
    data-testid="modal-form"
  >
    <div class="sticky top-0 bg-background border-b p-4 flex items-center justify-between">
      <h3 id="modal-title" class="text-lg font-semibold">Add Subcategory</h3>
      <button 
        id="close-modal-btn"
        class="p-2 min-h-[48px] min-w-[48px] hover:bg-muted rounded-lg transition flex items-center justify-center"
        data-testid="button-close-modal"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <form id="subcategory-form" class="p-4 sm:p-6 space-y-5">
      <input type="hidden" name="id" id="form-id" />
      
      <div>
        <label class="block text-sm font-medium mb-2">Parent Category *</label>
        <select 
          name="categoryId" 
          id="form-categoryId"
          required
          class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
          data-testid="select-categoryId"
        >
          <option value="">Select a category</option>
          {allCategories.map(cat => (
            <option value={cat.id}>{cat.name}</option>
          ))}
        </select>
      </div>
      
      <div>
        <label class="block text-sm font-medium mb-2">Name *</label>
        <input 
          type="text" 
          name="name" 
          id="form-name"
          required
          class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
          data-testid="input-name"
        />
      </div>
      
      <div>
        <label class="block text-sm font-medium mb-2">Slug *</label>
        <input 
          type="text" 
          name="slug" 
          id="form-slug"
          required
          class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
          data-testid="input-slug"
        />
      </div>
      
      <!-- Description (rich editor) -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-medium">Description</label>
          <div class="flex items-center gap-1 bg-muted rounded-lg p-1">
            <button type="button" id="sub-mode-visual" class="px-3 py-1 text-xs rounded-md bg-background shadow-sm font-medium">Visual</button>
            <button type="button" id="sub-mode-code" class="px-3 py-1 text-xs rounded-md text-muted-foreground hover:text-foreground transition">HTML</button>
          </div>
        </div>
        <div id="sub-desc-toolbar" class="border border-b-0 rounded-t-lg bg-muted/30 p-1.5 flex flex-wrap gap-1">
          <button type="button" data-sub-cmd="bold" class="sub-tb-btn px-2 py-1 hover:bg-muted rounded font-bold text-sm">B</button>
          <button type="button" data-sub-cmd="italic" class="sub-tb-btn px-2 py-1 hover:bg-muted rounded italic text-sm">I</button>
          <div class="w-px bg-border mx-1 h-5 self-center"></div>
          <select data-sub-cmd="formatBlock" class="sub-tb-sel px-2 py-1 text-xs bg-background border rounded">
            <option value="p">Paragraph</option>
            <option value="h2">H2</option>
            <option value="h3">H3</option>
          </select>
          <div class="w-px bg-border mx-1 h-5 self-center"></div>
          <button type="button" data-sub-cmd="insertUnorderedList" class="sub-tb-btn px-2 py-1 hover:bg-muted rounded text-sm" title="Bullets">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>
        <div id="sub-desc-visual" contenteditable="true"
          class="min-h-[120px] border rounded-b-lg p-3 bg-background focus:outline-none focus:ring-2 focus:ring-primary prose prose-sm max-w-none dark:prose-invert text-sm"
        ></div>
        <textarea id="sub-desc-code"
          class="hidden w-full min-h-[120px] border rounded-lg p-3 bg-background font-mono text-xs focus:outline-none focus:ring-2 focus:ring-primary"
        ></textarea>
      </div>

      <!-- Rich Content (longDescription) -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-medium">Rich Content <span class="text-xs font-normal text-muted-foreground">(SEO text at page bottom)</span></label>
          <div class="flex items-center gap-1 bg-muted rounded-lg p-1">
            <button type="button" id="sub-ld-mode-visual" class="px-3 py-1 text-xs rounded-md bg-background shadow-sm font-medium">Visual</button>
            <button type="button" id="sub-ld-mode-code" class="px-3 py-1 text-xs rounded-md text-muted-foreground hover:text-foreground transition">HTML</button>
          </div>
        </div>
        <div id="sub-ld-toolbar" class="border border-b-0 rounded-t-lg bg-muted/30 p-1.5 flex flex-wrap gap-1">
          <button type="button" data-sub-ld-cmd="bold" class="sub-ld-btn px-2 py-1 hover:bg-muted rounded font-bold text-sm">B</button>
          <button type="button" data-sub-ld-cmd="italic" class="sub-ld-btn px-2 py-1 hover:bg-muted rounded italic text-sm">I</button>
          <div class="w-px bg-border mx-1 h-5 self-center"></div>
          <select data-sub-ld-cmd="formatBlock" class="sub-ld-sel px-2 py-1 text-xs bg-background border rounded">
            <option value="p">Paragraph</option>
            <option value="h2">H2</option>
            <option value="h3">H3</option>
          </select>
          <div class="w-px bg-border mx-1 h-5 self-center"></div>
          <button type="button" data-sub-ld-cmd="insertUnorderedList" class="sub-ld-btn px-2 py-1 hover:bg-muted rounded text-sm" title="Bullets">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>
        <div id="sub-ld-visual" contenteditable="true"
          class="min-h-[150px] border rounded-b-lg p-3 bg-background focus:outline-none focus:ring-2 focus:ring-primary prose prose-sm max-w-none dark:prose-invert text-sm"
        ></div>
        <textarea id="sub-ld-code"
          class="hidden w-full min-h-[150px] border rounded-lg p-3 bg-background font-mono text-xs focus:outline-none focus:ring-2 focus:ring-primary"
          placeholder="Enter HTML..."
        ></textarea>
        <p class="text-xs text-muted-foreground mt-1">Expandable section at the bottom of the subcategory page. Add keyword-rich content here for SEO.</p>
      </div>
      
      <div>
        <label class="block text-sm font-medium mb-2">Hero Image URL</label>
        <input 
          type="text" 
          name="heroImage" 
          id="form-heroImage"
          class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
          data-testid="input-heroImage"
        />
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-2">Sort Order</label>
          <input 
            type="number" 
            name="sortOrder" 
            id="form-sortOrder"
            value="0"
            class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
            data-testid="input-sortOrder"
          />
        </div>
        <div class="flex items-center pt-8">
          <input 
            type="checkbox" 
            name="isActive" 
            id="form-isActive"
            checked
            class="w-5 h-5 mr-2"
            data-testid="input-isActive"
          />
          <label for="form-isActive" class="text-sm">Active</label>
        </div>
      </div>
      
      <!-- SEO Section -->
      <div class="border rounded-lg overflow-hidden">
        <div class="flex items-center gap-2 p-3 bg-primary/5 border-b">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
          <span class="text-sm font-semibold">SEO — Page Title & Meta Description</span>
        </div>
        <div class="p-4 space-y-4">
          <div>
            <label class="block text-sm font-medium mb-2" for="form-seoTitle">
              Page Title
              <span class="text-xs font-normal text-muted-foreground ml-1">— shown in Google results</span>
            </label>
            <input
              type="text"
              name="seoTitle"
              id="form-seoTitle"
              class="w-full px-4 py-3 min-h-[48px] text-base border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none"
              placeholder="e.g. Women's Vitamins Kenya — Best Price"
              data-testid="input-seoTitle"
            />
            <p class="text-xs text-muted-foreground mt-1">Recommended: 70 characters or less</p>
          </div>
          <div>
            <label class="block text-sm font-medium mb-2" for="form-seoDescription">
              Meta Description
              <span class="text-xs font-normal text-muted-foreground ml-1">— shown under the title in Google</span>
            </label>
            <textarea
              name="seoDescription"
              id="form-seoDescription"
              rows="3"
              class="w-full px-4 py-3 border rounded-lg bg-background focus:ring-2 focus:ring-primary focus:outline-none resize-none text-sm"
              placeholder="e.g. Buy women's multivitamins in Kenya. OLLY, One A Day — best price on women's vitamins."
              data-testid="input-seoDescription"
            ></textarea>
            <p class="text-xs text-muted-foreground mt-1">Recommended: 160 characters or less</p>
          </div>
          <!-- Live Google preview -->
          <div class="bg-muted/30 rounded-lg p-3">
            <p class="text-xs text-muted-foreground mb-1 font-medium">Preview</p>
            <p id="sub-seo-preview-title" class="text-sm font-medium text-green-700 dark:text-green-400 truncate">Page Title</p>
            <p id="sub-seo-preview-url" class="text-xs text-green-600 dark:text-green-500 mt-0.5">/category/subcategory-slug/</p>
            <p id="sub-seo-preview-desc" class="text-xs text-muted-foreground mt-1 line-clamp-2">Meta description will appear here...</p>
          </div>
        </div>
      </div>
      
      <div class="flex gap-3 pt-4">
        <button 
          type="button" 
          id="cancel-btn"
          class="flex-1 px-4 py-3 min-h-[48px] border rounded-lg hover:bg-muted transition font-medium"
          data-testid="button-cancel"
        >
          Cancel
        </button>
        <button 
          type="submit"
          class="flex-1 px-4 py-3 min-h-[48px] bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition"
          data-testid="button-submit"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</BaseLayout>

<script>
  const formModal = document.getElementById('form-modal') as HTMLDivElement;
  const modalOverlay = document.getElementById('modal-overlay') as HTMLDivElement;
  const modalTitle = document.getElementById('modal-title') as HTMLHeadingElement;
  const form = document.getElementById('subcategory-form') as HTMLFormElement;
  const addBtn = document.getElementById('add-subcategory-btn') as HTMLButtonElement;
  const cancelBtn = document.getElementById('cancel-btn') as HTMLButtonElement;
  const closeModalBtn = document.getElementById('close-modal-btn') as HTMLButtonElement;
  
  function openModal(isEdit = false) {
    formModal.classList.remove('translate-x-full');
    modalOverlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    modalTitle.textContent = isEdit ? 'Edit Subcategory' : 'Add Subcategory';
    setTimeout(() => (document.getElementById('form-name') as HTMLInputElement).focus(), 100);
  }
  
  function closeModal() {
    formModal.classList.add('translate-x-full');
    modalOverlay.classList.add('hidden');
    document.body.style.overflow = '';
    form.reset();
    (document.getElementById('form-id') as HTMLInputElement).value = '';
    slugManuallyEdited = false;
  }
  
  function generateSlug(name: string): string {
    return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  }
  
  addBtn.addEventListener('click', () => openModal(false));
  cancelBtn.addEventListener('click', closeModal);
  closeModalBtn.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', closeModal);
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !formModal.classList.contains('translate-x-full')) {
      closeModal();
    }
  });
  
  const nameInput = document.getElementById('form-name') as HTMLInputElement;
  const slugInput = document.getElementById('form-slug') as HTMLInputElement;
  let slugManuallyEdited = false;
  
  nameInput.addEventListener('input', () => {
    if (!slugManuallyEdited && !(document.getElementById('form-id') as HTMLInputElement).value) {
      slugInput.value = generateSlug(nameInput.value);
    }
  });
  
  slugInput.addEventListener('input', () => {
    slugManuallyEdited = true;
  });
  
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = (e.target as HTMLButtonElement).dataset.id;
      try {
        const res = await fetch(`/api/admin/subcategories/${id}`);
        const sub = await res.json();
        
        (document.getElementById('form-id') as HTMLInputElement).value = sub.id;
        (document.getElementById('form-categoryId') as HTMLSelectElement).value = sub.categoryId;
        (document.getElementById('form-name') as HTMLInputElement).value = sub.name;
        (document.getElementById('form-slug') as HTMLInputElement).value = sub.slug;
        // Rich editors
        const subDescVis = document.getElementById('sub-desc-visual') as HTMLDivElement;
        const subDescCode = document.getElementById('sub-desc-code') as HTMLTextAreaElement;
        if (subDescVis) { subDescVis.innerHTML = sub.description || ''; if (subDescCode) subDescCode.value = sub.description || ''; }
        const subLdVis = document.getElementById('sub-ld-visual') as HTMLDivElement;
        const subLdCode = document.getElementById('sub-ld-code') as HTMLTextAreaElement;
        if (subLdVis) { subLdVis.innerHTML = sub.longDescription || ''; if (subLdCode) subLdCode.value = sub.longDescription || ''; }
        (document.getElementById('form-heroImage') as HTMLInputElement).value = sub.heroImage || '';
        (document.getElementById('form-sortOrder') as HTMLInputElement).value = sub.sortOrder;
        (document.getElementById('form-isActive') as HTMLInputElement).checked = sub.isActive;
        (document.getElementById('form-seoTitle') as HTMLInputElement).value = sub.seoTitle || '';
        (document.getElementById('form-seoDescription') as HTMLTextAreaElement).value = sub.seoDescription || '';

        slugManuallyEdited = true;
        updateSeoPreview();
        openModal(true);
      } catch (err) {
        console.error('Failed to load subcategory:', err);
        alert('Failed to load subcategory');
      }
    });
  });
  
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = (e.target as HTMLButtonElement).dataset.id;
      if (!confirm('Are you sure you want to delete this subcategory?')) return;
      
      try {
        const res = await fetch(`/api/admin/subcategories/${id}`, { method: 'DELETE' });
        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(data.error || 'Failed to delete subcategory');
        }
      } catch (err) {
        console.error('Delete failed:', err);
        alert('Failed to delete subcategory');
      }
    });
  });
  
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const id = (document.getElementById('form-id') as HTMLInputElement).value;
    const subDescVis = document.getElementById('sub-desc-visual') as HTMLDivElement;
    const subDescCode = document.getElementById('sub-desc-code') as HTMLTextAreaElement;
    const subLdVis = document.getElementById('sub-ld-visual') as HTMLDivElement;
    const subLdCode = document.getElementById('sub-ld-code') as HTMLTextAreaElement;
    const description = (subDescVis && !subDescCode?.classList.contains('hidden') === false)
      ? subDescVis.innerHTML
      : (subDescCode?.value || '');
    const longDescription = (subLdVis && !subLdCode?.classList.contains('hidden') === false)
      ? subLdVis.innerHTML
      : (subLdCode?.value || '');
    const data = {
      categoryId: (document.getElementById('form-categoryId') as HTMLSelectElement).value,
      name: (document.getElementById('form-name') as HTMLInputElement).value,
      slug: (document.getElementById('form-slug') as HTMLInputElement).value,
      description: description || null,
      longDescription: longDescription || null,
      heroImage: (document.getElementById('form-heroImage') as HTMLInputElement).value || null,
      sortOrder: parseInt((document.getElementById('form-sortOrder') as HTMLInputElement).value) || 0,
      isActive: (document.getElementById('form-isActive') as HTMLInputElement).checked,
      seoTitle: (document.getElementById('form-seoTitle') as HTMLInputElement).value || null,
      seoDescription: (document.getElementById('form-seoDescription') as HTMLTextAreaElement).value || null,
    };
    
    try {
      const url = id ? `/api/admin/subcategories/${id}` : '/api/admin/subcategories';
      const method = id ? 'PUT' : 'POST';
      
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      
      if (res.ok) {
        window.location.reload();
      } else {
        const result = await res.json();
        alert(result.error || 'Failed to save subcategory');
      }
    } catch (err) {
      console.error('Save failed:', err);
      alert('Failed to save subcategory');
    }
  });

  // ── Rich editor wiring for description + longDescription ──────────────────
  function wireEditor(
    modeVisualId: string, modeCodeId: string,
    toolbarId: string, visualId: string, codeId: string,
    btnSelector: string, selSelector: string
  ) {
    const modeVis = document.getElementById(modeVisualId) as HTMLButtonElement;
    const modeCod = document.getElementById(modeCodeId) as HTMLButtonElement;
    const toolbar  = document.getElementById(toolbarId) as HTMLDivElement;
    const visual   = document.getElementById(visualId) as HTMLDivElement;
    const code     = document.getElementById(codeId) as HTMLTextAreaElement;
    let isVisual = true;

    modeVis?.addEventListener('click', () => {
      if (isVisual) return; isVisual = true;
      visual.innerHTML = code.value;
      visual.classList.remove('hidden'); code.classList.add('hidden'); toolbar.classList.remove('hidden');
      modeVis.classList.add('bg-background','shadow-sm','font-medium'); modeVis.classList.remove('text-muted-foreground');
      modeCod.classList.remove('bg-background','shadow-sm','font-medium'); modeCod.classList.add('text-muted-foreground');
    });
    modeCod?.addEventListener('click', () => {
      if (!isVisual) return; isVisual = false;
      code.value = visual.innerHTML;
      visual.classList.add('hidden'); code.classList.remove('hidden'); toolbar.classList.add('hidden');
      modeCod.classList.add('bg-background','shadow-sm','font-medium'); modeCod.classList.remove('text-muted-foreground');
      modeVis.classList.remove('bg-background','shadow-sm','font-medium'); modeVis.classList.add('text-muted-foreground');
    });
    document.querySelectorAll(btnSelector).forEach(btn => {
      (btn as HTMLButtonElement).addEventListener('click', () => {
        document.execCommand((btn as HTMLButtonElement).dataset[btnSelector.includes('ld') ? 'subLdCmd' : 'subCmd']!, false, null);
        visual?.focus();
      });
    });
    document.querySelectorAll(selSelector).forEach(sel => {
      (sel as HTMLSelectElement).addEventListener('change', () => {
        document.execCommand((sel as HTMLSelectElement).dataset[selSelector.includes('ld') ? 'subLdCmd' : 'subCmd']!, false, (sel as HTMLSelectElement).value);
        visual?.focus();
      });
    });
  }

  wireEditor('sub-mode-visual','sub-mode-code','sub-desc-toolbar','sub-desc-visual','sub-desc-code','.sub-tb-btn[data-sub-cmd]','.sub-tb-sel[data-sub-cmd]');
  wireEditor('sub-ld-mode-visual','sub-ld-mode-code','sub-ld-toolbar','sub-ld-visual','sub-ld-code','.sub-ld-btn[data-sub-ld-cmd]','.sub-ld-sel[data-sub-ld-cmd]');

  // Live SEO preview for subcategory form
  const subSeoTitle = document.getElementById('form-seoTitle') as HTMLInputElement;
  const subSeoDesc  = document.getElementById('form-seoDescription') as HTMLTextAreaElement;
  const subSlug     = document.getElementById('form-slug') as HTMLInputElement;
  const subName     = document.getElementById('form-name') as HTMLInputElement;
  const previewTitle = document.getElementById('sub-seo-preview-title');
  const previewUrl   = document.getElementById('sub-seo-preview-url');
  const previewDesc  = document.getElementById('sub-seo-preview-desc');

  function updateSeoPreview() {
    if (previewTitle) previewTitle.textContent = subSeoTitle?.value || subName?.value || 'Page Title';
    if (previewDesc)  previewDesc.textContent  = subSeoDesc?.value  || 'Meta description will appear here...';
    if (previewUrl)   previewUrl.textContent   = '/' + (subSlug?.value || 'subcategory-slug') + '/';
  }

  subSeoTitle?.addEventListener('input', updateSeoPreview);
  subSeoDesc?.addEventListener('input',  updateSeoPreview);
  subSlug?.addEventListener('input',     updateSeoPreview);
  subName?.addEventListener('input',     updateSeoPreview);
</script>
