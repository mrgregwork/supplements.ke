---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { getAdminSessionToken, verifyAdminSession, getAllCategories, getAllSubcategories } from "@lib/admin";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const adminEmail = sessionData?.admin?.email || "Dev Mode";
const allCategories = await getAllCategories();
const allSubcategories = await getAllSubcategories();

// Build hierarchical list: categories with their subcategories
const categoryTree = allCategories.map(cat => ({
  ...cat,
  children: allSubcategories.filter(sub => sub.categoryId === cat.id)
}));
---

<BaseLayout 
  title="Categories - Admin" 
  description="Manage product categories"
>
  <div class="min-h-screen flex flex-col md:flex-row">
    <AdminSidebar adminEmail={adminEmail} currentPage="categories" />
    
    <main class="flex-1 p-4 md:p-6 lg:p-8">
      <!-- Header with title and add button -->
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">Categories</h2>
        <div class="flex gap-2">
          <a
            href="/admin/categories/import"
            class="px-4 py-3 min-h-[48px] border rounded-lg font-medium hover:bg-muted transition flex items-center gap-2"
            data-testid="link-import-categories"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            <span class="hidden sm:inline">Import CSV</span>
          </a>
          <a
            href="/admin/categories/edit"
            class="px-4 py-3 min-h-[48px] bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition flex items-center gap-2"
            data-testid="link-add-category"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span class="hidden sm:inline">Add Category</span>
          </a>
        </div>
      </div>
      
      <!-- Categories Table - Full width on desktop -->
      <div class="bg-card border rounded-lg overflow-hidden">
        {categoryTree.length === 0 ? (
          <div class="p-8 text-center text-muted-foreground">
            No categories yet. Click "Add Category" to create your first category.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full min-w-[500px]">
              <thead>
                <tr class="border-b bg-muted/50">
                  <th class="text-left py-4 px-4 lg:px-6 font-medium">Name</th>
                  <th class="text-left py-4 px-4 lg:px-6 font-medium hidden sm:table-cell">Slug</th>
                  <th class="text-left py-4 px-4 lg:px-6 font-medium hidden lg:table-cell">Description</th>
                  <th class="text-right py-4 px-4 lg:px-6 font-medium w-32">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {categoryTree.map((category) => (
                  <>
                    <tr class="hover:bg-muted/30 transition" data-id={category.id} data-type="category">
                      <td class="py-4 px-4 lg:px-6">
                        <div class="flex items-center gap-2">
                          <div class="font-medium">{category.name}</div>
                          {!category.isActive && (
                            <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">Draft</span>
                          )}
                        </div>
                        <div class="text-sm text-muted-foreground sm:hidden">{category.slug}</div>
                      </td>
                      <td class="py-4 px-4 lg:px-6 text-sm text-muted-foreground hidden sm:table-cell">{category.slug}</td>
                      <td class="py-4 px-4 lg:px-6 text-sm text-muted-foreground hidden lg:table-cell max-w-xs truncate">{category.description || '—'}</td>
                      <td class="py-4 px-4 lg:px-6 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <a 
                            href={`/admin/categories/edit?id=${category.id}&type=category`}
                            class="px-3 py-2 min-h-[40px] text-sm text-primary hover:bg-primary/10 rounded-md transition"
                            data-testid={`link-edit-category-${category.id}`}
                          >
                            Edit
                          </a>
                          <button 
                            class="px-3 py-2 min-h-[40px] text-sm text-red-500 hover:bg-red-500/10 rounded-md transition delete-btn"
                            data-id={category.id}
                            data-type="category"
                            data-testid={`button-delete-category-${category.id}`}
                          >
                            Delete
                          </button>
                        </div>
                      </td>
                    </tr>
                    {category.children.map((sub) => (
                      <tr class="hover:bg-muted/30 transition bg-muted/10" data-id={sub.id} data-type="subcategory">
                        <td class="py-4 px-4 lg:px-6 pl-8 lg:pl-12">
                          <div class="flex items-center gap-2 text-muted-foreground">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                            <span>{sub.name}</span>
                            {!sub.isActive && (
                              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">Draft</span>
                            )}
                          </div>
                          <div class="text-sm text-muted-foreground sm:hidden ml-6">{sub.slug}</div>
                        </td>
                        <td class="py-4 px-4 lg:px-6 text-sm text-muted-foreground hidden sm:table-cell">{sub.slug}</td>
                        <td class="py-4 px-4 lg:px-6 text-sm text-muted-foreground hidden lg:table-cell max-w-xs truncate">{sub.description || '—'}</td>
                        <td class="py-4 px-4 lg:px-6 text-right">
                          <div class="flex items-center justify-end gap-2">
                            <a 
                              href={`/admin/categories/edit?id=${sub.id}&type=subcategory`}
                              class="px-3 py-2 min-h-[40px] text-sm text-primary hover:bg-primary/10 rounded-md transition"
                              data-testid={`link-edit-subcategory-${sub.id}`}
                            >
                              Edit
                            </a>
                            <button 
                              class="px-3 py-2 min-h-[40px] text-sm text-red-500 hover:bg-red-500/10 rounded-md transition delete-btn"
                              data-id={sub.id}
                              data-type="subcategory"
                              data-testid={`button-delete-subcategory-${sub.id}`}
                            >
                              Delete
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </main>
  </div>
  
  <!-- Delete Confirmation Modal -->
  <div id="delete-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-background rounded-lg shadow-xl w-full max-w-sm p-6">
      <h3 class="text-lg font-semibold mb-2">Delete Category</h3>
      <p id="delete-message" class="text-muted-foreground mb-4">Are you sure you want to delete this category?</p>
      <div class="flex justify-end gap-2">
        <button 
          type="button" 
          id="delete-cancel" 
          class="px-4 py-2 min-h-[48px] border rounded-lg hover:bg-muted transition"
          data-testid="button-delete-cancel"
        >
          Cancel
        </button>
        <button 
          type="button" 
          id="delete-confirm" 
          class="px-4 py-2 min-h-[48px] bg-red-500 text-white rounded-lg hover:opacity-90 transition"
          data-testid="button-delete-confirm"
        >
          Delete
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Delete functionality only - editing is now on a separate page
  const deleteModal = document.getElementById('delete-modal');
  const deleteMessage = document.getElementById('delete-message');
  const deleteCancel = document.getElementById('delete-cancel');
  const deleteConfirm = document.getElementById('delete-confirm');
  
  let pendingDeleteId = null;
  let pendingDeleteType = null;
  
  // Show delete modal
  function showDeleteModal(id, type) {
    pendingDeleteId = id;
    pendingDeleteType = type;
    const typeLabel = type === 'subcategory' ? 'subcategory' : 'category';
    deleteMessage.textContent = `Are you sure you want to delete this ${typeLabel}? This action cannot be undone.`;
    deleteModal.classList.remove('hidden');
  }
  
  // Hide delete modal
  function hideDeleteModal() {
    pendingDeleteId = null;
    pendingDeleteType = null;
    deleteModal.classList.add('hidden');
  }
  
  // Cancel delete
  deleteCancel?.addEventListener('click', hideDeleteModal);
  
  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !deleteModal.classList.contains('hidden')) {
      hideDeleteModal();
    }
  });
  
  // Close on overlay click
  deleteModal?.addEventListener('click', (e) => {
    if (e.target === deleteModal) {
      hideDeleteModal();
    }
  });
  
  // Confirm delete
  deleteConfirm?.addEventListener('click', async () => {
    if (!pendingDeleteId || !pendingDeleteType) return;
    
    deleteConfirm.disabled = true;
    deleteConfirm.textContent = 'Deleting...';
    
    try {
      const endpoint = pendingDeleteType === 'category' 
        ? `/api/admin/categories/${pendingDeleteId}` 
        : `/api/admin/subcategories/${pendingDeleteId}`;
        
      const res = await fetch(endpoint, { method: 'DELETE' });
      
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Failed to delete');
        hideDeleteModal();
      }
    } catch (err) {
      console.error('Delete failed:', err);
      alert('Failed to delete. Please try again.');
      hideDeleteModal();
    } finally {
      deleteConfirm.disabled = false;
      deleteConfirm.textContent = 'Delete';
    }
  });
  
  // Attach delete handlers to all delete buttons
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const id = target.dataset.id;
      const type = target.dataset.type;
      showDeleteModal(id, type);
    });
  });
</script>
