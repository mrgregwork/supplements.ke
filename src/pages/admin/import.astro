---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { getAdminSessionToken, verifyAdminSession } from "@lib/admin";
import { storage } from "@lib/storage";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const adminEmail = sessionData?.admin?.email || "Dev Mode";

const allSettings = await storage.getSiteSettings();
const settingsMap: Record<string, string> = {};
for (const s of allSettings) {
  settingsMap[s.key] = s.value || '';
}

const licenseKey = settingsMap.licenseKey || '';
const licenseStatus = settingsMap.licenseStatus || 'inactive';
const hasValidLicense = licenseStatus === 'active' && licenseKey.length > 0;

const categories = await storage.getCategories();
const subcategories = await storage.getSubcategories();
---

<BaseLayout 
  title="Import Products - Admin" 
  description="Import products from external sources"
>
  <div class="min-h-screen md:flex">
    <AdminSidebar adminEmail={adminEmail} currentPage="import" />
    
    <main class="flex-1 px-4 py-6 md:p-8 w-full overflow-x-hidden">
      <h2 class="text-2xl font-bold mb-6">Import Products</h2>
      
      {!hasValidLicense ? (
        <div class="bg-card border rounded-lg p-8 text-center max-w-2xl">
          <svg class="w-16 h-16 mx-auto text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <h3 class="text-xl font-semibold mb-2">License Required</h3>
          <p class="text-muted-foreground mb-4">
            You need an active license to use the product import feature. 
            Please enter and verify your license key in Settings.
          </p>
          <a 
            href="/admin/settings" 
            class="inline-flex items-center gap-2 px-4 py-3 min-h-[48px] bg-primary text-primary-foreground rounded-md hover:opacity-90 transition"
            data-testid="link-go-to-settings"
          >
            Go to Settings
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      ) : (
        <div class="space-y-6">
          <!-- Search Section -->
          <div class="bg-card border rounded-lg p-4 md:p-6">
            <h3 class="text-lg font-semibold mb-4">Search Amazon Products</h3>
            <p class="text-sm text-muted-foreground mb-4">
              Search for products to import. Results will only show Amazon Prime eligible products for faster shipping.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-3 mb-6">
              <div class="flex-1">
                <input 
                  type="text" 
                  id="search-query"
                  placeholder="e.g., HP Envy, gaming laptops, headphones..."
                  class="w-full px-4 py-3 min-h-[48px] border rounded-md bg-background text-base"
                  data-testid="input-search-query"
                />
              </div>
              <button 
                type="button"
                id="search-btn"
                class="px-6 py-3 bg-primary text-primary-foreground rounded-md hover:opacity-90 transition flex items-center justify-center gap-2 min-h-[48px]"
                data-testid="button-search"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Search
              </button>
            </div>
            
            <div id="search-status" class="text-sm text-muted-foreground mb-4 hidden"></div>
            
            <!-- Filters Panel (collapsible) -->
            <div id="filters-panel" class="mb-6 hidden">
              <button 
                type="button"
                id="toggle-filters"
                class="flex items-center gap-2 text-sm font-medium text-primary hover:underline mb-3 min-h-[48px]"
                data-testid="button-toggle-filters"
              >
                <svg id="filters-chevron" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
                Filter Results
                <span id="active-filters-count" class="px-2 py-0.5 bg-primary/10 text-primary rounded-full text-xs hidden">0</span>
              </button>
              
              <div id="filters-content" class="hidden border rounded-lg p-4 bg-muted/30">
                <div id="dynamic-filters" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                  <!-- Dynamic filters will be inserted here -->
                </div>
                <div class="mt-4 flex gap-2">
                  <button 
                    type="button"
                    id="apply-filters-btn"
                    class="px-4 py-2 min-h-[48px] bg-primary text-primary-foreground rounded-md hover:opacity-90 transition text-sm"
                    data-testid="button-apply-filters"
                  >
                    Apply Filters
                  </button>
                  <button 
                    type="button"
                    id="clear-filters-btn"
                    class="px-4 py-2 min-h-[48px] border rounded-md hover:bg-muted transition text-sm"
                    data-testid="button-clear-filters"
                  >
                    Clear All
                  </button>
                </div>
              </div>
            </div>
            
            <!-- Selected Products Bar -->
            <div id="selection-bar" class="hidden sticky top-0 z-10 bg-primary text-primary-foreground rounded-lg p-3 mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <span id="selection-count" class="font-medium">0 products selected</span>
              <div class="flex gap-2">
                <button 
                  type="button"
                  id="import-selected-btn"
                  class="px-4 py-2 min-h-[48px] bg-white text-primary rounded-md hover:bg-white/90 transition text-sm font-medium"
                  data-testid="button-import-selected"
                >
                  Import Selected
                </button>
                <button 
                  type="button"
                  id="clear-selection-btn"
                  class="px-4 py-2 min-h-[48px] border border-white/30 rounded-md hover:bg-white/10 transition text-sm"
                  data-testid="button-clear-selection"
                >
                  Clear
                </button>
              </div>
            </div>
            
            <!-- Search Results -->
            <div id="search-results" class="space-y-3">
              <p class="text-muted-foreground text-center py-8">
                Enter a search term above to find products to import.
              </p>
            </div>
          </div>
          
          <!-- Bulk Import Panel -->
          <div id="bulk-import-panel" class="bg-card border rounded-lg p-4 md:p-6 hidden">
            <h3 class="text-lg font-semibold mb-4">Import Selected Products</h3>
            <p class="text-sm text-muted-foreground mb-4">
              Assign selected products to a category. Subcategory is optional.
            </p>
            
            <div id="selected-products-preview" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-6 max-h-48 overflow-y-auto">
              <!-- Selected product previews will be inserted here -->
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div>
                <label for="bulk-category" class="block text-sm font-medium mb-1">Category</label>
                <select 
                  id="bulk-category" 
                  class="w-full px-3 py-3 min-h-[48px] border rounded-md bg-background text-base"
                  data-testid="select-bulk-category"
                >
                  <option value="">Select a category</option>
                  {categories.map(cat => (
                    <option value={cat.id}>{cat.name}</option>
                  ))}
                </select>
              </div>
              
              <div>
                <label for="bulk-subcategory" class="block text-sm font-medium mb-1">Subcategory <span class="text-muted-foreground font-normal">(optional)</span></label>
                <select 
                  id="bulk-subcategory" 
                  class="w-full px-3 py-3 min-h-[48px] border rounded-md bg-background text-base"
                  data-testid="select-bulk-subcategory"
                >
                  <option value="">None (category only)</option>
                </select>
              </div>
            </div>
            
            <div id="import-progress" class="hidden mb-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium">Importing products...</span>
                <span id="import-progress-text" class="text-sm text-muted-foreground">0 / 0</span>
              </div>
              <div class="w-full bg-muted rounded-full h-2">
                <div id="import-progress-bar" class="bg-primary h-2 rounded-full transition-all" style="width: 0%"></div>
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-3">
              <button 
                type="button"
                id="confirm-import-btn"
                class="flex-1 px-4 py-3 min-h-[48px] bg-primary text-primary-foreground rounded-md hover:opacity-90 transition font-medium"
                data-testid="button-confirm-import"
              >
                Import All Selected Products
              </button>
              <button 
                type="button"
                id="cancel-bulk-import-btn"
                class="px-4 py-3 min-h-[48px] border rounded-md hover:bg-muted transition"
                data-testid="button-cancel-bulk-import"
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      )}
    </main>
  </div>
</BaseLayout>

<script define:vars={{ subcategories: JSON.stringify(subcategories) }}>
  const parsedSubcategories = JSON.parse(subcategories);
  
  // DOM Elements
  const searchInput = document.getElementById('search-query');
  const searchBtn = document.getElementById('search-btn');
  const searchStatus = document.getElementById('search-status');
  const searchResults = document.getElementById('search-results');
  const filtersPanel = document.getElementById('filters-panel');
  const toggleFiltersBtn = document.getElementById('toggle-filters');
  const filtersContent = document.getElementById('filters-content');
  const filtersChevron = document.getElementById('filters-chevron');
  const dynamicFilters = document.getElementById('dynamic-filters');
  const applyFiltersBtn = document.getElementById('apply-filters-btn');
  const clearFiltersBtn = document.getElementById('clear-filters-btn');
  const activeFiltersCount = document.getElementById('active-filters-count');
  const selectionBar = document.getElementById('selection-bar');
  const selectionCount = document.getElementById('selection-count');
  const importSelectedBtn = document.getElementById('import-selected-btn');
  const clearSelectionBtn = document.getElementById('clear-selection-btn');
  const bulkImportPanel = document.getElementById('bulk-import-panel');
  const selectedProductsPreview = document.getElementById('selected-products-preview');
  const bulkCategorySelect = document.getElementById('bulk-category');
  const bulkSubcategorySelect = document.getElementById('bulk-subcategory');
  const confirmImportBtn = document.getElementById('confirm-import-btn');
  const cancelBulkImportBtn = document.getElementById('cancel-bulk-import-btn');
  const importProgress = document.getElementById('import-progress');
  const importProgressBar = document.getElementById('import-progress-bar');
  const importProgressText = document.getElementById('import-progress-text');
  
  // State
  let allProducts = [];
  let selectedProducts = new Map();
  let currentFacets = {};
  let activeFilters = {};
  let filtersExpanded = false;
  
  // Filter label mapping (fallback for simple string arrays)
  const filterLabels = {
    brand: 'Brand',
    processor: 'Processor',
    ram: 'RAM',
    storage: 'Storage',
    screenSize: 'Screen Size',
    color: 'Color',
    scent: 'Scent',
    size: 'Size',
    form: 'Form',
    price: 'Price Range',
  };
  
  // Update subcategories when category changes
  bulkCategorySelect?.addEventListener('change', () => {
    const categoryId = bulkCategorySelect.value;
    const filtered = parsedSubcategories.filter(s => s.categoryId === categoryId);
    
    bulkSubcategorySelect.innerHTML = '<option value="">None (category only)</option>';
    filtered.forEach(sub => {
      const option = document.createElement('option');
      option.value = String(sub.id);
      option.textContent = sub.name;
      bulkSubcategorySelect.appendChild(option);
    });
  });
  
  // Toggle filters panel
  toggleFiltersBtn?.addEventListener('click', () => {
    filtersExpanded = !filtersExpanded;
    filtersContent?.classList.toggle('hidden', !filtersExpanded);
    filtersChevron?.classList.toggle('rotate-180', filtersExpanded);
  });
  
  // Search functionality
  searchBtn?.addEventListener('click', performSearch);
  searchInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') performSearch();
  });
  
  async function performSearch() {
    const query = searchInput?.value?.trim();
    if (!query) {
      alert('Please enter a search term');
      return;
    }
    
    searchBtn.disabled = true;
    searchBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="4" class="opacity-25"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Searching...';
    
    if (searchStatus) {
      searchStatus.textContent = 'Searching Amazon products... This may take a few seconds.';
      searchStatus.classList.remove('hidden');
    }
    
    if (searchResults) {
      searchResults.innerHTML = '<p class="text-center py-8 text-muted-foreground">Loading products...</p>';
    }
    
    try {
      const response = await fetch('/api/admin/import/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, primeOnly: true, filters: activeFilters }),
      });
      
      const result = await response.json();
      
      if (!response.ok) {
        throw new Error(result.message || 'Search failed');
      }
      
      if (searchStatus) searchStatus.classList.add('hidden');
      
      allProducts = result.products || [];
      currentFacets = result.facets || {};
      
      // If we have products but few/no facets, use AI to generate smart filters
      if (allProducts.length > 0 && Object.keys(currentFacets).length < 3) {
        try {
          const aiResponse = await fetch('/api/admin/import/ai-filters', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ products: allProducts, query }),
          });
          const aiResult = await aiResponse.json();
          if (aiResult.success && aiResult.facets) {
            // Merge AI facets with existing facets (AI facets take priority)
            currentFacets = { ...currentFacets, ...aiResult.facets };
          }
        } catch (aiError) {
          console.log('AI filters not available, using standard filters');
        }
      }
      
      // Show filters panel if we have facets
      if (Object.keys(currentFacets).length > 0) {
        filtersPanel?.classList.remove('hidden');
        renderFilters();
      } else {
        filtersPanel?.classList.add('hidden');
      }
      
      if (allProducts.length > 0) {
        renderSearchResults(allProducts);
      } else {
        if (searchResults) {
          searchResults.innerHTML = `
            <p class="text-muted-foreground text-center py-8">
              No products found for "${query}". Try a different search term.
            </p>
          `;
        }
      }
    } catch (error) {
      console.error('Search error:', error);
      if (searchStatus) {
        searchStatus.textContent = error.message || 'Search failed. Please try again.';
        searchStatus.classList.remove('hidden');
      }
      if (searchResults) {
        searchResults.innerHTML = '';
      }
    } finally {
      searchBtn.disabled = false;
      searchBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg> Search';
    }
  }
  
  function renderFilters() {
    if (!dynamicFilters) return;
    
    // Filter out non-useful facets (like just brand when already searching by brand)
    const usefulFacets = Object.entries(currentFacets).filter(([key, facetData]) => {
      // Get values array - handle both old format (string[]) and new format ({name, values}[])
      let values = [];
      if (Array.isArray(facetData)) {
        values = facetData;
      } else if (facetData && typeof facetData === 'object' && 'values' in facetData) {
        values = facetData.values;
      }
      // Only show facets with more than one option
      return values.length > 1;
    });
    
    if (usefulFacets.length === 0) {
      filtersPanel?.classList.add('hidden');
      return;
    }
    
    dynamicFilters.innerHTML = usefulFacets.map(([key, facetData]) => {
      // Handle both old format (string[]) and new format ({name, values}[])
      let label;
      let values = [];
      
      if (Array.isArray(facetData)) {
        // Old format: just an array of strings
        label = filterLabels[key] || key.charAt(0).toUpperCase() + key.slice(1).replace(/([A-Z])/g, ' $1');
        values = facetData;
      } else if (facetData && typeof facetData === 'object') {
        // New format: {name, values, fromApi}
        label = facetData.name || filterLabels[key] || key;
        values = facetData.values || [];
      } else {
        return '';
      }
      
      const selectedValues = activeFilters[key] || [];
      
      return `
        <div class="space-y-2">
          <label class="block text-sm font-medium">${label}</label>
          <div class="space-y-1 max-h-40 overflow-y-auto">
            ${values.slice(0, 8).map(value => `
              <label class="flex items-center gap-2 cursor-pointer min-h-[40px] px-2 hover:bg-muted/50 rounded">
                <input 
                  type="checkbox" 
                  class="filter-checkbox w-5 h-5 rounded border-gray-300"
                  data-filter-key="${key}"
                  data-filter-value="${value}"
                  ${selectedValues.includes(value) ? 'checked' : ''}
                />
                <span class="text-sm">${value}</span>
              </label>
            `).join('')}
            ${values.length > 8 ? `<p class="text-xs text-muted-foreground px-2 py-1">+${values.length - 8} more</p>` : ''}
          </div>
        </div>
      `;
    }).join('');
  }
  
  // Apply filters
  applyFiltersBtn?.addEventListener('click', () => {
    activeFilters = {};
    document.querySelectorAll('.filter-checkbox:checked').forEach(checkbox => {
      const key = checkbox.dataset.filterKey;
      const value = checkbox.dataset.filterValue;
      if (!activeFilters[key]) activeFilters[key] = [];
      activeFilters[key].push(value);
    });
    
    // Update active filters count
    const count = Object.values(activeFilters).flat().length;
    if (activeFiltersCount) {
      activeFiltersCount.textContent = count;
      activeFiltersCount.classList.toggle('hidden', count === 0);
    }
    
    // Re-search with filters
    performSearch();
  });
  
  // Clear filters
  clearFiltersBtn?.addEventListener('click', () => {
    activeFilters = {};
    document.querySelectorAll('.filter-checkbox').forEach(cb => cb.checked = false);
    if (activeFiltersCount) {
      activeFiltersCount.textContent = '0';
      activeFiltersCount.classList.add('hidden');
    }
    performSearch();
  });
  
  function renderSearchResults(products) {
    if (!searchResults) return;
    
    searchResults.innerHTML = products.map((product, index) => {
      const isSelected = selectedProducts.has(product.id);
      const lc = product.landedCost;
      const attrs = product.attributes || {};
      
      // Build attributes display
      const attrDisplay = [];
      if (attrs.processor) attrDisplay.push(attrs.processor);
      if (attrs.ram) attrDisplay.push(attrs.ram);
      if (attrs.storage) attrDisplay.push(attrs.storage);
      if (attrs.screenSize) attrDisplay.push(attrs.screenSize);
      
      const landedCostHtml = lc ? `
        <div class="mt-1">
          <span class="text-xs text-muted-foreground">Landed:</span>
          <span class="text-sm font-semibold text-green-600 dark:text-green-400">${lc.formatted.landedCostLocal}</span>
        </div>
      ` : '';
      
      const primeHtml = attrs.isPrime ? `
        <span class="inline-flex items-center gap-1 text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
          Prime
        </span>
      ` : '';
      
      return `
        <div class="border rounded-lg p-3 md:p-4 hover:bg-muted/50 transition ${isSelected ? 'ring-2 ring-primary bg-primary/5' : ''}" data-product-id="${product.id}">
          <div class="flex gap-3 md:gap-4">
            <!-- Checkbox -->
            <label class="flex-shrink-0 flex items-start pt-1">
              <input 
                type="checkbox" 
                class="product-checkbox w-6 h-6 rounded border-gray-300 cursor-pointer"
                data-product-index="${index}"
                ${isSelected ? 'checked' : ''}
                data-testid="checkbox-product-${index}"
              />
            </label>
            
            <!-- Image -->
            <div class="w-16 h-16 md:w-20 md:h-20 bg-muted rounded-md flex-shrink-0 overflow-hidden">
              ${product.image ? `<img src="${product.image}" alt="${product.title}" class="w-full h-full object-cover" />` : ''}
            </div>
            
            <!-- Content -->
            <div class="flex-1 min-w-0">
              <h4 class="font-medium text-sm md:text-base line-clamp-2">${product.title}</h4>
              
              ${attrDisplay.length > 0 ? `
                <p class="text-xs text-muted-foreground mt-1">${attrDisplay.join(' • ')}</p>
              ` : ''}
              
              <div class="flex items-center gap-2 md:gap-3 mt-2 flex-wrap">
                <span class="font-semibold">${product.currency || '$'}${product.price || 'N/A'}</span>
                ${product.rating ? `<span class="text-xs text-muted-foreground">${product.rating}★ (${product.reviewCount || 0})</span>` : ''}
                ${primeHtml}
              </div>
              ${landedCostHtml}
            </div>
          </div>
        </div>
      `;
    }).join('');
    
    // Add event listeners for checkboxes
    document.querySelectorAll('.product-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const index = parseInt(e.target.dataset.productIndex);
        const product = allProducts[index];
        
        if (e.target.checked) {
          selectedProducts.set(product.id, product);
        } else {
          selectedProducts.delete(product.id);
        }
        
        updateSelectionUI();
      });
    });
  }
  
  function updateSelectionUI() {
    const count = selectedProducts.size;
    
    if (selectionBar) {
      selectionBar.classList.toggle('hidden', count === 0);
    }
    
    if (selectionCount) {
      selectionCount.textContent = `${count} product${count !== 1 ? 's' : ''} selected`;
    }
    
    // Update visual state of cards
    document.querySelectorAll('[data-product-id]').forEach(card => {
      const productId = card.dataset.productId;
      const isSelected = selectedProducts.has(productId);
      card.classList.toggle('ring-2', isSelected);
      card.classList.toggle('ring-primary', isSelected);
      card.classList.toggle('bg-primary/5', isSelected);
    });
  }
  
  // Clear selection
  clearSelectionBtn?.addEventListener('click', () => {
    selectedProducts.clear();
    document.querySelectorAll('.product-checkbox').forEach(cb => cb.checked = false);
    updateSelectionUI();
  });
  
  // Import selected - show bulk import panel
  importSelectedBtn?.addEventListener('click', () => {
    if (selectedProducts.size === 0) {
      alert('Please select at least one product');
      return;
    }
    
    // Render previews
    if (selectedProductsPreview) {
      selectedProductsPreview.innerHTML = Array.from(selectedProducts.values()).map(product => `
        <div class="border rounded-md p-2 text-center">
          <div class="w-full aspect-square bg-muted rounded overflow-hidden mb-1">
            ${product.image ? `<img src="${product.image}" alt="" class="w-full h-full object-cover" />` : ''}
          </div>
          <p class="text-xs truncate">${product.title.substring(0, 30)}...</p>
        </div>
      `).join('');
    }
    
    bulkImportPanel?.classList.remove('hidden');
    bulkImportPanel?.scrollIntoView({ behavior: 'smooth' });
  });
  
  // Cancel bulk import
  cancelBulkImportBtn?.addEventListener('click', () => {
    bulkImportPanel?.classList.add('hidden');
  });
  
  // Confirm bulk import
  confirmImportBtn?.addEventListener('click', async () => {
    const categoryId = bulkCategorySelect?.value;
    const subcategoryId = bulkSubcategorySelect?.value || null; // Subcategory is now optional
    
    if (!categoryId) {
      alert('Please select a category');
      return;
    }
    
    const products = Array.from(selectedProducts.values());
    const total = products.length;
    let imported = 0;
    let failed = 0;
    
    confirmImportBtn.disabled = true;
    cancelBulkImportBtn.disabled = true;
    importProgress?.classList.remove('hidden');
    
    for (const product of products) {
      try {
        const lc = product.landedCost;
        const priceToUse = lc ? lc.landedCostLocal : product.price;
        
        const importData = {
          title: product.title,
          description: product.description || '',
          price: priceToUse || 0,
          image: product.image || '',
          categoryId: categoryId,
          subcategoryId: subcategoryId,
          attributes: product.attributes || {},
          sourceData: product,
        };
        
        const response = await fetch('/api/admin/import/product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(importData),
        });
        
        if (response.ok) {
          imported++;
        } else {
          failed++;
        }
      } catch (error) {
        failed++;
      }
      
      // Update progress
      const progress = ((imported + failed) / total) * 100;
      if (importProgressBar) importProgressBar.style.width = `${progress}%`;
      if (importProgressText) importProgressText.textContent = `${imported + failed} / ${total}`;
    }
    
    importProgress?.classList.add('hidden');
    confirmImportBtn.disabled = false;
    cancelBulkImportBtn.disabled = false;
    
    if (failed > 0) {
      alert(`Import complete: ${imported} succeeded, ${failed} failed`);
    } else {
      alert(`Successfully imported ${imported} products!`);
    }
    
    // Clear selection and redirect
    selectedProducts.clear();
    updateSelectionUI();
    bulkImportPanel?.classList.add('hidden');
    
    window.location.href = '/admin/products';
  });
</script>
