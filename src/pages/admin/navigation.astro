---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminSidebar from "@components/AdminSidebar.astro";
import { getAdminSessionToken, verifyAdminSession } from "@lib/admin";
import { storage } from "@lib/storage";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

const isDev = import.meta.env.DEV;
if (!isDev && !sessionData) {
  return Astro.redirect("/admin/login");
}

const adminEmail = sessionData?.admin?.email || "Dev Mode";

const navItems = await storage.getNavigationItems();
const categories = await storage.getCategories();
---

<BaseLayout 
  title="Navigation Editor - Admin" 
  description="Edit navigation menu"
>
  <div class="min-h-screen flex flex-col md:flex-row">
    <AdminSidebar adminEmail={adminEmail} currentPage="navigation" />
    
    <main class="flex-1 p-4 md:p-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <h2 class="text-2xl font-bold">Navigation Menu</h2>
        <button 
          id="add-nav-item"
          class="px-4 py-3 min-h-[48px] bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition flex items-center gap-2"
          data-testid="button-add-nav-item"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add Menu Item
        </button>
      </div>
      
      <div id="message-container" class="hidden mb-4"></div>
      
      <div class="bg-card border rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-muted/50 border-b">
              <tr>
                <th class="text-left px-4 py-3 text-sm font-medium">Order</th>
                <th class="text-left px-4 py-3 text-sm font-medium">Label</th>
                <th class="text-left px-4 py-3 text-sm font-medium">Link</th>
                <th class="text-left px-4 py-3 text-sm font-medium">Status</th>
                <th class="text-right px-4 py-3 text-sm font-medium">Actions</th>
              </tr>
            </thead>
            <tbody id="nav-items-list" class="divide-y">
              {navItems.length === 0 ? (
                <tr>
                  <td colspan="5" class="px-4 py-8 text-center text-muted-foreground">
                    No menu items yet. Add your first navigation link above.
                  </td>
                </tr>
              ) : (
                navItems.map((item) => (
                  <tr class="hover:bg-muted/30" data-id={item.id}>
                    <td class="px-4 py-3">
                      <span class="text-sm text-muted-foreground">{item.sortOrder}</span>
                    </td>
                    <td class="px-4 py-3">
                      <span class="font-medium">{item.label}</span>
                      {item.parentId && (
                        <span class="ml-2 text-xs text-muted-foreground">(dropdown)</span>
                      )}
                    </td>
                    <td class="px-4 py-3">
                      <code class="text-sm bg-muted px-2 py-1 rounded">{item.href}</code>
                    </td>
                    <td class="px-4 py-3">
                      <span class={`text-xs px-2 py-1 rounded-full ${item.isActive ? 'bg-green-500/10 text-green-600' : 'bg-gray-500/10 text-gray-500'}`}>
                        {item.isActive ? 'Active' : 'Hidden'}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <button 
                          class="edit-nav-item p-2 hover:bg-muted rounded-md transition"
                          data-id={item.id}
                          data-label={item.label}
                          data-href={item.href}
                          data-sort={item.sortOrder}
                          data-active={item.isActive}
                          data-testid={`button-edit-nav-${item.id}`}
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                          </svg>
                        </button>
                        <button 
                          class="delete-nav-item p-2 hover:bg-red-500/10 text-red-500 rounded-md transition"
                          data-id={item.id}
                          data-testid={`button-delete-nav-${item.id}`}
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
      
      <div class="mt-8 bg-card border rounded-lg p-6">
        <h3 class="text-lg font-semibold mb-4">Quick Add From Categories</h3>
        <p class="text-sm text-muted-foreground mb-4">Click to add a category as a navigation item.</p>
        <div class="flex flex-wrap gap-2">
          {categories.map((cat) => (
            <button 
              class="quick-add-category px-3 py-2 text-sm border rounded-md hover:bg-muted transition"
              data-label={cat.name}
              data-href={`/${cat.slug}/`}
              data-testid={`button-quick-add-${cat.slug}`}
            >
              {cat.name}
            </button>
          ))}
        </div>
      </div>
    </main>
  </div>

  <div id="nav-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
    <div class="bg-card border rounded-lg p-6 w-full max-w-md">
      <h3 id="modal-title" class="text-lg font-semibold mb-4">Add Menu Item</h3>
      
      <div class="space-y-4">
        <input type="hidden" id="modal-id" />
        
        <div>
          <label for="modal-label" class="block text-sm font-medium mb-1">Label</label>
          <input 
            type="text" 
            id="modal-label"
            placeholder="Home"
            class="w-full px-3 py-3 min-h-[48px] text-base border rounded-md bg-background"
            data-testid="input-nav-label"
          />
        </div>
        
        <div>
          <label for="modal-href" class="block text-sm font-medium mb-1">Link</label>
          <input 
            type="text" 
            id="modal-href"
            placeholder="/"
            class="w-full px-3 py-3 min-h-[48px] text-base border rounded-md bg-background"
            data-testid="input-nav-href"
          />
        </div>
        
        <div>
          <label for="modal-sort" class="block text-sm font-medium mb-1">Sort Order</label>
          <input 
            type="number" 
            id="modal-sort"
            value="0"
            class="w-full px-3 py-3 min-h-[48px] text-base border rounded-md bg-background"
            data-testid="input-nav-sort"
          />
        </div>
        
        <div class="flex items-center gap-2">
          <input 
            type="checkbox" 
            id="modal-active"
            checked
            class="w-5 h-5"
            data-testid="checkbox-nav-active"
          />
          <label for="modal-active" class="text-sm font-medium">Active (visible in menu)</label>
        </div>
      </div>
      
      <div class="flex justify-end gap-2 mt-6">
        <button 
          id="modal-cancel"
          class="px-4 py-3 min-h-[48px] border rounded-md hover:bg-muted transition"
          data-testid="button-modal-cancel"
        >
          Cancel
        </button>
        <button 
          id="modal-save"
          class="px-4 py-3 min-h-[48px] bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition"
          data-testid="button-modal-save"
        >
          Save
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const modal = document.getElementById('nav-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalId = document.getElementById('modal-id');
  const modalLabel = document.getElementById('modal-label');
  const modalHref = document.getElementById('modal-href');
  const modalSort = document.getElementById('modal-sort');
  const modalActive = document.getElementById('modal-active');
  const messageContainer = document.getElementById('message-container');
  
  function showMessage(text, type) {
    if (!messageContainer) return;
    messageContainer.innerHTML = `
      <div class="p-4 rounded-lg ${type === 'error' ? 'bg-red-500/10 text-red-500 border border-red-500/20' : 'bg-green-500/10 text-green-600 border border-green-500/20'}">
        ${text}
      </div>
    `;
    messageContainer.classList.remove('hidden');
    setTimeout(() => messageContainer.classList.add('hidden'), 5000);
  }
  
  function openModal(isEdit, data) {
    if (modalTitle) modalTitle.textContent = isEdit ? 'Edit Menu Item' : 'Add Menu Item';
    if (modalId) modalId.value = data?.id || '';
    if (modalLabel) modalLabel.value = data?.label || '';
    if (modalHref) modalHref.value = data?.href || '';
    if (modalSort) modalSort.value = data?.sort || '0';
    if (modalActive) modalActive.checked = data?.active !== 'false';
    modal?.classList.remove('hidden');
  }
  
  function closeModal() {
    modal?.classList.add('hidden');
  }
  
  document.getElementById('add-nav-item')?.addEventListener('click', () => {
    openModal(false, {});
  });
  
  document.getElementById('modal-cancel')?.addEventListener('click', closeModal);
  
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  
  document.querySelectorAll('.edit-nav-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const data = {
        id: btn.dataset.id,
        label: btn.dataset.label,
        href: btn.dataset.href,
        sort: btn.dataset.sort,
        active: btn.dataset.active,
      };
      openModal(true, data);
    });
  });
  
  document.querySelectorAll('.quick-add-category').forEach(btn => {
    btn.addEventListener('click', () => {
      openModal(false, {
        label: btn.dataset.label,
        href: btn.dataset.href,
      });
    });
  });
  
  document.getElementById('modal-save')?.addEventListener('click', async () => {
    const id = modalId?.value;
    const label = modalLabel?.value?.trim();
    const href = modalHref?.value?.trim();
    const sortOrder = parseInt(modalSort?.value || '0', 10);
    const isActive = modalActive?.checked;
    
    if (!label || !href) {
      showMessage('Label and link are required', 'error');
      return;
    }
    
    try {
      const url = id ? `/api/admin/navigation/${id}` : '/api/admin/navigation';
      const method = id ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ label, href, sortOrder, isActive })
      });
      
      if (!response.ok) {
        const data = await response.json();
        throw new Error(data.message || 'Failed to save');
      }
      
      showMessage('Saved! Refreshing...', 'success');
      setTimeout(() => window.location.reload(), 500);
    } catch (error) {
      showMessage(error.message || 'Failed to save', 'error');
    }
  });
  
  document.querySelectorAll('.delete-nav-item').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      if (!confirm('Are you sure you want to delete this menu item?')) return;
      
      try {
        const response = await fetch(`/api/admin/navigation/${id}`, {
          method: 'DELETE'
        });
        
        if (!response.ok) {
          throw new Error('Failed to delete');
        }
        
        showMessage('Deleted! Refreshing...', 'success');
        setTimeout(() => window.location.reload(), 500);
      } catch (error) {
        showMessage(error.message || 'Failed to delete', 'error');
      }
    });
  });
</script>
