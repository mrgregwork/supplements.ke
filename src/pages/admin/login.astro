---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminLoginForm from "@components/AdminLoginForm";
import { getAdminSessionToken, verifyAdminSession } from "@lib/admin";

const sessionToken = getAdminSessionToken(Astro.request);
const sessionData = await verifyAdminSession(sessionToken);

if (sessionData) {
  return Astro.redirect("/admin");
}
---

<BaseLayout 
  title="Admin Login" 
  description="Login to the admin panel"
>
  <main class="min-h-screen flex items-center justify-center bg-muted/30">
    <div class="bg-card rounded-lg border p-8 w-full max-w-md">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold">Admin Login</h1>
        <p class="text-muted-foreground">Sign in to manage your store</p>
      </div>
      
      <AdminLoginForm client:load />
    </div>
  </main>
</BaseLayout>
