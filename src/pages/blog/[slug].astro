---
import BaseLayout from "@layouts/BaseLayout.astro";
import { storage } from "@lib/storage";
import { getAdminSessionToken, verifyAdminSession } from "@lib/admin";

const { slug } = Astro.params;
const post = await storage.getBlogPostBySlug(slug!);

// The admin editor's "Preview" link points here for drafts too, so a logged-in
// admin may view an unpublished post. Everyone else still gets redirected —
// this is the only gate keeping drafts off the public site.
const sessionData = post && post.status !== "published"
  ? await verifyAdminSession(getAdminSessionToken(Astro.request))
  : null;
const isAdminPreview = post?.status !== "published" && !!sessionData;

if (!post || (post.status !== "published" && !isAdminPreview)) {
  return Astro.redirect("/blog/");
}

function formatDate(d: Date | null | undefined) {
  if (!d) return "";
  return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}

const seoTitle = post.seoTitle || post.title;
const seoDescription = post.seoDescription || post.excerpt || `${post.title} — Supplements Kenya`;
const category = post.categoryId ? await storage.getBlogCategory(post.categoryId) : undefined;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={post.featuredImage || undefined}
  type="article"
  noindex={isAdminPreview}
>
  {isAdminPreview && (
    <div class="bg-amber-100 dark:bg-amber-950/60 border-b border-amber-300 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-sm text-center py-2 px-4">
      Draft preview — only visible to you, signed in as an admin. This post is not live.
    </div>
  )}
  <article class="max-w-3xl mx-auto px-4 py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm text-muted-foreground mb-6">
      <a href="/" class="hover:text-foreground transition">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog/" class="hover:text-foreground transition">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{post.title}</span>
    </nav>

    <header class="mb-8">
      <p class="text-sm text-muted-foreground mb-3 flex items-center gap-2">
        {category && (
          <>
            <a href={`/blog/category/${category.slug}/`} class="text-primary font-medium hover:underline">{category.name}</a>
            <span aria-hidden="true">&middot;</span>
          </>
        )}
        {formatDate(post.publishedAt || post.createdAt)}
      </p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">{post.title}</h1>
      {post.excerpt && (
        <p class="text-lg text-muted-foreground leading-relaxed">{post.excerpt}</p>
      )}
    </header>

    {post.featuredImage && (
      <img
        src={post.featuredImage}
        alt={post.title}
        class="w-full rounded-xl mb-8 object-cover max-h-96"
        loading="lazy"
      />
    )}

    {post.content && (
      <div
        class="prose prose-sm md:prose max-w-none dark:prose-invert"
        set:html={post.content}
      />
    )}

    <div class="mt-12 pt-8 border-t">
      <a href="/blog/" class="text-primary hover:underline inline-flex items-center gap-1">
        &larr; Back to all articles
      </a>
    </div>
  </article>
</BaseLayout>
