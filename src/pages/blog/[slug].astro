---
import BaseLayout from "@layouts/BaseLayout.astro";
import { storage } from "@lib/storage";

const { slug } = Astro.params;
const post = await storage.getBlogPostBySlug(slug!);

if (!post || post.status !== "published") {
  return Astro.redirect("/blog/");
}

function formatDate(d: Date | null | undefined) {
  if (!d) return "";
  return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}

const seoTitle = post.seoTitle || post.title;
const seoDescription = post.seoDescription || post.excerpt || `${post.title} — Supplements Kenya`;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={post.featuredImage || undefined}
  type="article"
>
  <article class="max-w-3xl mx-auto px-4 py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm text-muted-foreground mb-6">
      <a href="/" class="hover:text-foreground transition">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog/" class="hover:text-foreground transition">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{post.title}</span>
    </nav>

    <header class="mb-8">
      <p class="text-sm text-muted-foreground mb-3">
        {formatDate(post.publishedAt || post.createdAt)}
      </p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">{post.title}</h1>
      {post.excerpt && (
        <p class="text-lg text-muted-foreground leading-relaxed">{post.excerpt}</p>
      )}
    </header>

    {post.featuredImage && (
      <img
        src={post.featuredImage}
        alt={post.title}
        class="w-full rounded-xl mb-8 object-cover max-h-96"
        loading="lazy"
      />
    )}

    {post.content && (
      <div
        class="prose prose-sm md:prose max-w-none dark:prose-invert"
        set:html={post.content}
      />
    )}

    <div class="mt-12 pt-8 border-t">
      <a href="/blog/" class="text-primary hover:underline inline-flex items-center gap-1">
        &larr; Back to all articles
      </a>
    </div>
  </article>
</BaseLayout>
