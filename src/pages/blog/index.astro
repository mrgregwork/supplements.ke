---
import BaseLayout from "@layouts/BaseLayout.astro";
import { storage } from "@lib/storage";

const posts = await storage.getBlogPosts();
const publishedPosts = posts.filter(p => p.status === "published");

function formatDate(d: Date | null | undefined) {
  if (!d) return "";
  return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<BaseLayout
  title="Supplement Blog — Guides &amp; Advice | Supplements Kenya"
  description="Evidence-based supplement guides for Kenyans. Learn about vitamins, minerals, protein, and more from the team at Supplements Kenya."
>
  <div class="max-w-5xl mx-auto px-4 py-12 md:py-16">
    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">Supplement Guides &amp; Advice</h1>
      <p class="text-lg text-muted-foreground">Evidence-based articles on supplements, nutrition, and health in Kenya.</p>
    </div>

    {publishedPosts.length === 0 ? (
      <div class="text-center py-16 text-muted-foreground">
        <p class="text-xl mb-2">Coming soon</p>
        <p class="text-sm">We are working on expert supplement guides — check back shortly.</p>
      </div>
    ) : (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {publishedPosts.map(post => (
          <article class="border rounded-xl overflow-hidden hover:shadow-md transition bg-card flex flex-col">
            {post.featuredImage && (
              <a href={`/blog/${post.slug}/`} class="block">
                <img
                  src={post.featuredImage}
                  alt={post.title}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
              </a>
            )}
            <div class="p-5 flex flex-col flex-1">
              <p class="text-xs text-muted-foreground mb-2">{formatDate(post.publishedAt || post.createdAt)}</p>
              <h2 class="text-lg font-semibold mb-2 leading-snug">
                <a href={`/blog/${post.slug}/`} class="hover:text-primary transition">{post.title}</a>
              </h2>
              {post.excerpt && (
                <p class="text-sm text-muted-foreground mb-4 flex-1 line-clamp-3">{post.excerpt}</p>
              )}
              <a
                href={`/blog/${post.slug}/`}
                class="text-sm text-primary font-medium hover:underline mt-auto inline-flex items-center gap-1"
              >
                Read more &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
