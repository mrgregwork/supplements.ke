  <!-- ─────────── 5. FIND YOUR CLEAN SUPPLEMENTS ─────────── -->
  <section class="bg-muted/30 border-y">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="text-xs font-semibold tracking-wider uppercase text-primary mb-1">By supplement type</p>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Find your clean supplements</h2>
        <p class="text-sm sm:text-base text-muted-foreground mt-2">Shop by what your body actually needs, not by hype.</p>
      </div>

      <div class="space-y-12">
        {supplementTypes.map(group => (
          <div>
            <div class="flex items-baseline justify-between mb-4">
              <h3 class="text-xl sm:text-2xl font-bold">{group.name}</h3>
              <a href={`/${group.slug}/`} class="text-sm font-semibold text-primary hover:underline">Shop all {group.name.toLowerCase()} →</a>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
              {group.products.map(p => (
                <ProductCard product={{ ...p, images: p.images || [], attributes: p.attributes || [], subcategorySlug: p.subcategorySlug || '' }} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────── 6. SHOP BY GOAL (2x2) ─────────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <p class="text-xs font-semibold tracking-wider uppercase text-primary mb-1">Goal-based</p>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Shop by goal</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {goalTiles.map((t, i) => {
        const tints = [
          'from-emerald-700 to-emerald-900',
          'from-rose-700 to-rose-900',
          'from-blue-700 to-blue-900',
          'from-amber-700 to-amber-900',
        ];
        return (
          <a href={`/${t.cat!.slug}/`}
             class={`group relative overflow-hidden rounded-2xl bg-gradient-to-br ${tints[i % tints.length]} p-8 sm:p-10 min-h-[220px] sm:min-h-[280px] flex flex-col justify-end text-white hover:shadow-2xl transition-all`}
             style={t.cat!.heroImage ? `background-image: linear-gradient(to bottom right, rgba(0,0,0,0.55), rgba(0,0,0,0.75)), url('${t.cat!.heroImage}'); background-size: cover; background-position: center;` : ''}>
            <h3 class="text-2xl sm:text-3xl font-bold mb-2 leading-tight">{t.label}</h3>
            <p class="text-sm sm:text-base text-white/85 mb-4">{t.blurb}</p>
            <span class="inline-flex items-center text-sm font-semibold border-b border-white/40 pb-1 self-start group-hover:border-white transition-colors">
              Shop {t.label.toLowerCase()} →
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ─────────────── 7. AUTHORISED STOCKIST BRAND STRIP ─────────────── -->
  <section class="border-y bg-muted/40">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
      <p class="text-xs font-semibold tracking-wider uppercase text-muted-foreground text-center mb-6">
        Authorised Kenyan distributor for
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 sm:gap-x-12">
        {STOCKIST_BRANDS.map(brand => (
          <span class="text-base sm:text-lg font-bold text-foreground/70 tracking-tight whitespace-nowrap">
            {brand}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────── 9. STATS ROW ─────────────── -->
  <section class="bg-primary text-primary-foreground">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
      <div class="text-center mb-10">
        <p class="text-xs font-semibold tracking-wider uppercase opacity-80 mb-2">Why Kenyans choose us</p>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Your supplement order, done right</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-4 text-center">
        {[
          { v: '10,000+', l: 'Orders delivered across Kenya' },
          { v: '4.8★',    l: 'Average customer rating' },
          { v: '3 hrs',   l: 'Delivery in Nairobi' },
          { v: '30 days',  l: 'Money-back guarantee' },
        ].map(s => (
          <div>
            <div class="text-3xl sm:text-4xl font-bold mb-1">{s.v}</div>
            <div class="text-xs sm:text-sm opacity-85">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────── 10. BRAND STRIP ─────────────── -->
  {topBrands.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 border-b">
      <p class="text-xs font-semibold tracking-wider uppercase text-muted-foreground text-center mb-6">Trusted brands we stock</p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 sm:gap-x-12">
        {topBrands.map(b => (
          <a
            href={`/brand/${b.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-')}/`}
            class="text-base sm:text-lg font-bold text-foreground/70 hover:text-primary tracking-tight whitespace-nowrap transition-colors"
            data-testid={`link-brand-${b.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-')}`}
          >
            {b}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ─────────────── 11. EVERY INGREDIENT MATTERS CTA ─────────────── -->
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
      Every ingredient matters.
    </h2>
    <p class="text-base sm:text-lg text-muted-foreground mb-7 max-w-2xl mx-auto">
      No proprietary blends. No hidden fillers. Just honest, evidence-backed nutrition.
    </p>
    <a href="/all-supplements/"
       class="inline-flex items-center justify-center px-7 py-3.5 min-h-[48px] bg-primary text-primary-foreground font-semibold rounded-full hover:bg-primary/90 transition-colors">
      Shop bestsellers
    </a>
  </section>

  <!-- ─────────────── 12. SEO / EDUCATIONAL CONTENT ─────────────── -->
  <section class="bg-muted/30 border-y">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
      <div class="text-center mb-6">
        <p class="text-xs font-semibold tracking-wider uppercase text-primary mb-2">Start learning</p>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
          {seoContent.title || 'Your trusted supplement store in Kenya'}
        </h2>
      </div>
      <div class="prose prose-sm sm:prose-base dark:prose-invert max-w-none text-muted-foreground">
        {seoContent.content ? (
          <Fragment set:html={seoContent.content} />
        ) : (
          <>
            <p>
              Welcome to Supplements Kenya. We curate vitamins, proteins, collagen, omega-3s, probiotics, and
              wellness products from globally trusted brands, then verify authenticity before they reach you.
            </p>
            <p>
              Whether you're building a daily wellness routine or chasing a specific goal, our catalogue is
              organised by what you actually want to achieve, not by clever marketing buckets. Every product
              ships across Kenya with reliable, fast delivery.
            </p>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- ─────────────── 13. NEWSLETTER ─────────────── -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3">Get 10% off your first order</h2>
    <p class="text-sm sm:text-base text-muted-foreground mb-6">
      Join the newsletter for evidence-based supplement advice, restock alerts, and Kenya-only offers.
    </p>
    <form class="flex flex-col sm:flex-row gap-2 sm:gap-3 max-w-lg mx-auto" data-testid="form-newsletter">
      <input type="text" placeholder="Your name" required
             class="flex-1 px-4 py-3 min-h-[44px] border rounded-full bg-background focus:outline-none focus:ring-2 focus:ring-primary/30"
             data-testid="input-newsletter-name" />
      <input type="email" placeholder="you@example.com" required
             class="flex-1 px-4 py-3 min-h-[44px] border rounded-full bg-background focus:outline-none focus:ring-2 focus:ring-primary/30"
             data-testid="input-newsletter-email" />
      <button type="submit"
              class="inline-flex items-center justify-center px-6 py-3 min-h-[44px] bg-primary text-primary-foreground font-semibold rounded-full hover:bg-primary/90 transition-colors"
              data-testid="button-newsletter-submit">
        Sign up
      </button>
    </form>
    <p class="text-xs text-muted-foreground mt-3">No spam. Unsubscribe anytime.</p>
  </section>

</BaseLayout>
