---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductCard from '@components/ProductCard.astro';
import siteSettings from '@config/siteSettings.json';
import { generateHomePageSchema, generateItemListSchema } from '@lib/schema';
import { storage } from '@lib/storage';

const heroData = await storage.getHomepageSection('hero');
const seoData  = await storage.getHomepageSection('seo');
const hero       = (heroData?.content || {}) as Record<string, any>;
const seoContent = (seoData?.content  || {}) as Record<string, any>;

// Live data
const allCategories = await storage.getCategories();
const activeCategories = allCategories.filter(c => c.isActive);
const allProducts = await storage.getProducts();
const activeProducts = allProducts.filter(p => p.status === 'active');

// Bestsellers row: featured first, then newest. Cap 10 (carousel scrolls).
const featured = activeProducts.filter(p => p.featured);
const bestsellers = (featured.length >= 5 ? featured : [...featured, ...activeProducts.filter(p => !p.featured)]).slice(0, 10);

// "Find your supplements" — pick 5 supplement-type categories with most products
async function categoryWithProducts(slug: string, limit = 6) {
  const cat = activeCategories.find(c => c.slug === slug);
  if (!cat) return null;
  const products = await storage.getProductsByCategory(cat.id);
  if (!products.length) return null;
  return { ...cat, products: products.slice(0, limit) };
}
const supplementTypes = (await Promise.all([
  categoryWithProducts('protein'),
  categoryWithProducts('collagen'),
  categoryWithProducts('vitamins'),
  categoryWithProducts('minerals'),
  categoryWithProducts('omega-fatty-acids'),
])).filter(Boolean) as Array<NonNullable<Awaited<ReturnType<typeof categoryWithProducts>>>>;

// "Shop by Goal" — pick 4 goal-themed categories with hero imagery (or fall back)
const GOAL_TILES = [
  { slug: 'protein',         label: 'Build Lean Muscle',     blurb: 'Protein, creatine, and recovery formulas' },
  { slug: 'specialty-supplements', label: 'Improve Performance',   blurb: 'Pre-workout, energy, and endurance' },
  { slug: 'health-goals',    label: 'Support Health & Longevity', blurb: 'Daily essentials for whole-body wellness' },
  { slug: 'weight-management', label: 'Body Recomposition',    blurb: 'Fat-loss, lean-mass, and metabolism support' },
];
const goalTiles = GOAL_TILES.map(t => ({ ...t, cat: activeCategories.find(c => c.slug === t.slug) })).filter(t => t.cat);

// Brand strip — top brands by product count
const brandCounts = new Map<string, number>();
activeProducts.forEach(p => { if (p.brand) brandCounts.set(p.brand, (brandCounts.get(p.brand) || 0) + 1); });
const topBrands = Array.from(brandCounts.entries()).sort((a,b) => b[1]-a[1]).slice(0, 8).map(([name]) => name);

// Stats — derive from real data
const totalProducts    = activeProducts.length;
const totalCategories  = activeCategories.length;
const totalSubcategories = (await Promise.all(activeCategories.map(c => storage.getSubcategoriesByCategoryId(c.id)))).flat().filter(s => s.isActive).length;

// Schema
const baseUrl = siteSettings.siteUrl || 'https://supplementskenya.com';
const homePageSchema = generateHomePageSchema();
const featuredListSchema = bestsellers.length > 0
  ? generateItemListSchema(
      bestsellers.map(p => ({ ...p, images: p.images || [], attributes: p.attributes || [] })),
      'Bestsellers',
      baseUrl
    )
  : null;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [...homePageSchema["@graph"], ...(featuredListSchema ? [featuredListSchema] : [])]
};

// Authorised stockist brands — the brands Supplements Kenya is an authorised distributor for
const STOCKIST_BRANDS = [
  'Life Extension',
  'Jarrow Formulas',
  'Vital Proteins',
  'Sports Research',
  'NeoCell',
  'Optimum Nutrition',
  'Nature Made',
];
---

<BaseLayout
  title={siteSettings.seo.defaultTitle}
  description={siteSettings.seo.defaultDescription}
  structuredData={structuredData}
>

  <!-- ─────────────────────── 1. HERO ─────────────────────── -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-primary/15 via-background to-accent/10"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 md:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-8 lg:gap-10 items-center">

        <!-- ── Left 70%: Hero content ── -->
        <div class="text-center lg:text-left">

          <!-- ── Review social proof bar ── -->
          <div class="inline-flex items-center gap-3 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-700 rounded-2xl px-4 py-3 mb-5 shadow-sm w-full sm:w-auto">
            <!-- Avatar stack -->
            <div class="flex -space-x-2 shrink-0">
              {[
                { i: 'MK', c: 'bg-emerald-500' },
                { i: 'DO', c: 'bg-blue-500' },
                { i: 'AM', c: 'bg-rose-500' },
                { i: 'JN', c: 'bg-violet-500' },
              ].map(a => (
                <div class={`h-8 w-8 rounded-full ${a.c} text-white text-[10px] font-bold flex items-center justify-center ring-2 ring-amber-50 dark:ring-amber-950/40`}>
