              Order on WhatsApp
            </a>
          </div>
          <!-- Goal-finder pills -->
          <div class="mb-6">
            <p class="text-xs text-muted-foreground mb-3 font-medium">I want to…</p>
            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2">
              {[
                { label: 'Build muscle',  href: '/protein/' },
                { label: 'Sleep better',  href: '/health-goals/' },
                { label: 'Boost energy',  href: '/specialty-supplements/' },
                { label: 'Look younger',  href: '/collagen/' },
                { label: 'Stay healthy',  href: '/vitamins/' },
                { label: 'Lose weight',   href: '/weight-management/' },
                { label: 'Think clearly', href: '/health-goals/' },
              ].map(g => (
                <a href={g.href}
