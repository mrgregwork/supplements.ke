      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {[
          { t: 'Natural Ingredients', d: 'Sourced from trusted suppliers worldwide' },
          { t: 'Transparent Labels',  d: 'Every dose, every ingredient, listed clearly' },
          { t: 'Clinically Dosed',    d: 'Evidence-based formulas, not pixie dust' },
          { t: 'Authenticity Guaranteed', d: '100% genuine products or your money back' },
        ].map(b => (
          <div class="flex flex-col items-center text-center md:items-start md:text-left gap-1">
            <svg class="h-7 w-7 text-primary mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <p class="text-sm font-semibold">{b.t}</p>
            <p class="text-xs text-muted-foreground leading-snug">{b.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────── 2b. AUTHENTICITY SECTION ─────────── -->
  <section class="bg-muted/20 border-b">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-8">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight">If it's on this site, it's the real thing.</h2>
        <p class="text-sm text-muted-foreground mt-2 max-w-xl mx-auto">
          Every product we sell goes through a rigorous authenticity check before reaching you.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {[
          {
            icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
            title: 'Direct from brand',
            desc: 'We source directly from manufacturers and authorised distributors — no middlemen, no counterfeits.',
          },
          {
            icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
            title: 'Batch &amp; expiry check',
            desc: 'Every batch number and expiry date is verified before dispatch. You receive exactly what the label says.',
          },
          {
            icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
            title: 'Guaranteed Authenticity',
            desc: 'Every product is 100% genuine or we refund you in full — no questions asked, no hassle.',
          },
        ].map(card => (
          <div class="bg-card border rounded-xl p-5 flex flex-col items-start gap-3">
            <div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-sm mb-1" set:html={card.title} />
              <p class="text-xs text-muted-foreground leading-relaxed">{card.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────── 3. CATEGORY NAVIGATION STRIP ─────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-6">
    <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-2 text-sm">
      {[
        { l: 'Bestsellers',          h: '/all-supplements/' },
        { l: 'Protein',              h: '/protein/' },
        { l: 'Build Muscle & Recover', h: '/protein/creatine/' },
        { l: 'Pre-Workout',          h: '/protein/pre-workout/' },
        { l: 'Health & Wellness',    h: '/health-goals/' },
        { l: 'Weight Management',    h: '/weight-management/' },
        { l: 'Vitamins',             h: '/vitamins/' },
        { l: 'Collagen',             h: '/collagen/' },
      ].map(c => (
        <a href={c.h}
           class="px-4 py-2 rounded-full border bg-card hover:bg-primary hover:text-primary-foreground hover:border-primary transition-colors font-medium">
          {c.l}
        </a>
      ))}
    </div>
  </section>

  <!-- ─────────────────── 4. BESTSELLERS ─────────────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-6 pb-14">
    <div class="flex items-end justify-between mb-4">
      <div>
        <p class="text-xs font-semibold tracking-wider uppercase text-primary mb-1">Most popular</p>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Bestsellers</h2>
