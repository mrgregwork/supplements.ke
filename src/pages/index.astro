            </div>
            <div class="text-left">
              <div class="flex items-center gap-1.5">
                <div class="flex items-center gap-0.5">
                  {[1,2,3,4,5].map(() => (
                    <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568L24 9.75l-6 5.847L19.336 24 12 19.897 4.664 24 6 15.597 0 9.75l8.332-1.595z"/></svg>
                  ))}
                </div>
                <span class="text-sm font-bold text-amber-800 dark:text-amber-300">4.8</span>
              </div>
              <p class="text-xs text-amber-700 dark:text-amber-400 font-medium leading-tight">
                Trusted by 1,200+ verified customers in Kenya
              </p>
            </div>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-[1.1] mb-3" data-testid="text-hero-title">
            {hero.title || (<>Hold your supplements to a <span class="text-primary">higher standard</span>.</>)}
          </h1>
          <p class="text-sm sm:text-base text-muted-foreground max-w-xl mb-5 mx-auto lg:mx-0">
            {hero.description || 'Clean ingredients. Honest labels. Clinically meaningful doses. Delivered across Kenya.'}
          </p>
          <div class="flex flex-col sm:flex-row items-center lg:items-start justify-center lg:justify-start gap-3 mb-6">
            <a href={hero.ctaLink || '/all-supplements/'}
               class="inline-flex items-center justify-center px-6 py-2.5 min-h-[44px] bg-primary text-primary-foreground font-semibold rounded-full hover:bg-primary/90 transition-colors w-full sm:w-auto"
               data-testid="button-hero-cta">
              {hero.ctaText || 'Shop Supplements'}
            </a>
            <a href="https://wa.me/254724410910" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center justify-center gap-2 px-6 py-2.5 min-h-[44px] font-semibold rounded-full border-2 border-[#25D366] text-[#25D366] hover:bg-[#25D366] hover:text-white transition-colors w-full sm:w-auto"
               data-testid="button-hero-whatsapp">
