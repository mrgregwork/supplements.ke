      <a href="/all-supplements/" class="hidden sm:inline-flex items-center text-sm font-semibold text-primary hover:underline">
        View all →
      </a>
    </div>
    {bestsellers.length > 0 ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6">
        {bestsellers.slice(0, 10).map(p => (
          <ProductCard product={{ ...p, images: p.images || [], attributes: p.attributes || [], subcategorySlug: p.subcategorySlug || '' }} />
