---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ProductGrid from '@components/ProductGrid.astro';
import AdminToolbar from '@components/AdminToolbar.astro';
import { getRegionalAnchorText, generateCategoryUrl, generateSubcategoryUrl } from '@lib/seo';
import { generateCategoryPageSchema, generateOfferCatalogSchema } from '@lib/schema';
import { storage } from '@lib/storage';
import { getSiteSettings } from '@lib/settings';

const { category: categorySlug, subcategory: subcategorySlug } = Astro.params;

const category = await storage.getCategoryBySlug(categorySlug!);

if (!category || !category.isActive) {
  return Astro.redirect('/404');
}

const subcategory = await storage.getSubcategoryBySlug(category.id, subcategorySlug!);

if (!subcategory || !subcategory.isActive) {
  return Astro.redirect('/404');
}

const products = await storage.getProductsBySubcategory(subcategory.id);
const allSubcategories = await storage.getSubcategoriesByCategoryId(category.id);
const siblingSubcategories = allSubcategories.filter(s => s.id !== subcategory.id && s.isActive).slice(0, 3);
const siteSettings = await getSiteSettings();

const breadcrumbItems = [
  { name: category.name, href: generateCategoryUrl(category.slug) },
  { name: subcategory.name, href: generateSubcategoryUrl(category.slug, subcategory.slug) },
];

const productData = products.map(p => ({
  ...p,
  images: p.images || [],
  attributes: p.attributes || []
}));

const subcategoryPageSchema = generateCategoryPageSchema(
  {
    name: subcategory.name,
    slug: subcategory.slug,
    description: subcategory.description || '',
    seoTitle: subcategory.seoTitle || subcategory.name,
    seoDescription: subcategory.seoDescription || subcategory.description || '',
    image: subcategory.heroImage || undefined
  },
  productData,
  breadcrumbItems,
  Astro.url.href
);

const offerCatalogSchema = generateOfferCatalogSchema(
  `${subcategory.name} Catalog`,
  productData,
  Astro.url.href
);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ...subcategoryPageSchema["@graph"],
    offerCatalogSchema
  ]
};

// If admin has set a custom seoTitle, use it verbatim — never wrap it in a template
// Only apply rotation template when falling back to the raw subcategory name
function slugHash(slug: string): number {
  let h = 5381;
  for (let i = 0; i < slug.length; i++) {
    h = ((h << 5) + h) ^ slug.charCodeAt(i);
  }
  return Math.abs(h);
}
const hasCustomTitle = !!subcategory.seoTitle?.trim();
const baseName = subcategory.name;
const titleVariant = slugHash(subcategory.slug) % 3;
const pageTitle = hasCustomTitle
  ? subcategory.seoTitle!.trim()
  : (siteSettings.enableRegionalSeo && siteSettings.targetRegion
      ? [
          `Buy ${baseName} in Kenya | Order on WhatsApp`,
          `${baseName} | Same-Day Delivery in Nairobi`,
          `Shop ${baseName} Online in Kenya | Supplements Kenya`,
        ][titleVariant]
      : baseName);
---

<BaseLayout 
  title={pageTitle}
  description={subcategory.seoDescription || subcategory.description || ''}
  structuredData={structuredData}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="mb-6">
      <h1 class="text-3xl font-bold" data-testid="text-subcategory-title">
        {siteSettings.enableRegionalSeo && siteSettings.targetRegion
          ? getRegionalAnchorText(subcategory.name)
          : subcategory.name}
      </h1>
    </div>

    {subcategory.description && (
      <div class="mb-8 prose prose-neutral dark:prose-invert max-w-3xl text-muted-foreground" set:html={subcategory.description} />
    )}

    {products.length > 0 ? (
      <ProductGrid products={productData} columns={4} />
    ) : (
      <div class="py-12 text-center text-muted-foreground">
        <p>No products in this subcategory yet.</p>
      </div>
    )}

    {subcategory.longDescription && (
      <div class="mt-12 pt-8 border-t">
        <div class="prose prose-neutral dark:prose-invert max-w-3xl" set:html={subcategory.longDescription} />
      </div>
    )}

    {siblingSubcategories.length > 0 && (
      <div class="mt-8 pt-8 border-t">
        <h2 class="text-lg font-semibold mb-4">Related Categories</h2>
        <div class="flex flex-wrap gap-3">
          {siblingSubcategories.map((sub) => (
            <a 
              href={generateSubcategoryUrl(categorySlug!, sub.slug)}
              title={siteSettings.enableRegionalSeo && siteSettings.targetRegion 
                ? `View ${sub.name} in ${siteSettings.targetRegion}` 
                : `View ${sub.name}`}
              class="inline-flex items-center px-4 py-2 min-h-[44px] bg-card border border-card-border rounded-md text-sm font-medium hover:bg-accent transition-colors"
            >
              {sub.name}
            </a>
          ))}
        </div>
        <p class="mt-4 text-sm text-muted-foreground">
          <a 
            href={generateCategoryUrl(categorySlug!)} 
            class="text-primary hover:underline"
            title={`Back to ${category.name}`}
          >
            ← Back to {category.name}
          </a>
        </p>
      </div>
    )}
  </div>
  
  <AdminToolbar
    editUrl="/admin/subcategories"
    pageType="Subcategory"
    seoData={{
      entityType: "subcategory",
      entityId: subcategory.id,
      currentTitle: subcategory.seoTitle ?? subcategory.name,
      currentDescription: subcategory.seoDescription ?? subcategory.description ?? "",
    }}
  />


</BaseLayout>
