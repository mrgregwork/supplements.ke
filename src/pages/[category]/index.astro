---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ProductGrid from '@components/ProductGrid.astro';
import SeoContentSection from '@components/SeoContentSection.astro';
import AdminToolbar from '@components/AdminToolbar.astro';
import { getRegionalAnchorText, generateCategoryUrl, generateSubcategoryUrl } from '@lib/seo';
import { generateCategoryPageSchema, generateOfferCatalogSchema } from '@lib/schema';
import { storage } from '@lib/storage';
import { getSiteSettings } from '@lib/settings';

const { category: categorySlug } = Astro.params;

const category = await storage.getCategoryBySlug(categorySlug!);

if (!category || !category.isActive) {
  return Astro.redirect('/404');
}

const subcategories = await storage.getSubcategoriesByCategoryId(category.id);
const products = await storage.getProductsByCategory(category.id);
const siteSettings = await getSiteSettings();

const breadcrumbItems = [
  { name: category.name, href: generateCategoryUrl(category.slug) },
];

const productData = products.map(p => ({
  ...p,
  images: p.images || [],
  attributes: p.attributes || []
}));

const categoryPageSchema = generateCategoryPageSchema(
  {
    name: category.name,
    slug: category.slug,
    description: category.description || '',
    seoTitle: category.seoTitle || category.name,
    seoDescription: category.seoDescription || category.description || '',
    image: category.heroImage || undefined
  },
  productData,
  breadcrumbItems,
  Astro.url.href
);

const offerCatalogSchema = generateOfferCatalogSchema(
  `${category.name} Catalog`,
  productData,
  Astro.url.href
);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ...categoryPageSchema["@graph"],
    offerCatalogSchema
  ]
};

// If admin has set a custom seoTitle, use it verbatim — never wrap it in a template
function slugHash(slug: string): number {
  let h = 5381;
  for (let i = 0; i < slug.length; i++) {
    h = ((h << 5) + h) ^ slug.charCodeAt(i);
  }
  return Math.abs(h);
}
const hasCustomTitle = !!category.seoTitle?.trim();
const baseName = category.name;
const titleVariant = slugHash(category.slug) % 3;
const pageTitle = hasCustomTitle
  ? category.seoTitle!.trim()
  : (siteSettings.enableRegionalSeo && siteSettings.targetRegion
      ? [
          `Buy ${baseName} in Kenya | Order on WhatsApp`,
          `${baseName} | Same-Day Delivery in Nairobi`,
          `Shop ${baseName} Online in Kenya | Supplements Kenya`,
        ][titleVariant]
      : baseName);

// Form and lifestyle filter pages should not be indexed by search engines
const NOINDEX_SLUGS = ['supplement-forms', 'lifestyle-supplements'];
const noindex = NOINDEX_SLUGS.includes(category.slug);
---

<BaseLayout
  title={pageTitle}
  description={category.seoDescription || category.description || ''}
  structuredData={structuredData}
  noindex={noindex}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="mb-6">
      <h1 class="text-3xl font-bold" data-testid="text-category-title">
        {siteSettings.enableRegionalSeo && siteSettings.targetRegion
          ? getRegionalAnchorText(category.name)
          : category.name}
      </h1>
    </div>

    {category.description && (
      <div class="mb-6 prose prose-neutral dark:prose-invert max-w-3xl text-muted-foreground" set:html={category.description} />
    )}

    {subcategories.length > 0 && (
      <div class="mb-8">
        <h2 class="text-lg font-semibold mb-4">Browse Subcategories</h2>
        <div class="flex flex-wrap gap-3">
          {subcategories.filter(s => s.isActive).map((sub) => (
            <a
              href={generateSubcategoryUrl(categorySlug!, sub.slug)}
              title={siteSettings.enableRegionalSeo && siteSettings.targetRegion
                ? `View ${sub.name} in ${siteSettings.targetRegion}`
                : `View ${sub.name}`}
              class="inline-flex items-center px-4 py-2 min-h-[44px] bg-card border border-card-border rounded-md text-sm font-medium hover:bg-accent transition-colors"
              data-testid={`link-subcategory-${sub.slug}`}
            >
              {sub.name}
              <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    )}

    {products.length > 0 ? (
      <ProductGrid products={productData} columns={4} />
    ) : (
      <div class="py-12 text-center text-muted-foreground">
        <p>No products in this category yet.</p>
      </div>
    )}

    {category.longDescription && (
      <div class="mt-12 pt-8 border-t">
        <div class="prose prose-neutral dark:prose-invert max-w-3xl" set:html={category.longDescription} />
      </div>
    )}
  </div>

  <AdminToolbar
    editUrl="/admin/categories"
    pageType="Category"
    seoData={{
      entityType: "category",
      entityId: category.id,
      currentTitle: category.seoTitle ?? category.name,
      currentDescription: category.seoDescription ?? category.description ?? "",
    }}
  />


</BaseLayout>
