---
import BaseLayout from '@layouts/BaseLayout.astro';
import { storage } from '@lib/storage';

const allCategories = await storage.getCategories();
const popularCategories = allCategories
  .filter(c => c.isActive)
  .slice(0, 8);
---

<BaseLayout
  title="Page Not Found - 404"
  description="The page you're looking for doesn't exist. Browse our supplement categories instead."
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
    <p class="text-sm font-semibold text-primary tracking-wider uppercase">404 Error</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-4 text-base sm:text-lg text-muted-foreground">
      Sorry, we couldn't find the page you're looking for. It may have moved or no longer exist.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center justify-center px-5 py-3 min-h-[44px] bg-primary text-primary-foreground rounded-md text-sm font-medium hover:bg-primary/90 transition-colors w-full sm:w-auto"
      >
        Back to homepage
      </a>
      <a
        href="/all-supplements/"
        class="inline-flex items-center justify-center px-5 py-3 min-h-[44px] border rounded-md text-sm font-medium hover:bg-accent transition-colors w-full sm:w-auto"
      >
        Browse all supplements
      </a>
    </div>

    {popularCategories.length > 0 && (
      <div class="mt-14 pt-10 border-t text-left">
        <h2 class="text-lg font-semibold mb-4 text-center">Popular categories</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {popularCategories.map(cat => (
            <a
              href={`/${cat.slug}/`}
              class="block px-4 py-3 min-h-[44px] bg-card border rounded-md text-sm font-medium hover:bg-accent hover:border-primary/40 transition-colors text-center"
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
