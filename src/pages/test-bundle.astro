---
/**
 * /test-bundle — private CRO test page (no navbar, no footer)
 * Not linked from anywhere. Visit: https://supplements.co.ke/test-bundle
 */
import '@/styles/global.css';
import ProductBuyBox from '@components/ProductBuyBox';

const testProduct = {
  id:            'test-boron-3mg',
  name:          'Boron 3mg',
  brand:         'Life Extension',
  price:         1200,
  originalPrice: 1800,
  currency:      'KES',
  image:         '/images/products/boron-3mg.jpg',
  description:   'Supports bone density, hormone balance, and cognitive function. Each capsule delivers 3 mg of boron as sodium tetraborate.',
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Bundle Selector Test</title>
  <script is:inline>
    const theme = localStorage.getItem('ecommerce-seo-theme') || 'light';
    if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="min-h-screen bg-background text-foreground font-sans antialiased">

  <!-- Test banner -->
  <div class="bg-amber-50 border-b border-amber-200 px-4 py-2 text-center text-sm text-amber-800">
    🧪 <strong>CRO Test Page</strong> — not live on the site yet
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">

      <!-- Left: product image + name + description -->
      <div class="md:sticky md:top-8">
        <div class="aspect-square overflow-hidden rounded-xl bg-white border flex items-center justify-center mb-5 shadow-sm">
          <img
            src={testProduct.image}
            alt={testProduct.name}
            class="h-full w-full object-contain p-4"
            onerror="this.src='/images/placeholder-product.jpg'"
          />
        </div>
        <p class="text-sm text-muted-foreground font-medium uppercase tracking-wide">{testProduct.brand}</p>
        <h1 class="text-3xl font-bold mt-1 mb-3">{testProduct.name}</h1>
        <p class="text-muted-foreground leading-relaxed text-sm">{testProduct.description}</p>
      </div>

      <!-- Right: full buy box (pricing, bundles, CTA, trust) -->
      <div>
        <ProductBuyBox
          client:load
          productId={testProduct.id}
          productName={testProduct.name}
          price={testProduct.price}
          originalPrice={testProduct.originalPrice}
          currency={testProduct.currency}
          ratingValue={4.8}
          reviewCount={127}
        />
      </div>

    </div>
  </div>

</body>
</html>
