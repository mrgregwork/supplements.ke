---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCustomer, getSessionByToken, getCustomerOrders } from "@lib/auth";
import { db } from "@server/db";
import { orders, orderItems, products } from "@shared/schema";
import { eq } from "drizzle-orm";
import siteSettings from '@config/siteSettings.json';
import { generateBreadcrumbSchema } from '@lib/schema';

const sessionToken = Astro.cookies.get('session')?.value;
let customer = null;

if (sessionToken) {
  const session = await getSessionByToken(sessionToken);
  if (session) {
    customer = await getCustomer(session.customerId);
  }
}

if (!customer) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;

const [order] = await db.select().from(orders).where(eq(orders.id, id!));

if (!order || order.customerId !== customer.id) {
  return Astro.redirect('/account');
}

const baseUrl = siteSettings.siteUrl || 'https://example.com';

const items = await db
  .select({
    id: orderItems.id,
    productId: orderItems.productId,
    productName: orderItems.productName,
    productImage: orderItems.productImage,
    quantity: orderItems.quantity,
    unitPrice: orderItems.unitPrice,
    totalPrice: orderItems.totalPrice,
    product: products,
  })
  .from(orderItems)
  .leftJoin(products, eq(orderItems.productId, products.id))
  .where(eq(orderItems.orderId, order.id));

const statusColors = {
  pending: "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400",
  confirmed: "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400",
  processing: "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400",
  shipped: "bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400",
  delivered: "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400",
  cancelled: "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400",
};

const breadcrumbItems = [
  { name: 'My Account', href: '/account' },
  { name: `Order ${order.orderNumber}`, href: `/account/orders/${id}` }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Order",
      "@id": `${baseUrl}/account/orders/${id}#order`,
      "orderNumber": order.orderNumber,
      "orderStatus": `https://schema.org/Order${order.status.charAt(0).toUpperCase() + order.status.slice(1)}`,
      "orderDate": order.createdAt,
      "acceptedOffer": items.map(item => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Product",
          "name": item.productName
        },
        "price": item.unitPrice,
        "priceCurrency": "KES"
      }))
    },
    generateBreadcrumbSchema(breadcrumbItems, baseUrl)
  ]
};
---

<BaseLayout 
  title={`Order ${order.orderNumber}`}
  description="View your order details"
  structuredData={structuredData}
>
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="mb-6">
      <a href="/account" class="text-primary hover:underline text-sm">
        ← Back to My Account
      </a>
    </div>
    
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold" data-testid="text-order-number">{order.orderNumber}</h1>
        <p class="text-muted-foreground">
          Placed on {new Date(order.createdAt).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit"
          })}
        </p>
      </div>
      <span class={`px-3 py-1 text-sm font-medium rounded-full ${statusColors[order.status as keyof typeof statusColors] || statusColors.pending}`}>
        {order.status.charAt(0).toUpperCase() + order.status.slice(1)}
      </span>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-card border rounded-lg p-6">
        <h2 class="font-semibold mb-4">Shipping Address</h2>
        {order.shippingAddress ? (
          <address class="not-italic text-muted-foreground">
            <p class="font-medium text-foreground">
              {order.shippingAddress.firstName} {order.shippingAddress.lastName}
            </p>
            <p>{order.shippingAddress.address1}</p>
            {order.shippingAddress.address2 && <p>{order.shippingAddress.address2}</p>}
            <p>
              {order.shippingAddress.city}, {order.shippingAddress.state || ""} {order.shippingAddress.postalCode}
            </p>
            <p>{order.shippingAddress.country}</p>
          </address>
        ) : (
          <p class="text-muted-foreground">No shipping address provided</p>
        )}
      </div>
      
      <div class="bg-card border rounded-lg p-6">
        <h2 class="font-semibold mb-4">Contact Information</h2>
        <div class="text-muted-foreground space-y-1">
          <p><span class="text-foreground font-medium">Email:</span> {order.email}</p>
          {order.phone && <p><span class="text-foreground font-medium">Phone:</span> {order.phone}</p>}
        </div>
      </div>
    </div>
    
    <div class="bg-card border rounded-lg overflow-hidden">
      <div class="p-6 border-b">
        <h2 class="font-semibold">Order Items</h2>
      </div>
      
      <div class="divide-y">
        {items.map((item) => (
          <div class="flex gap-4 p-6">
            <img 
              src={item.productImage || "/placeholder.png"} 
              alt={item.productName}
              class="w-20 h-20 object-cover rounded-md border"
            />
            <div class="flex-1">
              <h3 class="font-medium">{item.productName}</h3>
              {item.product && (
                <a 
                  href={`/${item.product.categorySlug}/${item.product.subcategorySlug}/${item.product.slug}`}
                  class="text-sm text-primary hover:underline"
                >
                  View product
                </a>
              )}
              <p class="text-sm text-muted-foreground mt-1">
                ${item.unitPrice.toFixed(2)} × {item.quantity}
              </p>
            </div>
            <div class="text-right font-medium">
              ${item.totalPrice.toFixed(2)}
            </div>
          </div>
        ))}
      </div>
      
      <div class="p-6 bg-muted/30 border-t">
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-muted-foreground">Subtotal</span>
            <span>${order.subtotal.toFixed(2)}</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-muted-foreground">Shipping</span>
            <span>{order.shipping === 0 ? "Free" : `$${order.shipping.toFixed(2)}`}</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-muted-foreground">Tax</span>
            <span>${order.tax.toFixed(2)}</span>
          </div>
          <div class="flex justify-between font-semibold text-lg pt-2 border-t">
            <span>Total</span>
            <span>${order.total.toFixed(2)}</span>
          </div>
        </div>
      </div>
    </div>
    
    {order.notes && (
      <div class="mt-6 bg-card border rounded-lg p-6">
        <h2 class="font-semibold mb-2">Order Notes</h2>
        <p class="text-muted-foreground">{order.notes}</p>
      </div>
    )}
  </main>
</BaseLayout>
