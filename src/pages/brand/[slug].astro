---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ProductGrid from '@components/ProductGrid.astro';
import { storage } from '@lib/storage';
import { getSiteSettings } from '@lib/settings';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/404');

const [brandProducts, siteSettings, brandSubcategoryLinks] = await Promise.all([
  storage.getProductsByBrandSlug(slug),
  getSiteSettings(),
  // Live subcategory pages for this brand (see /admin/brand-subcategories),
  // so this page works like a category page: it links down into its own
  // subcategories once an admin has published them.
  storage.getActiveBrandSubcategories(slug),
]);

if (brandProducts.length === 0) {
  return Astro.redirect('/404');
}

const brandName = brandProducts[0].brand ?? slug;

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: brandName, href: `/brand/${slug}/` },
];

const brandDescription = `Shop all ${brandName} supplements and health products in Kenya. ${brandName} products available with fast delivery.`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": Astro.url.href,
      "name": `${brandName} Products`,
      "description": brandDescription,
      "url": Astro.url.href,
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.url).href },
        { "@type": "ListItem", "position": 2, "name": brandName, "item": Astro.url.href },
      ]
    }
  ]
};
---

<BaseLayout
  title={`${brandName} Supplements in Kenya | ${siteSettings.siteName ?? 'Supplements Kenya'}`}
  description={brandDescription}
  structuredData={structuredData}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">{brandName}</h1>
      <p class="text-muted-foreground max-w-2xl">
        Browse all {brandName} supplements and health products available in Kenya.
      </p>
    </div>

    <div class="mb-6">
      <p class="text-sm text-muted-foreground">
        Showing {brandProducts.length} {brandProducts.length === 1 ? 'product' : 'products'}
      </p>
    </div>

    {brandSubcategoryLinks.length > 0 && (
      <div class="mb-6 flex flex-wrap gap-2">
        {brandSubcategoryLinks.map((sub) => (
          <a
            href={`/brand/${slug}/${sub.subcategorySlug}/`}
            class="text-sm border rounded-full px-3 py-1 text-foreground hover:bg-muted transition"
          >
            {sub.heading || sub.subcategoryName}
          </a>
        ))}
      </div>
    )}

    <ProductGrid products={brandProducts} columns={4} />

    <section class="mt-16 pt-8 border-t">
      <div class="prose prose-sm dark:prose-invert max-w-none">
        <h2 class="text-xl font-semibold mb-4">About {brandName}</h2>
        <p class="text-muted-foreground leading-relaxed">
          {brandName} is a trusted supplement brand. Shop our full selection of {brandName} products
          with fast delivery across Kenya and our satisfaction guarantee.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
